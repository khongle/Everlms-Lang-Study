# Ignore configuration files that may contain sensitive information
/web/sites/*/*settings*.php
/web/sites/*/*services*.yml

# Ignore paths that may contain user-generated content
/web/sites/*/files
/web/sites/*/private

# Ignore paths that may contain temporary files
/web/sites/*/translations
/web/sites/*/tmp
/web/sites/*/cache

# Ignore testing related files
/web/sites/simpletest

# Ignore drupal core (assuming composer based site)
/web/core
/web/modules/contrib
/web/themes/contrib
/web/profiles/contrib
/web/libraries

# Ignore vendor dependencies
/vendor

# Ignore node dependencies
node_modules

# Ignore IDE and editor files
.idea
.vscode
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store

# Ignore sass cache
.sass-cache

# Ignore build files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore Drupal's file directory
/files
/sites/*/files
/sites/*/private

# Ignore SimpleTest multi-site environment
/sites/simpletest

# Ignore files generated by PhpStorm
*.iml

# Ignore patches
*.patch
*.diff

# Ignore Drush
/drush/contrib
/drush/commands

# Ignore custom themes dependencies
/web/themes/custom/*/node_modules
/web/themes/custom/*/dist

# Ignore Composer files (if you want to commit composer.lock, remove this line)
# /composer.lock

# Ignore temporary files
*.tmp
*.bak
*.old

# Ignore DDEV (if using DDEV)
.ddev
.agent
.claude
.backup-agent

# Ignore Behat
/behat.local.yml

# Ignore PHPUnit
/phpunit.xml