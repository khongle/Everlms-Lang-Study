{#
/**
 * @file
 * Theme override to display a pager.
 */
#}
{% if items %}
  <nav class="lms-pagination" aria-labelledby="{{ heading_id }}">
    <h4 id="{{ heading_id }}" class="visually-hidden">{{ 'Pagination'|t }}</h4>

    {% if items.first %}
      <a href="{{ items.first.href }}" title="{{ 'Go to first page'|t }}" class="lms-pagination__item"{{ items.first.attributes|without('href', 'title') }}>
        <span class="visually-hidden">{{ 'First page'|t }}</span>
        <span aria-hidden="true">&laquo;&laquo;</span>
      </a>
    {% endif %}

    {% if items.previous %}
      <a href="{{ items.previous.href }}" title="{{ 'Go to previous page'|t }}" rel="prev" class="lms-pagination__item"{{ items.previous.attributes|without('href', 'title', 'rel') }}>
        <span class="visually-hidden">{{ 'Previous page'|t }}</span>
        <span aria-hidden="true">&laquo;</span>
      </a>
    {% endif %}

    {% if ellipses.previous %}
      <span class="lms-pagination__item lms-pagination__item--disabled" role="presentation">&hellip;</span>
    {% endif %}

    {% for key, item in items.pages %}
      {% if current == key %}
        <span class="lms-pagination__item lms-pagination__item--active">
          <span class="visually-hidden">
            {{ 'Current page'|t }}
          </span>{{ key }}
        </span>
      {% else %}
        <a href="{{ item.href }}" title="{{ 'Go to page @key'|t({'@key': key}) }}" class="lms-pagination__item"{{ item.attributes|without('href', 'title') }}>
          <span class="visually-hidden">
            {{ 'Page'|t }}
          </span>{{ key }}
        </a>
      {% endif %}
    {% endfor %}

    {% if ellipses.next %}
      <span class="lms-pagination__item lms-pagination__item--disabled" role="presentation">&hellip;</span>
    {% endif %}

    {% if items.next %}
      <a href="{{ items.next.href }}" title="{{ 'Go to next page'|t }}" rel="next" class="lms-pagination__item"{{ items.next.attributes|without('href', 'title', 'rel') }}>
        <span class="visually-hidden">{{ 'Next page'|t }}</span>
        <span aria-hidden="true">&raquo;</span>
      </a>
    {% endif %}

    {% if items.last %}
      <a href="{{ items.last.href }}" title="{{ 'Go to last page'|t }}" class="lms-pagination__item"{{ items.last.attributes|without('href', 'title') }}>
        <span class="visually-hidden">{{ 'Last page'|t }}</span>
        <span aria-hidden="true">&raquo;&raquo;</span>
      </a>
    {% endif %}
  </nav>
{% endif %}
