{# Login form — matches 06-auth-login-register.png #}
{{ attach_library('lms_theme/global') }}

<div class="lms-auth">
  <div class="lms-auth__container">
    <div class="lms-auth__card">
      <div class="lms-auth__header">
        <a href="{{ path('<front>') }}" class="lms-auth__logo">
          <i class="fas fa-graduation-cap"></i> {{ 'EverLMS'|t }}
        </a>
        <h1>{{ 'Welcome Back'|t }}</h1>
        <p>{{ 'Sign in to continue your learning journey'|t }}</p>
      </div>

      {# Social login buttons #}
      <div class="lms-auth__social">
        <a href="#" class="lms-btn lms-btn--social lms-btn--google">
          <i class="fab fa-google"></i> {{ 'Continue with Google'|t }}
        </a>
        <a href="#" class="lms-btn lms-btn--social lms-btn--facebook">
          <i class="fab fa-facebook-f"></i> {{ 'Continue with Facebook'|t }}
        </a>
      </div>

      <div class="lms-auth__divider">
        <span>{{ 'or sign in with email'|t }}</span>
      </div>

      {# Drupal login form #}
      {{ form }}

      <div class="lms-auth__footer">
        <p>{{ "Don't have an account?"|t }} <a href="{{ path('user.register') }}">{{ 'Sign Up'|t }}</a></p>
      </div>
    </div>
  </div>
</div>
