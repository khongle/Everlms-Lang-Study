{# EverLMS — User Password Page template #}
<div class="lms-page">
  {# Navbar — matches mockup #}
  <header class="lms-navbar">
    <div class="lms-navbar__container">
      <a href="{{ path('<front>') }}" class="lms-navbar__brand">
        <i class="fas fa-graduation-cap"></i> {{ 'EverLMS'|t }}
      </a>
      <div class="lms-navbar__actions">
        <a href="{{ path('user.login') }}" class="lms-navbar__link">{{ 'Login'|t }}</a>
        <a href="{{ path('<front>') }}" class="lms-btn lms-btn--sm lms-btn--outline">{{ 'Back to Home'|t }}</a>
      </div>
    </div>
  </header>

  {# Main Content #}
  <main id="main-content" class="lms-page__content lms-auth">
    <div class="lms-auth__container">
      <div class="lms-auth__card">
        <div class="lms-auth__header text-center mb-4">
          <div class="lms-auth__logo mb-3" style="font-size: 3rem; color: var(--lms-primary-color);">
            <i class="fas fa-lock"></i>
          </div>
          <h1 class="h3 fw-bold mb-2">{{ 'Forgot Password'|t }}</h1>
          <p class="text-muted" style="font-size: 0.95rem;">{{ 'Enter your email address and we will send you a link to reset your password.'|t }}</p>
        </div>

        <div class="lms-auth__form-wrapper mt-4">
          {{ page.content }}
        </div>
        
        <div class="lms-auth__footer mt-4 text-center">
          <p class="mb-0" style="color: #8b949e; font-size: 0.9rem;"><a href="{{ path('user.login') }}" style="color: var(--lms-primary-color); font-weight: 500;"><i class="fas fa-arrow-left me-1"></i> {{ 'Back to Login'|t }}</a></p>
        </div>
      </div>
    </div>
  </main>
</div>
