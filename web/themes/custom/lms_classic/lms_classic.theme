<?php

/**
 * @file
 * Functions to support theming in the EverLMS theme.
 */

/**
 * Implements hook_preprocess_page().
 */
function lms_classic_preprocess_page(&$variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  $variables['current_route'] = $route_name;

  $request = \Drupal::request();
  if ($request->hasSession() && $request->getSession()->get('open_switcher_original_uid')) {
    $variables['is_impersonating'] = TRUE;
    $variables['switch_back_url'] = \Drupal\Core\Url::fromRoute('open_switcher.switch_back')->toString();
  }

  $variables['logged_in'] = \Drupal::currentUser()->isAuthenticated();
  if ($variables['logged_in']) {
    // Inject Notification Bell built array.
    if (\Drupal::moduleHandler()->moduleExists('lms_notification')) {
      $block_manager = \Drupal::service('plugin.manager.block');
      $plugin_block = $block_manager->createInstance('lms_notification_bell_block', []);
      if ($plugin_block && $plugin_block->access(\Drupal::currentUser())) {
        $variables['notification_bell'] = $plugin_block->build();
      }
    }

    $user = \Drupal\user\Entity\User::load(\Drupal::currentUser()->id());
    if ($user) {
      $variables['is_manager'] = !empty(array_intersect(['administrator', 'manager', 'instructor'], $user->getRoles()));
      $first_name = $user->hasField('field_first_name') ? trim((string) $user->get('field_first_name')->value) : '';
      $last_name = $user->hasField('field_last_name') ? trim((string) $user->get('field_last_name')->value) : '';
      if ($first_name || $last_name) {
        $variables['current_user_name'] = trim("$first_name $last_name");
      } else {
        $variables['current_user_name'] = $user->getDisplayName();
      }
    } else {
      $variables['current_user_name'] = \Drupal::currentUser()->getDisplayName();
    }
    if ($user && $user->hasField('user_picture') && !$user->get('user_picture')->isEmpty()) {
      $file = \Drupal\file\Entity\File::load($user->get('user_picture')->target_id);
      if ($file) {
        $variables['current_user_picture'] = \Drupal::service('file_url_generator')->generateString($file->getFileUri());
      }
    }
  }
}

/**
 * Implements hook_theme().
 */
function lms_classic_theme($existing, $type, $theme, $path) {
  return [
    'lms_course_manager_edit' => [
      'render element' => 'form',
      'template' => 'form/lms-course-manager-edit-form',
    ],
  ];
}

/**
 * Implements hook_form_alter().
 */
function lms_classic_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  if ($form_id === 'lms_course_manager_edit_form') {
    $form['#theme'] = ['lms_course_manager_edit'];
  }
}

/**
 * Implements hook_preprocess_input().
 */
function lms_classic_preprocess_input(&$variables) {
  $element = $variables['element'];
  $type = $element['#type'] ?? '';
  if (in_array($type, ['textfield', 'email', 'number', 'password', 'search', 'tel', 'url', 'date'])) {
    $variables['attributes']['class'][] = 'form-control';
  } elseif (in_array($type, ['checkbox', 'radio'])) {
    $variables['attributes']['class'][] = 'form-check-input';
  } elseif ($type === 'submit' || $type === 'button') {
    $variables['attributes']['class'][] = 'btn';
  }
}

/**
 * Implements hook_preprocess_select().
 */
function lms_classic_preprocess_select(&$variables) {
  $variables['attributes']['class'][] = 'form-select';
}

/**
 * Implements hook_preprocess_textarea().
 */
function lms_classic_preprocess_textarea(&$variables) {
  $variables['attributes']['class'][] = 'form-control';
}

/**
 * Implements hook_preprocess_user().
 */
function lms_classic_preprocess_user(&$variables) {
  $user = $variables['user'];
  $uid = $user->id();

  $entity_type_manager = \Drupal::entityTypeManager();

  // Enrolled Courses
  $enrolled_count = $entity_type_manager->getStorage('lms_user_course')
    ->getQuery()
    ->condition('uid', $uid)
    ->accessCheck(FALSE)
    ->count()
    ->execute();
  $variables['courses_enrolled'] = $enrolled_count;

  // Completed Courses
  $completed_count = $entity_type_manager->getStorage('lms_user_course')
    ->getQuery()
    ->condition('uid', $uid)
    ->condition('field_status', 'completed')
    ->accessCheck(FALSE)
    ->count()
    ->execute();
  $variables['courses_completed'] = $completed_count;

  // Certificates
  $certificates_count = 0;
  if ($entity_type_manager->hasDefinition('lms_user_certificate')) {
    $certificates_count = $entity_type_manager->getStorage('lms_user_certificate')
      ->getQuery()
      ->condition('uid', $uid)
      ->accessCheck(FALSE)
      ->count()
      ->execute();
  }
  $variables['certificates_count'] = $certificates_count;

  // Quiz Average (Placeholder logic if lms_quiz_result exists)
  $quiz_average = '0%';
  $recent_quizzes = [];
  if ($entity_type_manager->hasDefinition('lms_quiz_result')) {
    $results = $entity_type_manager->getStorage('lms_quiz_result')
      ->loadByProperties(['uid' => $uid]);
      
    // Fetch Recent Quizzes
    $recent_result_ids = $entity_type_manager->getStorage('lms_quiz_result')
      ->getQuery()
      ->condition('uid', $uid)
      ->sort('id', 'DESC')
      ->range(0, 5)
      ->accessCheck(FALSE)
      ->execute();
    
    if ($recent_result_ids) {
      $recent_result_entities = $entity_type_manager->getStorage('lms_quiz_result')->loadMultiple($recent_result_ids);
      foreach ($recent_result_entities as $r) {
        $quiz = $r->hasField('field_quiz') ? $r->get('field_quiz')->entity : NULL;
        $score = $r->hasField('field_score') ? (float) $r->get('field_score')->value : 0;
        $passed = $score >= 80; // Basic assumption, could be dynamic
        $recent_quizzes[] = [
          'title' => $quiz ? $quiz->label() : 'Unknown Quiz',
          'score' => $score,
          'passed' => $passed,
          'date' => \Drupal::service('date.formatter')->format($r->get('created')->value, 'short'),
        ];
      }
    }

    if (!empty($results)) {
      $total_score = 0;
      foreach ($results as $result) {
        $total_score += (float) $result->get('field_score')->value;
      }
      $quiz_average = round($total_score / count($results)) . '%';
    }
  }
  $variables['quiz_average'] = $quiz_average;
  $variables['recent_quizzes'] = $recent_quizzes;
  
  // Active Courses
  $active_courses = [];
  if ($entity_type_manager->hasDefinition('lms_user_course')) {
    $enrollment_ids = $entity_type_manager->getStorage('lms_user_course')
      ->getQuery()
      ->condition('uid', $uid)
      ->sort('id', 'DESC')
      ->range(0, 3)
      ->accessCheck(FALSE)
      ->execute();

    if ($enrollment_ids) {
      $enrollments = $entity_type_manager->getStorage('lms_user_course')->loadMultiple($enrollment_ids);
      foreach ($enrollments as $enrollment) {
        $course = $enrollment->hasField('field_course') ? $enrollment->get('field_course')->entity : NULL;
        if ($course) {
          $progress = $enrollment->hasField('field_progress') && !$enrollment->get('field_progress')->isEmpty() ? (int) $enrollment->get('field_progress')->value : 0;
          $thumbnail = '';
          if ($course->hasField('field_thumbnail') && !$course->get('field_thumbnail')->isEmpty()) {
            $file = $course->get('field_thumbnail')->entity;
            if ($file) {
              $thumbnail = \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
            }
          }
          $active_courses[] = [
            'title' => $course->label(),
            'url' => $course->toUrl()->toString(),
            'thumbnail' => $thumbnail,
            'progress' => $progress,
          ];
        }
      }
    }
  }
  $variables['active_courses'] = $active_courses;

  // Member since raw timestamp for custom formatting
  $variables['member_since_timestamp'] = $user->getCreatedTime();
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for the user entity.
 */
function lms_classic_theme_suggestions_user_alter(array &$suggestions, array $variables) {
  // Force the full feature-rich dashboard template on the canonical profile route
  // regardless of the active view mode configured in the admin backend.
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name === 'entity.user.canonical') {
    $suggestions[] = 'user__full';
  }
}
