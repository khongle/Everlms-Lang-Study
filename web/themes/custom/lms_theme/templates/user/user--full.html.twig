{#
/**
 * @file
 * Theme override to present all user data in FULL view mode.
 */
#}
{%
  set classes = [
    'lms-profile',
    user.isBlocked() ? 'is-blocked',
    'clearfix',
  ]
%}

<article{{ attributes.addClass(classes) }}>
  <div class="lms-profile__layout-redesign">
    
    {# Cover & Avatar Header #}
    <div class="lms-profile__header">
      <div class="lms-profile__cover">
        <!-- Optional Cover Photo Placeholder -->
        <div class="lms-profile__cover-bg"></div>
      </div>
      
      <div class="lms-profile__header-content">
        <div class="lms-profile__avatar-wrapper">
          {% if content.user_picture|render %}
            {{ content.user_picture }}
          {% else %}
            <div class="lms-profile__avatar-placeholder">
              <i class="fas fa-user"></i>
            </div>
          {% endif %}
        </div>
        
        <h1 class="lms-profile__name">
           {% if content.field_first_name|render or content.field_last_name|render %}
             {{ content.field_first_name.0 }} {{ content.field_last_name.0 }}
           {% else %}
             {{ user.getDisplayName() }}
           {% endif %}
        </h1>
        
        {% if content.field_job_title|render %}
          <div class="lms-profile__job">
            {{ content.field_job_title.0 }}
          </div>
        {% endif %}
      </div>
    </div>

    {# 2-Column Grid #}
    <div class="lms-profile__body">
      
      {# Left Column (Details) #}
      <div class="lms-profile__details">
        
        <div class="lms-profile-bio-card">
          <h2 class="lms-profile__section-title">{{ 'Bio'|t }}</h2>
          <div class="lms-profile__bio-content">
            {% if content.field_bio|render %}
              {{ content.field_bio.0 }}
            {% else %}
              <p class="lms-text-muted"><em>{{ 'This user has not provided a biography yet.'|t }}</em></p>
            {% endif %}
          </div>
        </div>

        <div class="lms-profile-info-grid">
          <div class="lms-profile-info-item">
            <div class="lms-profile-info-item__icon"><i class="fas fa-envelope"></i></div>
            <div class="lms-profile-info-item__content">
              <span class="lms-profile-info-label">{{ 'Email'|t }}</span>
              <span class="lms-profile-info-value">{{ user.getEmail() }}</span>
            </div>
          </div>
          {% if content.field_location|render %}
            <div class="lms-profile-info-item">
              <div class="lms-profile-info-item__icon"><i class="fas fa-map-marker-alt"></i></div>
              <div class="lms-profile-info-item__content">
                <span class="lms-profile-info-label">{{ 'Location'|t }}</span>
                <span class="lms-profile-info-value">{{ content.field_location.0 }}</span>
              </div>
            </div>
          {% endif %}
          {% if content.field_company|render %}
            <div class="lms-profile-info-item">
              <div class="lms-profile-info-item__icon"><i class="fas fa-building"></i></div>
              <div class="lms-profile-info-item__content">
                <span class="lms-profile-info-label">{{ 'Company'|t }}</span>
                <span class="lms-profile-info-value">{{ content.field_company.0 }}</span>
              </div>
            </div>
          {% endif %}
          {% if content.field_receive_system_notificati|render %}
             <div class="lms-profile-info-item">
                <div class="lms-profile-info-item__icon"><i class="fas fa-bell"></i></div>
                <div class="lms-profile-info-item__content">
                  <span class="lms-profile-info-label">{{ 'Notifications'|t }}</span>
                  <span class="lms-profile-info-value">{{ content.field_receive_system_notificati.0 }}</span>
                </div>
             </div>
          {% endif %}
          {% if content.field_social_links|render %}
            <div class="lms-profile-info-item lms-profile-info-item--full">
              <div class="lms-profile-info-item__icon"><i class="fas fa-link"></i></div>
              <div class="lms-profile-info-item__content">
                <span class="lms-profile-info-label">{{ 'Social Links'|t }}</span>
                <span class="lms-profile-info-value">{{ content.field_social_links.0 }}</span>
              </div>
            </div>
          {% endif %}
        </div>
        
        {# NEW BLOCK: ACTIVE COURSES #}
        {% if active_courses|length > 0 %}
          <div class="lms-profile-courses-card">
            <h2 class="lms-profile__section-title">{{ 'Recent Courses'|t }}</h2>
            <div class="lms-profile-courses-card-list">
              {% for course in active_courses %}
                <div class="lms-profile-courses-card-item">
                   {% if course.thumbnail %}
                     <img src="{{ course.thumbnail }}" alt="{{ course.title }}" style="width: 100px; height: 75px; object-fit: cover; border-radius: .5rem; box-shadow: 0 4px 6px rgba(0,0,0,0.3);">
                   {% else %}
                     <div style="width: 100px; height: 75px; background: rgba(30,41,59,0.5); border-radius: .5rem; display: flex; align-items: center; justify-content: center; color: #6e7681; font-size: 1.5rem;"><i class="fas fa-graduation-cap"></i></div>
                   {% endif %}
                   <div style="flex: 1;">
                     <h4 style="margin: 0 0 0.5rem 0; font-size: 1rem; font-weight: 600;"><a href="{{ course.url }}" style="color: #f1f5f9; text-decoration: none;">{{ course.title }}</a></h4>
                     <div class="lms-progress-bar" style="background: rgba(255,255,255,0.05); border-radius: 4px; height: 8px; overflow: hidden; margin-bottom: 0.5rem;">
                        <div class="lms-progress-bar__fill" style="width: {{ course.progress }}%; background: linear-gradient(135deg, #818cf8 0%, #c084fc 100%); box-shadow: 0 0 10px rgba(129, 140, 248, 0.5); height: 100%;"></div>
                     </div>
                     <div style="font-size: 0.8125rem; color: #94a3b8; font-weight: 500;">{{ course.progress }}% {{ 'Completed'|t }}</div>
                   </div>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        {# NEW BLOCK: RECENT QUIZZES #}
        {% if recent_quizzes|length > 0 %}
          <div class="lms-profile-quizzes-card">
            <h2 class="lms-profile__section-title">{{ 'Recent Quizzes'|t }}</h2>
            <div class="lms-profile-quizzes-card-list">
              {% for quiz in recent_quizzes %}
                <div class="lms-profile-quizzes-card-item" style="justify-content: space-between;">
                  <div>
                    <h4 style="margin: 0 0 0.5rem 0; font-size: 1rem; font-weight: 600; color: #f1f5f9;">{{ quiz.title }}</h4>
                    <span style="font-size: 0.8125rem; color: #94a3b8;"><i class="fas fa-calendar-alt"></i> {{ quiz.date }}</span>
                  </div>
                  <div style="text-align: right;">
                    <span style="display: block; font-size: 1.5rem; font-weight: 800; color: {{ quiz.passed ? '#34d399' : '#f43f5e' }}; text-shadow: 0 0 15px {{ quiz.passed ? 'rgba(52,211,153,0.3)' : 'rgba(244,63,94,0.3)' }};">{{ quiz.score|number_format(0) }}%</span>
                    <span style="font-size: 0.75rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em;">{{ quiz.passed ? 'Passed'|t : 'Failed'|t }}</span>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}

      </div>
      
      {# Right Column (Learning Statistics) #}
      <div class="lms-profile__stats-sidebar">
        
        <div class="lms-gamification-dashboard">
          <h3 class="lms-gamification-dashboard__title">{{ 'Learning Dashboard'|t }}</h3>
          
          <div class="lms-stats-grid">
            <a href="{{ path('lms_progress.my_courses') }}" class="lms-stat-box lms-stat-box--primary" style="text-decoration: none;">
              <div class="lms-stat-box__icon"><i class="fas fa-book-open"></i></div>
              <div class="lms-stat-box__val">{{ courses_enrolled|default('0') }}</div>
              <div class="lms-stat-box__label">{{ 'Enrolled Courses'|t }}</div>
            </a>
            
            <div class="lms-stat-box lms-stat-box--success">
              <div class="lms-stat-box__icon"><i class="fas fa-check-circle"></i></div>
              <div class="lms-stat-box__val">{{ courses_completed|default('0') }}</div>
              <div class="lms-stat-box__label">{{ 'Completed'|t }}</div>
            </div>
            
            <a href="{{ path('lms_progress.certificates') }}" class="lms-stat-box lms-stat-box--warning" style="text-decoration: none;">
              <div class="lms-stat-box__icon"><i class="fas fa-award"></i></div>
              <div class="lms-stat-box__val">{{ certificates_count|default('0') }}</div>
              <div class="lms-stat-box__label">{{ 'Certificates'|t }}</div>
            </a>
            
            <div class="lms-stat-box lms-stat-box--purple">
              <div class="lms-stat-box__icon"><i class="fas fa-star"></i></div>
              <div class="lms-stat-box__val">{{ quiz_average|default('0%') }}</div>
              <div class="lms-stat-box__label">{{ 'Quiz Average'|t }}</div>
            </div>
          </div>
          
          <div class="lms-stat-member-since">
            <span class="lms-stat-member-label">{{ 'Member Since'|t }}</span>
            <span class="lms-stat-member-val">{{ member_since_timestamp|format_date('custom', 'M d, Y') }}</span>
          </div>
        </div>
        
      </div>
      
    </div>
  </div>
</article>
