{# Register form — matches 06-auth-login-register.png #}
{{ attach_library('lms_theme/global') }}

<div class="lms-auth">
  <div class="lms-auth__container">
    <div class="lms-auth__card">
      <div class="lms-auth__header">
        <a href="{{ path('<front>') }}" class="lms-auth__logo">
          <i class="fas fa-graduation-cap"></i> {{ 'Be Fit Gym Academy'|t }}
        </a>
        <h1>{{ 'Tạo tài khoản'|t }}</h1>
        <p>{{ 'Bắt đầu lộ trình học và tập luyện cùng Be Fit.'|t }}</p>
      </div>

      {# Social login buttons #}
      <div class="lms-auth__social">
        <a href="#" class="lms-btn lms-btn--social lms-btn--google">
          <i class="fab fa-google"></i> {{ 'Đăng ký với Google'|t }}
        </a>
        <a href="#" class="lms-btn lms-btn--social lms-btn--facebook">
          <i class="fab fa-facebook-f"></i> {{ 'Đăng ký với Facebook'|t }}
        </a>
      </div>

      <div class="lms-auth__divider">
        <span>{{ 'hoặc đăng ký bằng email'|t }}</span>
      </div>

      {# Drupal register form #}
      {{ form }}

      <div class="lms-auth__footer">
        <p>{{ 'Đã có tài khoản?'|t }} <a href="{{ path('user.login') }}">{{ 'Đăng nhập'|t }}</a></p>
      </div>
    </div>
  </div>
</div>
