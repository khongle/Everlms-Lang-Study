{# EverLMS — Page template — matches mockup navbar + footer #}
<div class="lms-page">
  {# Navbar — matches mockup: Logo | Nav | Login/Register #}
  <header class="lms-navbar">
    <div class="lms-navbar__container">
      <a href="{{ path('<front>') }}" class="lms-navbar__brand" title="{{ site_logo_alt }}" aria-label="{{ site_name }}">
        {% if site_logo_url %}
          <img src="{{ site_logo_url }}" alt="{{ site_logo_alt }}" class="lms-brand-mark lms-brand-mark--header">
        {% else %}
          <i class="fas fa-graduation-cap" aria-hidden="true"></i>
          <span>{{ site_name }}</span>
        {% endif %}
      </a>

      <button class="lms-navbar__toggle" aria-label="Toggle navigation">
        <i class="fas fa-bars"></i>
      </button>

      <nav class="lms-navbar__nav" role="navigation">
        <a href="{{ path('lms_course.catalog') }}" class="lms-navbar__link {{ current_route in ['lms_course.catalog', 'lms_course.detail'] ? 'lms-navbar__link--active' : '' }}">{{ 'Courses'|t }}</a>
        <a href="{{ path('lms_course.category') }}" class="lms-navbar__link {{ current_route in ['lms_course.category', 'lms_course.category_detail'] ? 'lms-navbar__link--active' : '' }}">{{ 'Categories'|t }}</a>
        <a href="{{ path('lms_forum.index') }}" class="lms-navbar__link {{ current_route in ['lms_forum.index', 'entity.lms_forum_topic.canonical'] ? 'lms-navbar__link--active' : '' }}">{{ 'Community'|t }}</a>
        <a href="{{ path('lms_course.pricing') }}" class="lms-navbar__link {{ current_route == 'lms_course.pricing' ? 'lms-navbar__link--active' : '' }}">{{ 'Pricing'|t }}</a>
        <a href="{{ path('lms_blog.frontend.collection') }}" class="lms-navbar__link {{ current_route == 'lms_blog.frontend.collection' or current_route == 'lms_blog.frontend.canonical' ? 'lms-navbar__link--active' : '' }}">{{ 'News'|t }}</a>
        <a href="{{ path('lms_course.glossary') }}" class="lms-navbar__link {{ current_route == 'lms_course.glossary' ? 'lms-navbar__link--active' : '' }}">{{ 'Glossary'|t }}</a>
        {# <a href="#" class="lms-navbar__link">{{ 'Blog'|t }}</a> #}
        {# <a href="#" class="lms-navbar__link">{{ 'Contact'|t }}</a> #}
      </nav>

      <div class="lms-navbar__actions">
        {% if logged_in %}
          <div style="display: flex; align-items: center; gap: 1rem;">
            {{ notification_bell }}
            
            <a href="{{ path('lms_wishlist.my_wishlist') }}" class="lms-navbar__link" style="position: relative; display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; margin-right: 0.5rem; transition: all 0.2s ease;" title="{{ 'My Wishlist'|t }}" onmouseover="this.style.background='rgba(255,255,255,0.05)';" onmouseout="this.style.background='transparent';">
              <i class="far fa-heart" id="lms-wishlist-icon" style="font-size: 1.15rem; color: #8b949e; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);"></i>
              <span id="lms-wishlist-counter" style="position: absolute; top: -3px; right: -4px; background: #f5576c; color: white; border-radius: 50%; font-size: 0.65rem; font-weight: bold; min-width: 16px; height: 16px; display: none; align-items: center; justify-content: center; border: 2px solid #0d1117; box-sizing: content-box; z-index: 2;">0</span>
            </a>
            
            <div class="lms-mega-menu-wrapper" style="position: relative;">
              <a href="{{ path('user.page') }}" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none;" class="lms-user-profile-link">
                {% if current_user_picture %}
                  <img src="{{ current_user_picture }}" alt="{{ current_user_name }}" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(255,255,255,0.1);">
                {% else %}
                  <div style="width: 32px; height: 32px; border-radius: 50%; background: #21262d; display: flex; align-items: center; justify-content: center; color: #8b949e; font-size: 14px; border: 1px solid hsla(0,0%,100%,.1);">
                    <i class="fas fa-user"></i>
                  </div>
                {% endif %}
                <span style="color: #e6edf3; font-weight: 600; font-size: 0.9375rem;">{{ current_user_name }}</span>
                <i class="fas fa-chevron-down ms-1" style="font-size: 0.75rem; color: #8b949e;"></i>
              </a>

              {# Mega Menu Dropdown #}
              {% if 'administrator' in user.roles or 'manager' in user.roles %}
              <div class="lms-mega-dropdown" style="width: max-content;">
                <div class="lms-mega-grid" {% if 'administrator' not in user.roles %}style="grid-template-columns: repeat(3, 1fr);"{% endif %}>
                  <!-- Col 1: PERSONAL -->
                  <div class="lms-mega-col">
                    <div class="lms-mega-col-title">PERSONAL</div>
                    <a href="{{ path('lms_progress.dashboard') }}" class="lms-mega-link"><i class="fas fa-chart-line text-primary"></i> Dashboard</a>
                    <a href="{{ path('lms_progress.my_courses') }}" class="lms-mega-link"><i class="fas fa-book-open text-success"></i> My Courses</a>
                    <a href="{{ path('lms_quiz.my_results') }}" class="lms-mega-link"><i class="fas fa-star text-purple"></i> My Quizzes</a>
                    <a href="{{ path('lms_progress.certificates') }}" class="lms-mega-link"><i class="fas fa-award text-warning"></i> My Certificates</a>
                    <a href="{{ path('lms_course.pricing') }}" class="lms-mega-link"><i class="fas fa-id-badge text-success"></i> Membership</a>
                    <a href="{{ path('user.page') }}" class="lms-mega-link"><i class="fas fa-user text-purple"></i> My Profile</a>
                  </div>
                  <!-- Col 2: CONTENT -->
                  <div class="lms-mega-col">
                    <div class="lms-mega-col-title">CONTENT</div>
                    <a href="/workspace/content/slideshows" class="lms-mega-link"><i class="fas fa-images text-primary"></i> Manage Slideshows</a>
                    <a href="/workspace/content/faqs" class="lms-mega-link"><i class="fas fa-question-circle text-warning"></i> Manage FAQs</a>
                    <a href="/workspace/content/glossaries" class="lms-mega-link"><i class="fas fa-book-open text-purple"></i> Manage Glossaries</a>
                    <a href="/workspace/content/news" class="lms-mega-link"><i class="fas fa-newspaper text-info"></i> Manage News</a>
                    <a href="{{ path('lms_rating.admin_list') }}" class="lms-mega-link"><i class="fas fa-comments text-success"></i> Student Feedback</a>
                  </div>
                  <!-- Col 3: MANAGER -->
                  <div class="lms-mega-col">
                    <div class="lms-mega-col-title">MANAGER</div>
                    <a href="{{ path('lms_course.admin_dashboard') }}" class="lms-mega-link"><i class="fas fa-briefcase text-primary"></i> Workspace</a>
                    <a href="{{ path('lms_course.admin_courses') }}" class="lms-mega-link"><i class="fas fa-video text-success"></i> Manage Courses</a>
                    <a href="{{ path('lms_course.admin_quizzes') }}" class="lms-mega-link"><i class="fas fa-tasks text-warning"></i> Manage Quizzes</a>
                    <a href="{{ path('lms_course.admin_users') }}" class="lms-mega-link"><i class="fas fa-user-graduate text-info"></i> Manage Students</a>
                    <a href="{{ path('lms_certificate.admin_dashboard') }}" class="lms-mega-link"><i class="fas fa-award text-danger"></i> Manage Certificates</a>
                    <a href="{{ path('lms_course.admin_orders') }}" class="lms-mega-link"><i class="fas fa-file-invoice-dollar text-success"></i> Store Orders</a>
                    <a href="/workspace/reports" class="lms-mega-link"><i class="fas fa-chart-bar text-warning"></i> Reports</a>
                  </div>
                  <!-- Col 4: ADMIN -->
                  {% if 'administrator' in user.roles %}
                  <div class="lms-mega-col">
                    <div class="lms-mega-col-title">ADMIN</div>
                    <a href="/admin/config/system/site-information" class="lms-mega-link"><i class="fas fa-cog text-muted"></i> Global Settings</a>
                    <a href="/admin/structure" class="lms-mega-link"><i class="fas fa-cubes text-success"></i> Structure</a>
                    <a href="/admin/people/permissions" class="lms-mega-link"><i class="fas fa-shield-alt text-primary"></i> Roles & Permissions</a>
                    <hr class="lms-mega-divider" />
                    <a href="/open-switcher" class="lms-mega-link"><i class="fas fa-random text-primary"></i> Switch User</a>
                  </div>
                  {% endif %}
                </div>
                
                <div class="lms-mega-footer">
                  <a href="{{ path('user.logout') }}" class="lms-mega-link-logout"><i class="fas fa-sign-out-alt text-danger"></i> Logout</a>
                </div>
              </div>
              {% else %}
              <div class="lms-mega-dropdown lms-mega-dropdown--small">
                <a href="{{ path('lms_progress.dashboard') }}" class="lms-mega-link"><i class="fas fa-chart-line text-primary"></i> Dashboard</a>
                <a href="{{ path('lms_progress.my_courses') }}" class="lms-mega-link"><i class="fas fa-book-open text-success"></i> My Courses</a>
                <a href="{{ path('lms_quiz.my_results') }}" class="lms-mega-link"><i class="fas fa-star text-purple"></i> My Quizzes</a>
                <a href="{{ path('lms_progress.certificates') }}" class="lms-mega-link"><i class="fas fa-award text-warning"></i> My Certificates</a>
                <a href="{{ path('lms_course.profile') }}" class="lms-mega-link"><i class="fas fa-user text-info"></i> My Profile</a>
              </div>
              {% endif %}
            </div>
            
            {% if is_impersonating %}
              <a href="{{ switch_back_url }}" style="background: linear-gradient(135deg, rgba(239,68,68,0.15) 0%, rgba(220,38,38,0.25) 100%); color: #fecaca; border: 1px solid rgba(239,68,68,0.4); padding: 0.4rem 1.15rem; border-radius: 999px; font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.025em; display: flex; align-items: center; gap: 0.5rem; text-decoration: none; transition: all 0.25s ease; box-shadow: 0 0 12px rgba(239,68,68,0.1), inset 0 1px 0 rgba(255,255,255,0.1);" onmouseover="this.style.background='linear-gradient(135deg, rgba(239,68,68,0.25) 0%, rgba(220,38,38,0.35) 100%)'; this.style.boxShadow='0 0 20px rgba(239,68,68,0.2), inset 0 1px 0 rgba(255,255,255,0.2)'; this.style.color='#fff';" onmouseout="this.style.background='linear-gradient(135deg, rgba(239,68,68,0.15) 0%, rgba(220,38,38,0.25) 100%)'; this.style.boxShadow='0 0 12px rgba(239,68,68,0.1), inset 0 1px 0 rgba(255,255,255,0.1)'; this.style.color='#fecaca';">
                <i class="fas fa-user-secret" style="font-size: 0.875rem;"></i> {{ 'Exit Impersonation'|t }}
              </a>
            {% elseif is_manager %}
              <a href="{{ path('lms_course.admin_dashboard') }}" class="lms-btn lms-btn--sm lms-btn--outline"><i class="fas fa-briefcase"></i> {{ 'Workspace'|t }}</a>
            {% else %}
              <a href="{{ path('lms_progress.dashboard') }}" class="lms-btn lms-btn--sm lms-btn--outline">{{ 'Dashboard'|t }}</a>
            {% endif %}
            <a href="{{ path('user.logout') }}" class="lms-navbar__link" style="margin-left: 0.5rem;" title="{{ 'Logout'|t }}">
              <i class="fas fa-sign-out-alt"></i>
            </a>
          </div>
        {% else %}
          <a href="{{ path('user.login') }}" class="lms-navbar__link">{{ 'Login'|t }}</a>
          <a href="{{ path('user.register') }}" class="lms-btn lms-btn--sm lms-btn--primary">{{ 'Register'|t }}</a>
        {% endif %}
      </div>
    </div>
  </header>



  {# Main Content #}
  <main id="main-content" class="lms-page__content">
    {% if page.highlighted %}
      <div class="lms-messages-wrapper">
        {{ page.highlighted }}
      </div>
    {% endif %}
    {{ page.content }}
  </main>

  {# Footer — matches mockup: 4 columns + bottom #}
  <footer class="lms-footer">
    <div class="lms-footer__container">
      <div class="lms-footer__grid">
        <div class="lms-footer__col">
          <div class="lms-footer__brand">
            <a href="{{ path('<front>') }}" class="lms-footer__brand-link" title="{{ site_logo_alt }}" aria-label="{{ site_name }}">
              {% if site_logo_url %}
                <img src="{{ site_logo_url }}" alt="{{ site_logo_alt }}" class="lms-brand-mark lms-brand-mark--footer">
              {% else %}
                <span>{{ site_name }}</span>
              {% endif %}
            </a>
          </div>
          {% if site_tagline %}
            <p class="lms-footer__description">{{ site_tagline }}</p>
          {% endif %}
          <h4>{{ 'Quick Links'|t }}</h4>
          <ul>
            <li><a href="{{ path('<front>') }}">{{ 'Home'|t }}</a></li>
            <li><a href="{{ path('lms_course.catalog') }}">{{ 'Courses'|t }}</a></li>
            <li><a href="{{ path('lms_course.category') }}">{{ 'Categories'|t }}</a></li>
            <li><a href="{{ path('lms_forum.index') }}">{{ 'Community'|t }}</a></li>
            <li><a href="{{ path('lms_course.glossary') }}">{{ 'Glossary'|t }}</a></li>
          </ul>
        </div>
        <div class="lms-footer__col">
          <h4>{{ 'Course'|t }}</h4>
          <ul>
            <li><a href="#">{{ 'News & Notices'|t }}</a></li>

            <li><a href="{{ path('lms_blog.frontend.collection') }}">{{ 'News'|t }}</a></li>
            <li><a href="#">{{ 'Course Guides'|t }}</a></li>
          </ul>
        </div>
        <div class="lms-footer__col">
          <h4>{{ 'Supports'|t }}</h4>
          <ul>
            <li><a href="{{ path('lms_course.about') }}">{{ 'About Us'|t }}</a></li>
            <li><a href="{{ path('lms_course.contact') }}">{{ 'Supports'|t }}</a></li>
            <li><a href="#">{{ 'FAQ'|t }}</a></li>
            <li><a href="{{ path('lms_course.contact') }}">{{ 'Contact Us'|t }}</a></li>
          </ul>
        </div>
        <div class="lms-footer__col">
          <h4>{{ 'Contact Info'|t }}</h4>
          <ul>
            {% if footer_address %}
              <li><i class="fas fa-map-marker-alt"></i> {{ footer_address|nl2br }}</li>
            {% endif %}
            {% if footer_phone %}
              <li><i class="fas fa-phone"></i> <a href="tel:{{ footer_phone|replace({' ': ''}) }}">{{ footer_phone }}</a></li>
            {% endif %}
            {% if footer_email %}
              <li><i class="fas fa-envelope"></i> <a href="mailto:{{ footer_email }}">{{ footer_email }}</a></li>
            {% endif %}
            {% if footer_working_hours %}
              <li><i class="fas fa-clock"></i> {{ footer_working_hours }}</li>
            {% endif %}
          </ul>
          {% if footer_social_links %}
            <div class="lms-footer__social">
              {% for social in footer_social_links %}
                <a href="{{ social.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ social.label }}">
                  <i class="{{ social.icon }}"></i>
                </a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="lms-footer__bottom">
        <p>{{ footer_copyright|nl2br }}</p>
      </div>
    </div>
  </footer>

  <button id="lms-back-to-top" class="lms-back-to-top" aria-label="{{ 'Back to top'|t }}" title="{{ 'Back to top'|t }}">
    <i class="fas fa-arrow-up"></i>
  </button>
</div>

{% if logged_in %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const wishlistToggleBtns = document.querySelectorAll('.lms-wishlist-toggle');
  const courseIds = Array.from(wishlistToggleBtns).map(btn => btn.dataset.courseId).filter(Boolean);
  const counterBatch = document.getElementById('lms-wishlist-counter');
  
  if (courseIds.length > 0 || counterBatch) {
    const idsUnique = [...new Set(courseIds)].join(',');
    fetch('/api/lms/wishlist/status?course_ids=' + idsUnique)
      .then(r => r.json())
      .then(data => {
        // Update counter & visual fill
        if (data.count !== undefined) {
          if (counterBatch) {
            counterBatch.textContent = data.count;
            counterBatch.style.display = data.count > 0 ? 'flex' : 'none';
          }
          const mainIcon = document.getElementById('lms-wishlist-icon');
          if (mainIcon) {
            if (data.count > 0) {
              mainIcon.classList.remove('far');
              mainIcon.classList.add('fas');
              mainIcon.style.color = '#f5576c';
            } else {
              mainIcon.classList.remove('fas');
              mainIcon.classList.add('far');
              mainIcon.style.color = '#8b949e';
            }
          }
        }
        
        // Update cards
        if (data.status) {
          wishlistToggleBtns.forEach(btn => {
            const cid = btn.dataset.courseId;
            const icon = btn.querySelector('i');
            const textSpan = btn.querySelector('.wishlist-text');
            if (data.status[cid] === true) {
              icon.classList.remove('far');
              icon.classList.add('fas');
              icon.style.color = '#ff7b72';
              if (textSpan) textSpan.textContent = 'Remove from Wishlist';
              btn.style.borderColor = 'rgba(255,123,114,0.3)';
            }
          });
        }
      });
  }

  wishlistToggleBtns.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const cid = btn.dataset.courseId;
      const icon = btn.querySelector('i');
      const textSpan = btn.querySelector('.wishlist-text');
      
      // Optimistic UI update
      const isCurrentlyWishlisted = icon.classList.contains('fas');
      if (isCurrentlyWishlisted) {
        icon.classList.remove('fas');
        icon.classList.add('far');
        icon.style.color = '';
        if (textSpan) textSpan.textContent = 'Add to Wishlist';
        btn.style.borderColor = '';
        if (counterBatch) {
          let c = parseInt(counterBatch.textContent) || 0;
          c = Math.max(0, c - 1);
          counterBatch.textContent = c;
          counterBatch.style.display = c > 0 ? 'flex' : 'none';
          const mainIcon = document.getElementById('lms-wishlist-icon');
          if (mainIcon) {
            if (c > 0) {
              mainIcon.classList.remove('far'); mainIcon.classList.add('fas'); mainIcon.style.color = '#f5576c';
            } else {
              mainIcon.classList.remove('fas'); mainIcon.classList.add('far'); mainIcon.style.color = '#8b949e';
            }
          }
        }
      } else {
        icon.classList.remove('far');
        icon.classList.add('fas');
        icon.style.color = '#ff7b72';
        if (textSpan) textSpan.textContent = 'Remove from Wishlist';
        btn.style.borderColor = 'rgba(255,123,114,0.3)';
        if (counterBatch) {
          let c = parseInt(counterBatch.textContent) || 0;
          c += 1;
          counterBatch.textContent = c;
          counterBatch.style.display = c > 0 ? 'flex' : 'none';
          const mainIcon = document.getElementById('lms-wishlist-icon');
          if (mainIcon) {
            mainIcon.classList.remove('far'); mainIcon.classList.add('fas'); mainIcon.style.color = '#f5576c';
          }
        }
      }
      
      // Animate heartbeat effect
      icon.style.transform = 'scale(1.3)';
      setTimeout(() => { icon.style.transform = 'scale(1)'; }, 200);
      
      try {
        await fetch('/api/lms/wishlist/toggle', {
          method: 'POST',
          headers: {'Content-Type': 'application/json', 'Accept': 'application/json'},
          body: JSON.stringify({course_id: cid})
        });
      } catch (err) {
        console.error('Failed to toggle wishlist', err);
      }
    });
  });
});
</script>
<style>
.lms-wishlist-toggle i {
  transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), color 0.2s ease;
}
.lms-wishlist-toggle:hover i {
  color: #ff7b72;
}
</style>
{% endif %}
