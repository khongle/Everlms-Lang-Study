{# EverLMS — Page template — matches mockup navbar + footer #}
<div class="lms-page">
  {# Navbar — matches mockup: Logo | Nav | Login/Register #}
  <header class="lms-navbar">
    <div class="lms-navbar__container">
      <a href="{{ path('<front>') }}" class="lms-navbar__brand">
        <i class="fas fa-graduation-cap"></i> {{ 'EverLMS'|t }}
      </a>

      <button class="lms-navbar__toggle" aria-label="Toggle navigation">
        <i class="fas fa-bars"></i>
      </button>

      <nav class="lms-navbar__nav" role="navigation">
        <a href="{{ path('<front>') }}" class="lms-navbar__link {{ current_route == 'lms_course.homepage' or current_route == '<front>' ? 'lms-navbar__link--active' : '' }}">{{ 'Home'|t }}</a>
        <a href="{{ path('lms_course.catalog') }}" class="lms-navbar__link {{ current_route in ['lms_course.catalog', 'lms_course.detail'] ? 'lms-navbar__link--active' : '' }}">{{ 'Courses'|t }}</a>
        <a href="{{ path('lms_course.category') }}" class="lms-navbar__link {{ current_route in ['lms_course.category', 'lms_course.category_detail'] ? 'lms-navbar__link--active' : '' }}">{{ 'Categories'|t }}</a>
        <a href="{{ path('lms_forum.index') }}" class="lms-navbar__link {{ current_route in ['lms_forum.index', 'entity.lms_forum_topic.canonical'] ? 'lms-navbar__link--active' : '' }}">{{ 'Community'|t }}</a>
        <a href="{{ path('lms_course.pricing') }}" class="lms-navbar__link {{ current_route == 'lms_course.pricing' ? 'lms-navbar__link--active' : '' }}">{{ 'Pricing'|t }}</a>
        {# <a href="#" class="lms-navbar__link">{{ 'Blog'|t }}</a> #}
        {# <a href="#" class="lms-navbar__link">{{ 'Contact'|t }}</a> #}
      </nav>

      <div class="lms-navbar__actions">
        {% if logged_in %}
          <div style="display: flex; align-items: center; gap: 1rem;">
            {{ notification_bell }}
            
            <a href="{{ path('lms_wishlist.my_wishlist') }}" class="lms-navbar__link" style="position: relative; display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; margin-right: 0.5rem; transition: background 0.2s ease;" title="{{ 'My Wishlist'|t }}" onmouseover="this.style.background='rgba(255,255,255,0.05)';" onmouseout="this.style.background='transparent';">
              <div style="position: relative; width: 1.15rem; height: 1.15rem; display: flex; justify-content: center; align-items: center;">
                <i class="far fa-heart" id="lms-wishlist-outline" style="font-size: 1.15rem; color: #8b949e; position: absolute; transition: color 0.3s ease;"></i>
                <div id="lms-wishlist-fill-wrapper" style="position: absolute; bottom: 0; left: 0; right: 0; height: 0%; overflow: hidden; transition: height 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);">
                  <i class="fas fa-heart" style="font-size: 1.15rem; color: #f5576c; position: absolute; bottom: 0; left: 0; right: 0; text-align: center; line-height: 1.15rem; height: 1.15rem; display: flex; align-items: flex-end; justify-content: center;"></i>
                </div>
              </div>
              <span id="lms-wishlist-counter" style="display: none;">0</span>
            </a>
            
            <a href="{{ path('user.page') }}" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none;" class="lms-user-profile-link">
              {% if current_user_picture %}
                <img src="{{ current_user_picture }}" alt="{{ current_user_name }}" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(255,255,255,0.1);">
              {% else %}
                <div style="width: 32px; height: 32px; border-radius: 50%; background: #21262d; display: flex; align-items: center; justify-content: center; color: #8b949e; font-size: 14px; border: 1px solid hsla(0,0%,100%,.1);">
                  <i class="fas fa-user"></i>
                </div>
              {% endif %}
              <span style="color: #e6edf3; font-weight: 600; font-size: 0.9375rem;">{{ current_user_name }}</span>
            </a>
            
            {% if is_manager %}
              <a href="{{ path('lms_course.admin_dashboard') }}" class="lms-btn lms-btn--sm lms-btn--outline"><i class="fas fa-briefcase"></i> {{ 'Workspace'|t }}</a>
            {% else %}
              <a href="{{ path('lms_progress.dashboard') }}" class="lms-btn lms-btn--sm lms-btn--outline">{{ 'Dashboard'|t }}</a>
            {% endif %}
            <a href="{{ path('user.logout') }}" class="lms-navbar__link" style="margin-left: 0.5rem;" title="{{ 'Logout'|t }}">
              <i class="fas fa-sign-out-alt"></i>
            </a>
          </div>
        {% else %}
          <a href="{{ path('user.login') }}" class="lms-navbar__link">{{ 'Login'|t }}</a>
          <a href="{{ path('user.register') }}" class="lms-btn lms-btn--sm lms-btn--primary">{{ 'Register'|t }}</a>
        {% endif %}
      </div>
    </div>
  </header>



  {# Main Content #}
  <main id="main-content" class="lms-page__content">
    {% if page.highlighted %}
      <div class="lms-messages-wrapper" style="margin-bottom: 2rem;">
        {{ page.highlighted }}
      </div>
    {% endif %}
    {{ page.content }}
  </main>

  {# Footer — matches mockup: 4 columns + bottom #}
  <footer class="lms-footer">
    <div class="lms-footer__container">
      <div class="lms-footer__grid">
        <div class="lms-footer__col">
          <h4>{{ 'Quick Links'|t }}</h4>
          <ul>
            <li><a href="{{ path('<front>') }}">{{ 'Home'|t }}</a></li>
            <li><a href="{{ path('lms_course.catalog') }}">{{ 'Courses'|t }}</a></li>
            <li><a href="{{ path('lms_course.category') }}">{{ 'Categories'|t }}</a></li>
            <li><a href="{{ path('lms_forum.index') }}">{{ 'Community'|t }}</a></li>
            <li><a href="#">{{ 'Blog'|t }}</a></li>
          </ul>
        </div>
        <div class="lms-footer__col">
          <h4>{{ 'Course'|t }}</h4>
          <ul>
            <li><a href="#">{{ 'News & Notices'|t }}</a></li>
            <li><a href="{{ path('lms_course.pricing') }}">{{ 'Pricing'|t }}</a></li>
            <li><a href="#">{{ 'Course Guides'|t }}</a></li>
          </ul>
        </div>
        <div class="lms-footer__col">
          <h4>{{ 'Supports'|t }}</h4>
          <ul>
            <li><a href="#">{{ 'About Us'|t }}</a></li>
            <li><a href="#">{{ 'Supports'|t }}</a></li>
            <li><a href="#">{{ 'FAQ'|t }}</a></li>
            <li><a href="#">{{ 'Contact Us'|t }}</a></li>
          </ul>
        </div>
        <div class="lms-footer__col">
          <h4>{{ 'Contact Info'|t }}</h4>
          <ul>
            <li><i class="fas fa-map-marker-alt"></i> {{ 'Company Headquarters, District'|t }}</li>
            <li><i class="fas fa-phone"></i> +01 00 200 0000</li>
            <li><i class="fas fa-phone"></i> +01 00 200 0000</li>
            <li><i class="fas fa-envelope"></i> everlms@gmail.com</li>
          </ul>
        </div>
      </div>

      <div class="lms-footer__bottom">
        <p>{{ 'Powered by'|t }} <a href="#">EverLMS</a></p>
      </div>
    </div>
  </footer>
</div>

{% if logged_in %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const wishlistToggleBtns = document.querySelectorAll('.lms-wishlist-toggle');
  const courseIds = Array.from(wishlistToggleBtns).map(btn => btn.dataset.courseId).filter(Boolean);
  const counterBatch = document.getElementById('lms-wishlist-counter');
  
  if (courseIds.length > 0 || counterBatch) {
    const idsUnique = [...new Set(courseIds)].join(',');
    fetch('/api/lms/wishlist/status?course_ids=' + idsUnique)
      .then(r => r.json())
      .then(data => {
        // Update counter & visual fill
        if (data.count !== undefined) {
          const fillWrapper = document.getElementById('lms-wishlist-fill-wrapper');
          const outlineIcon = document.getElementById('lms-wishlist-outline');
          if (fillWrapper && outlineIcon) {
            if (data.count > 0) {
              let fillPercent = data.count === 1 ? '50%' : '100%';
              fillWrapper.style.height = fillPercent;
              outlineIcon.style.color = '#f5576c';
            } else {
              fillWrapper.style.height = '0%';
              outlineIcon.style.color = '#8b949e';
            }
          }
        }
        
        // Update cards
        if (data.status) {
          wishlistToggleBtns.forEach(btn => {
            const cid = btn.dataset.courseId;
            const icon = btn.querySelector('i');
            const textSpan = btn.querySelector('.wishlist-text');
            if (data.status[cid] === true) {
              icon.classList.remove('far');
              icon.classList.add('fas');
              icon.style.color = '#ff7b72';
              if (textSpan) textSpan.textContent = 'Remove from Wishlist';
              btn.style.borderColor = 'rgba(255,123,114,0.3)';
            }
          });
        }
      });
  }

  wishlistToggleBtns.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const cid = btn.dataset.courseId;
      const icon = btn.querySelector('i');
      const textSpan = btn.querySelector('.wishlist-text');
      
      // Optimistic UI update
      const isCurrentlyWishlisted = icon.classList.contains('fas');
      if (isCurrentlyWishlisted) {
        icon.classList.remove('fas');
        icon.classList.add('far');
        icon.style.color = '';
        if (textSpan) textSpan.textContent = 'Add to Wishlist';
        btn.style.borderColor = '';
        if (counterBatch) {
          let c = parseInt(counterBatch.textContent) || 0;
          c = Math.max(0, c - 1);
          counterBatch.textContent = c;
          const fillWrapper = document.getElementById('lms-wishlist-fill-wrapper');
          const outlineIcon = document.getElementById('lms-wishlist-outline');
          if (fillWrapper && outlineIcon) {
            fillWrapper.style.height = c === 0 ? '0%' : (c === 1 ? '50%' : '100%');
            outlineIcon.style.color = c === 0 ? '#8b949e' : '#f5576c';
          }
        }
      } else {
        icon.classList.remove('far');
        icon.classList.add('fas');
        icon.style.color = '#ff7b72';
        if (textSpan) textSpan.textContent = 'Remove from Wishlist';
        btn.style.borderColor = 'rgba(255,123,114,0.3)';
        if (counterBatch) {
          let c = parseInt(counterBatch.textContent) || 0;
          c += 1;
          counterBatch.textContent = c;
          const fillWrapper = document.getElementById('lms-wishlist-fill-wrapper');
          const outlineIcon = document.getElementById('lms-wishlist-outline');
          if (fillWrapper && outlineIcon) {
            fillWrapper.style.height = c === 1 ? '50%' : '100%';
            outlineIcon.style.color = '#f5576c';
          }
        }
      }
      
      // Animate heartbeat effect
      icon.style.transform = 'scale(1.3)';
      setTimeout(() => { icon.style.transform = 'scale(1)'; }, 200);
      
      try {
        await fetch('/api/lms/wishlist/toggle', {
          method: 'POST',
          headers: {'Content-Type': 'application/json', 'Accept': 'application/json'},
          body: JSON.stringify({course_id: cid})
        });
      } catch (err) {
        console.error('Failed to toggle wishlist', err);
      }
    });
  });
});
</script>
<style>
.lms-wishlist-toggle i {
  transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), color 0.2s ease;
}
.lms-wishlist-toggle:hover i {
  color: #ff7b72;
}
</style>
{% endif %}
