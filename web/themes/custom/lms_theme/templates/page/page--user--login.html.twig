{# EverLMS — User Login Page template #}
<div class="lms-page">
  {# Navbar — matches mockup #}
  <header class="lms-navbar">
    <div class="lms-navbar__container">
      <a href="{{ path('<front>') }}" class="lms-navbar__brand" title="{{ site_logo_alt }}" aria-label="{{ site_name }}">
        {% if site_logo_url %}
          <img src="{{ site_logo_url }}" alt="{{ site_logo_alt }}" class="lms-brand-mark lms-brand-mark--header">
        {% else %}
          <i class="fas fa-graduation-cap" aria-hidden="true"></i>
          <span>{{ site_name }}</span>
        {% endif %}
      </a>
      <div class="lms-navbar__actions">
        <a href="{{ path('user.register') }}" class="lms-navbar__link">{{ 'Register'|t }}</a>
        <a href="{{ path('<front>') }}" class="lms-btn lms-btn--sm lms-btn--outline">{{ 'Back to Home'|t }}</a>
      </div>
    </div>
  </header>

  {# Main Content #}
  <main id="main-content" class="lms-page__content lms-auth">
    <div class="lms-auth__container">
      <div class="lms-auth__card">
        <div class="lms-auth__header">
          <div class="lms-auth__logo">
            <i class="fas fa-user-circle"></i>
          </div>
          <h1>{{ 'Welcome Back'|t }}</h1>
          <p>{{ 'Sign in to access your courses and dashboard.'|t }}</p>
        </div>
        <div class="lms-auth__social mb-4">
          <a href="/user/login/google" class="lms-btn lms-btn--outline w-100 lms-auth__social-btn">
            <i class="fab fa-google text-danger me-2"></i> {{ 'Continue with Google'|t }}
          </a>
          <a href="/user/login/facebook" class="lms-btn lms-btn--outline w-100 lms-auth__social-btn">
            <i class="fab fa-facebook text-primary me-2"></i> {{ 'Continue with Facebook'|t }}
          </a>
        </div>
        
        <div class="text-center my-3 position-relative">
          <hr class="text-muted lms-auth__divider-line">
          <span class="position-absolute top-50 start-50 translate-middle px-3 text-muted lms-auth__divider-label">{{ 'or'|t }}</span>
        </div>

        <div class="lms-auth__form-wrapper mt-4">
          {{ page.content }}
        </div>
        
        <div class="lms-auth__footer mt-4 text-center">
          <p class="mb-2">{{ "Don't have an account?"|t }} <a href="{{ path('user.register') }}">{{ 'Sign up here'|t }}</a></p>
          <p><a href="{{ path('user.pass') }}">{{ 'Forgot your password?'|t }}</a></p>
        </div>
      </div>
    </div>
  </main>
</div>
