{# EverLMS — User Register Page template #}
<div class="lms-page">
  {# Navbar — matches mockup #}
  <header class="lms-navbar">
    <div class="lms-navbar__container">
      <a href="{{ path('<front>') }}" class="lms-navbar__brand" title="{{ site_logo_alt }}" aria-label="{{ site_name }}">
        {% if site_logo_url %}
          <img src="{{ site_logo_url }}" alt="{{ site_logo_alt }}" class="lms-brand-mark lms-brand-mark--header">
        {% else %}
          <i class="fas fa-graduation-cap" aria-hidden="true"></i>
          <span>{{ site_name }}</span>
        {% endif %}
      </a>
      <div class="lms-navbar__actions">
        <a href="{{ path('user.login') }}" class="lms-navbar__link">{{ 'Đăng nhập'|t }}</a>
        <a href="{{ path('<front>') }}" class="lms-btn lms-btn--sm lms-btn--outline">{{ 'Về trang chủ'|t }}</a>
      </div>
    </div>
  </header>

  {# Main Content #}
  <main id="main-content" class="lms-page__content lms-auth">
    <div class="lms-auth__container">
      <div class="lms-auth__card">
        <div class="lms-auth__header text-center mb-4">
          <div class="lms-auth__logo mb-3">
            <i class="fas fa-user-plus"></i>
          </div>
          <h1 class="h3 fw-bold mb-2">{{ 'Tạo tài khoản'|t }}</h1>
          <p class="text-muted">{{ 'Tham gia Be Fit Gym Academy và bắt đầu lộ trình học tập luyện.'|t }}</p>
        </div>
        
        {# Social Auth Buttons #}
        <div class="lms-auth__social mb-4">
          <a href="/user/login/google" class="lms-btn lms-btn--outline w-100 lms-auth__social-btn">
            <i class="fab fa-google text-danger me-2"></i> {{ 'Đăng ký với Google'|t }}
          </a>
          <a href="/user/login/facebook" class="lms-btn lms-btn--outline w-100 lms-auth__social-btn">
            <i class="fab fa-facebook text-primary me-2"></i> {{ 'Đăng ký với Facebook'|t }}
          </a>
        </div>
        
        <div class="text-center my-3 position-relative">
          <hr class="text-muted lms-auth__divider-line">
          <span class="position-absolute top-50 start-50 translate-middle px-3 text-muted lms-auth__divider-label">{{ 'hoặc'|t }}</span>
        </div>

        <div class="lms-auth__form-wrapper mt-4">
          {{ page.content }}
        </div>
        
        <div class="lms-auth__footer mt-4 text-center">
          <p class="mb-0">{{ 'Đã có tài khoản?'|t }} <a href="{{ path('user.login') }}">{{ 'Đăng nhập tại đây'|t }}</a></p>
        </div>
      </div>
    </div>
  </main>
</div>
