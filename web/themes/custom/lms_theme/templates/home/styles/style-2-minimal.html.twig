            {% else %}
              <div class="saas-testimonial__avatar bg-light d-flex align-items-center justify-content-center text-primary fw-bold fs-5">{{ tm.name|slice(0, 1) }}</div>
            {% endif %}
            <div>
              <h4 class="fs-6 fw-bold mb-0 text-dark">{{ tm.name }}</h4>
