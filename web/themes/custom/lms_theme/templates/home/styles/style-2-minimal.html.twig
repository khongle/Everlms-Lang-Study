{# 6.5 INSTRUCTOR SPOTLIGHT #}
{% if homepage_sections.instructor ?? true %}
  {% set spotlight_name = '' %}
  {% set spotlight_avatar = '' %}
  {% set spotlight_role = '' %}
  {% set spotlight_bio = '' %}
  {% set spotlight_url = '' %}

  {% if instructor is defined and instructor %}
    {% set spotlight_name = instructor.name ?? instructor.full_name ?? instructor.display_name ?? '' %}
    {% set spotlight_avatar = instructor.avatar ?? instructor.image_url ?? '' %}
    {% set spotlight_role = instructor.role ?? instructor.title ?? '' %}
    {% set spotlight_bio = instructor.bio ?? instructor.description ?? '' %}
    {% set spotlight_url = instructor.url ?? instructor.profile_url ?? '' %}
  {% endif %}

  {% if spotlight_name is empty and featured_courses|length > 0 %}
    {% set spotlight_course = featured_courses[0] %}
    {% set spotlight_name = spotlight_course.instructor_name ?? '' %}
    {% set spotlight_avatar = spotlight_course.instructor_avatar ?? '' %}
    {% set spotlight_role = spotlight_role ?: ('Lead Instructor'|t) %}
    {% set spotlight_bio = spotlight_course.short_description|default('') %}
    {% set spotlight_url = spotlight_course.instructor_url ?? '' %}
  {% endif %}

  {% if spotlight_name %}
    {% set spotlight_link = spotlight_url ? spotlight_url : path('lms_course.catalog') %}
    {% set spotlight_excerpt = spotlight_bio|striptags %}
    {% set spotlight_related = [] %}
    {% set spotlight_seen = spotlight_name ? [spotlight_name] : [] %}
    {% for course in featured_courses|slice(0, 8) %}
      {% set related_name = course.instructor_name ?? '' %}
      {% if related_name and related_name not in spotlight_seen and spotlight_related|length < 2 %}
        {% set spotlight_seen = spotlight_seen|merge([related_name]) %}
        {% set spotlight_related = spotlight_related|merge([{
          name: related_name,
          avatar: course.instructor_avatar ?? '',
          role: course.instructor_role ?? ('Course Instructor'|t),
          course_title: course.title ?? '',
          url: course.instructor_url ?? course.url ?? path('lms_course.catalog')
        }]) %}
      {% endif %}
    {% endfor %}

    <section class="saas-section saas-section--surface minimal-instructor-section">
      <div class="row justify-content-center">
        <div class="col-xl-11">
          <div class="minimal-instructor-layout">
            <article class="p-4 p-lg-5 rounded-4 bg-white border d-flex flex-column flex-lg-row align-items-center gap-4 gap-lg-5 minimal-instructor-card" data-aos="fade-up">
              <div class="minimal-instructor-avatar-wrap">
                {% if spotlight_avatar %}
                  <img src="{{ spotlight_avatar }}" alt="{{ spotlight_name }}" class="rounded-circle minimal-instructor-avatar">
                {% else %}
                  <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-primary minimal-instructor-avatar-fallback">
                    {{ spotlight_name|slice(0, 1)|upper }}
                  </div>
                {% endif %}
              </div>

              <div class="text-center text-lg-start flex-grow-1">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary-subtle text-primary fw-semibold mb-3 minimal-instructor-chip">
                  <i class="fas fa-user-graduate"></i>
                  {{ 'Instructor Spotlight'|t }}
                </div>
                <h3 class="fw-bolder text-dark mb-2 minimal-instructor-name">{{ spotlight_name }}</h3>
                {% if spotlight_role %}
                  <p class="text-muted fw-semibold mb-3 minimal-instructor-role">{{ spotlight_role }}</p>
                {% endif %}
                <p class="text-muted mb-4 minimal-instructor-bio">
                  {% if spotlight_excerpt %}
                    {{ spotlight_excerpt|slice(0, 220) }}{% if spotlight_excerpt|length > 220 %}...{% endif %}
                  {% else %}
                    {{ 'Learn from seasoned mentors and practical experts guiding real-world outcomes.'|t }}
                  {% endif %}
                </p>
                <a href="{{ spotlight_link }}" class="saas-btn-primary rounded-pill px-4">
                  {{ 'View Courses'|t }} <i class="fas fa-arrow-right ms-2"></i>
                </a>
              </div>
            </article>

            {% if spotlight_related %}
              <aside class="minimal-instructor-related" data-aos="fade-up" data-aos-delay="80">
                {% for mentor in spotlight_related %}
                  <a href="{{ mentor.url }}" class="minimal-instructor-related-card text-decoration-none">
                    <div class="minimal-instructor-related-avatar-wrap">
                      {% if mentor.avatar %}
                        <img src="{{ mentor.avatar }}" alt="{{ mentor.name }}" class="minimal-instructor-related-avatar">
                      {% else %}
                        <div class="minimal-instructor-related-avatar-fallback">
                          {{ mentor.name|slice(0, 1)|upper }}
                        </div>
                      {% endif %}
                    </div>
                    <div class="minimal-instructor-related-content">
                      <h4>{{ mentor.name }}</h4>
                      <p>{{ mentor.role }}</p>
                      {% if mentor.course_title %}
                        <span>{{ mentor.course_title|slice(0, 58) }}{% if mentor.course_title|length > 58 %}...{% endif %}</span>
                      {% endif %}
                    </div>
                    <i class="fas fa-arrow-up-right-from-square minimal-instructor-related-icon"></i>
                  </a>
                {% endfor %}
              </aside>
            {% endif %}
          </div>
        </div>
      </div>
    </section>
  {% endif %}
{% endif %}

{# 7. LATEST NEWS #}
{% if (homepage_sections.news ?? true) and minimal_news %}
<section class="saas-section saas-bg-gray minimal-news-section">
  <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between mb-5 gap-3">
    <div>
      <h2 class="saas-title mb-2">{{ homepage_settings.news_section_title|default('Latest News'|t) }}</h2>
      <p class="saas-lead mb-0 text-muted minimal-section-subtitle">{{ homepage_settings.news_section_subtitle|default('Insights, updates, and practical learning stories from the EverLMS community.'|t) }}</p>
    </div>
    <a href="{{ path('lms_blog.frontend.collection') }}" class="saas-btn-outline">
      {{ homepage_settings.news_section_link_text|default('View All'|t) }} <i class="fas fa-arrow-right ms-2"></i>
    </a>
  </div>

  <div class="row g-4">
    {% for item in minimal_news|slice(0, 3) %}
      {% set news_url = item.url ?? '#' %}
      {% set news_image = item.thumbnail_url ?? item.image_url ?? '' %}
      {% set news_title = item.title ?? ('News item'|t) %}
      <div class="col-md-6 col-xl-4" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 80 }}">
        <article class="bg-white border rounded-4 overflow-hidden h-100 d-flex flex-column minimal-news-card">
          <a href="{{ news_url }}" class="position-relative d-block minimal-news-media">
            {% if news_image %}
              <img src="{{ news_image }}" alt="{{ news_title }}" class="w-100 h-100 object-fit-cover minimal-news-image">
            {% else %}
              <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-light text-muted minimal-news-image-placeholder">
                <i class="fas fa-newspaper fs-3"></i>
              </div>
            {% endif %}
            <span class="position-absolute top-0 start-0 m-3 px-3 py-1 rounded-pill bg-white text-primary fw-bold small text-uppercase minimal-news-chip">
              {{ item.category|default('News') }}
            </span>
          </a>

          <div class="p-4 d-flex flex-column flex-grow-1">
            {% if item.date %}
              <time class="text-muted small fw-semibold mb-2 d-inline-flex align-items-center gap-2 minimal-news-date">
                <i class="far fa-calendar-alt"></i>{{ item.date }}
              </time>
            {% endif %}
            <h3 class="fs-5 fw-bolder text-dark mb-2 lh-sm">
              <a href="{{ news_url }}" class="text-dark text-decoration-none minimal-news-title-link">{{ news_title }}</a>
            </h3>
            {% if item.summary %}
              <p class="text-muted mb-4 flex-grow-1 minimal-news-summary">
                {{ item.summary|striptags|slice(0, 140) }}{% if item.summary|striptags|length > 140 %}...{% endif %}
              </p>
            {% endif %}
            <a href="{{ news_url }}" class="text-primary fw-semibold text-decoration-none mt-auto minimal-news-readmore">
              {{ 'Read More'|t }} <i class="fas fa-arrow-right ms-1"></i>
            </a>
          </div>
        </article>
      </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{# 8. MEMBERSHIP TEASER #}
{% if (homepage_sections.membership ?? true) and minimal_memberships %}
<section class="saas-section saas-section--surface minimal-membership-section">
  <div class="text-center mb-5">
    <h2 class="saas-title mb-2">{{ homepage_settings.membership_section_title|default('Membership Plans'|t) }}</h2>
    <p class="saas-lead text-muted mb-0 minimal-section-subtitle">{{ homepage_settings.membership_section_subtitle|default('Choose a plan that matches your learning pace and long-term goals.'|t) }}</p>
  </div>

  <div class="row g-4 justify-content-center">
    {% for plan in minimal_memberships|slice(0, 3) %}
      {% set is_recommended = plan.recommended ?? plan.is_recommended ?? false %}
      {% set is_free_plan = (plan.is_free ?? false) or ((plan.price ?? 0) <= 0) %}
      {% set plan_features = plan.features is iterable ? plan.features : [] %}
      {% set plan_url = plan.url ?? path('lms_course.pricing') %}
      {% set plan_name = plan.name ?? ('Membership'|t) %}
      <div class="col-md-6 col-xl-4" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 80 }}">
        <article class="bg-white border rounded-4 p-4 h-100 d-flex flex-column position-relative minimal-membership-card{% if is_recommended %} minimal-membership-card--recommended{% endif %}">
          {% if is_recommended %}
            <span class="position-absolute top-0 start-50 translate-middle-x px-3 py-1 rounded-pill bg-primary text-white fw-bold small minimal-membership-badge">
              {{ homepage_settings.membership_recommended_badge_text|default('Recommended'|t) }}
            </span>
          {% endif %}

          <h3 class="fs-4 fw-bolder text-dark mb-2 text-center">{{ plan_name }}</h3>
          {% if plan.description %}
            <p class="text-muted text-center mb-4 minimal-membership-description">
              {{ plan.description|striptags|slice(0, 120) }}{% if plan.description|striptags|length > 120 %}...{% endif %}
            </p>
          {% endif %}

          <div class="text-center mb-4">
            {% if is_free_plan %}
              <span class="minimal-membership-price">{{ homepage_settings.membership_free_price_text|default('Free'|t) }}</span>
            {% elseif plan.price_display is defined and plan.price_display %}
              <span class="minimal-membership-price">{{ plan.price_display }}</span>
            {% else %}
              {% set currency_symbol = '$' %}
              {% if plan.currency is defined and plan.currency == 'EUR' %}
                {% set currency_symbol = 'EUR ' %}
              {% elseif plan.currency is defined and plan.currency == 'GBP' %}
                {% set currency_symbol = 'GBP ' %}
              {% endif %}
              <span class="minimal-membership-price">{{ currency_symbol }}{{ (plan.price ?? 0)|number_format(2, '.', ',') }}</span>
            {% endif %}

            {% if plan.billing_cycle is defined and plan.billing_cycle %}
              <span class="text-muted fw-semibold">/ {{ plan.billing_cycle|replace({'_': ' '})|title }}</span>
            {% elseif plan.period is defined and plan.period %}
              <span class="text-muted fw-semibold">/ {{ plan.period }}</span>
            {% endif %}
          </div>

          {% if plan_features %}
            <ul class="list-unstyled d-flex flex-column gap-2 mb-4 flex-grow-1 minimal-membership-features">
              {% for feature in plan_features|slice(0, 5) %}
                <li class="d-flex align-items-start gap-2 text-muted">
                  <i class="fas fa-check-circle text-primary mt-1"></i>
                  <span>{{ feature }}</span>
                </li>
              {% endfor %}
            </ul>
          {% else %}
            <div class="flex-grow-1"></div>
          {% endif %}

          <a href="{{ plan_url }}" class="saas-btn-primary w-100 rounded-pill text-center">
            {% if is_free_plan %}
              {{ homepage_settings.membership_free_cta_text|default('Start Free'|t) }}
            {% elseif is_recommended %}
              {{ homepage_settings.membership_recommended_cta_text|default('Choose Plan'|t) }}
            {% else %}
              {{ homepage_settings.membership_paid_cta_text|default('Get Started'|t) }}
            {% endif %}
          </a>
        </article>
      </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{# 9. CALL TO ACTION #}
{% if homepage_sections.cta_guest ?? true %}
<section class="saas-section saas-bg-dark saas-section--cta text-center">
  <div class="row justify-content-center">
    <div class="col-lg-8" data-aos="zoom-in">
