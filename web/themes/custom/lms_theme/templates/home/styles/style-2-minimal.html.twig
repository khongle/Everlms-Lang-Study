{# 5. ABOUT / INTRODUCTIONS #}
{% if (homepage_sections.introductions ?? true) and introductions|length > 0 %}
{% set intro_layout = homepage_settings.introductions_layout|default('zigzag') %}
{% set intro_layout_mode = intro_layout|lower %}
{% set minimal_intro_items = intro_layout_mode in ['grid', 'list'] ? introductions : introductions|slice(0, 2) %}
<section class="saas-section saas-section--surface">
  {% for intro in minimal_intro_items %}
    <div class="row align-items-center mb-5 pb-5 {% if not loop.last %}border-bottom minimal-intro-row--bordered{% endif %}" data-aos="fade-up">
      {% if intro.image_position == 'left' %}
      <div class="col-lg-6 mb-5 mb-lg-0 pe-lg-5">
        <div class="saas-intro-img">
          <img src="{{ intro.image_url }}" alt="{{ intro.title }}" class="img-fluid w-100 minimal-intro-image">
        </div>
      </div>
      {% endif %}
      
      <div class="col-lg-6 {% if intro.image_position == 'left' %}ps-lg-5{% else %}pe-lg-5{% endif %}">
        {% if intro.subheading %}
          <div class="d-inline-block px-3 py-1 rounded-pill bg-light text-primary fw-bold mb-4 minimal-intro-chip">
            {{ intro.subheading }}
          </div>
        {% endif %}
        <h2 class="saas-title mb-4 minimal-section-title-lg">{{ intro.title }}</h2>
        <div class="saas-lead mb-5">
          {{ intro.body|raw }}
        </div>
        {% if intro.link_url %}
          <a href="{{ intro.link_url }}" class="saas-btn-outline">{{ intro.link_title }}</a>
        {% endif %}
      </div>

      {% if intro.image_position != 'left' %}
      <div class="col-lg-6 mt-5 mt-lg-0 ps-lg-5">
        <div class="saas-intro-img">
          <img src="{{ intro.image_url }}" alt="{{ intro.title }}" class="img-fluid w-100 minimal-intro-image">
        </div>
      </div>
      {% endif %}
    </div>
  {% endfor %}
</section>
{% endif %}

{# 5.5. FAQS (Global) #}
{% if (homepage_sections.faqs ?? true) and faqs|length > 0 %}
<section class="saas-section saas-section--surface">
  <div class="row">
    <div class="col-lg-5 mb-5 mb-lg-0 pe-lg-5" data-aos="fade-right">
    <h2 class="saas-title mb-4 minimal-section-title-lg">{{ homepage_settings.faq_section_title }}</h2>
      {% if homepage_settings.faq_section_subtitle %}
      <p class="saas-lead mb-5">{{ homepage_settings.faq_section_subtitle }}</p>
      {% endif %}
      
      <div class="saas-intro-img position-relative overflow-visible">
      <div class="position-absolute rounded-circle minimal-faq-glow"></div>
        
        {% set faq_img = 'https://picsum.photos/seed/faq_health/800/800' %}
        {% if featured_courses|length > 0 and featured_courses[0].thumbnail_url %}
           {% set faq_img = featured_courses[0].thumbnail_url %}
        {% endif %}
      <div class="rounded-4 overflow-hidden position-relative z-1 shadow-lg minimal-faq-media">
        <img src="{{ faq_img }}" alt="FAQ Support" class="img-fluid w-100 h-100 minimal-faq-image">
        </div>
        
        <!-- Decoration Box -->
      <div class="position-absolute bg-white p-4 rounded-4 shadow-sm z-2 minimal-faq-support-card">
          <div class="d-flex align-items-center gap-3">
        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center minimal-faq-support-icon">
               <i class="fas fa-headset fs-5"></i>
            </div>
            <div>
              <div class="fw-bold text-dark fs-6">{{ '24/7 Support'|t }}</div>
              <div class="small text-muted">{{ 'We are here to help.'|t }}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-7 ps-lg-5 mt-5 mt-lg-0" data-aos="fade-left">
      <div class="accordion saas-faq-accordion" id="accordionFaqs">
        {% for faq in faqs %}
          <div class="accordion-item">
            <h2 class="accordion-header" id="headingFaq{{ faq.id }}">
              <button class="accordion-button {% if not loop.first %}collapsed{% endif %}" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFaq{{ faq.id }}" aria-expanded="{% if loop.first %}true{% else %}false{% endif %}" aria-controls="collapseFaq{{ faq.id }}">
                {{ faq.question }}
              </button>
            </h2>
            <div id="collapseFaq{{ faq.id }}" class="accordion-collapse collapse {% if loop.first %}show{% endif %}" aria-labelledby="headingFaq{{ faq.id }}" data-bs-parent="#accordionFaqs">
              <div class="accordion-body">
                {{ faq.answer|raw }}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{# 6. TESTIMONIALS (Restored - Feedback User) #}
{% if (homepage_sections.testimonials ?? true) and testimonials|length > 0 %}
<section class="saas-section saas-bg-gray">
  <div class="text-center mb-5">
    <h2 class="saas-title mb-2">{{ homepage_settings.testimonials_section_title }}</h2>
    {% if homepage_settings.testimonials_section_subtitle %}
    <p class="saas-lead text-muted">{{ homepage_settings.testimonials_section_subtitle }}</p>
    {% endif %}
  </div>
  <div class="row g-4 justify-content-center">
    {% for tm in testimonials %}
      <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 100 }}">
        <div class="saas-testimonial">
