      <div class="col-lg-4 col-md-6">
        <div class="p-4 bg-white border rounded-4 text-center d-flex flex-column h-100 minimal-bundle-card">
          <div class="d-inline-block px-3 py-1 bg-primary text-white text-uppercase rounded-pill fw-bold mb-4 mx-auto minimal-bundle-badge">{{ 'Value Bundle'|t }}</div>
          <h3 class="fs-4 fw-bold mb-3">{{ bundle.label() }}</h3>
