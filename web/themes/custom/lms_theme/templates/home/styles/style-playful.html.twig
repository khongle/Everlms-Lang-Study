{# EverLMS - Playful Skin Core Template #}
{{ attach_library('lms_theme/homepage_playful') }}
{% set homepage_sections = homepage_settings.sections_enabled ?? {} %}

<div class="playful-skin-wrapper">
{% if homepage_sections.hero ?? true %}
<section class="playful-hero-breakthrough position-relative">

  <!-- Fun Playful Light Glows on Background -->
  <div class="playful-hero-glow playful-hero-glow-left"></div>
  <div class="playful-hero-glow playful-hero-glow-right"></div>

  <div class="container position-relative z-2">
    {% if slideshows|length > 0 %}
    <div id="playfulHeroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="7000">
      
      <!-- Indicators -->
      {% if slideshows|length > 1 %}
      <div class="carousel-indicators playful-hero-indicators">
        {% for slide in slideshows %}
          <button type="button" data-bs-target="#playfulHeroCarousel" data-bs-slide-to="{{ loop.index0 }}" class="playful-hero-indicator-dot {% if loop.first %}active{% endif %}" aria-current="true" aria-label="Slide {{ loop.index }}"></button>
        {% endfor %}
      </div>
      {% endif %}

      <!-- The Massive Solid "Frame" containing the slides -->
      <div class="carousel-inner shadow-lg playful-hero-frame">
        {% for slide in slideshows %}
        <div class="carousel-item {% if loop.first %}active{% endif %}">
          
          <!-- g-0 prevents gaps, align-items-stretch ensures image column matches text column height -->
          <div class="row g-0 align-items-stretch playful-hero-row">
            
            <!-- Left: Content Frame -->
            <div class="col-lg-6 d-flex flex-column justify-content-center playful-hero-content-col">
              <div>
                <span class="d-inline-flex align-items-center mb-4 playful-hero-chip">
                  <span class="playful-hero-chip-icon">🎯</span> EXPLORE THE FUTURE
                </span>
                
                <h1 class="playful-hero-title">
                  {{ slide.heading|raw }}
                </h1>
                
                <div class="playful-hero-subtext">
                  {{ slide.subheading|raw }}
                </div>
                
                <!-- Clean Stats Row -->
                {% if homepage_sections.stats ?? true %}
                <div class="d-flex align-items-center gap-4 mb-4 playful-hero-stats-row">
                  <div class="d-flex align-items-center gap-2">
                    <span class="playful-hero-star">★</span>
                    <span class="playful-hero-stat-strong">4.9/5</span>
                    <span class="playful-hero-stat-soft">(2k+ reviews)</span>
                  </div>
                  <div class="playful-hero-divider"></div>
                  <div class="d-flex align-items-center gap-2">
                    <span class="playful-hero-stat-strong">{{ stats.students }}</span>
                    <span class="playful-hero-stat-soft">{{ stats.students_label }}</span>
                  </div>
                </div>
                {% endif %}

                <!-- Generic Robus Features -->
                <div class="d-flex gap-4 mb-5 playful-hero-feature-row">
                   <div><span class="playful-hero-check">✔</span> Expert Tutors</div>
                   <div><span class="playful-hero-check">✔</span> Lifetime Access</div>
                </div>

                <!-- CTA Buttons -->
                <div class="d-flex flex-wrap gap-4">
                  {% if slide.link_url %}
                    <a href="{{ slide.link_url }}" class="hero-breakthrough-primary">
                      {{ slide.link_title|default(homepage_settings.default_slide_cta_text) }} <i class="fas fa-arrow-right ms-2 hero-breakthrough-cta-icon"></i>
                    </a>
                  {% endif %}
                  <a href="{{ path('lms_course.catalog') }}" class="hero-breakthrough-secondary">
                    {{ homepage_settings.hero_secondary_cta_text }}
                  </a>
                </div>
              </div>
            </div>
            
            <!-- Right: Seamless Edge-to-Edge Visual -->
            <div class="col-lg-6 position-relative d-none d-lg-block playful-hero-media-col">
              {% if slide.image_url %}
                  <img src="{{ slide.image_url }}" alt="{{ slide.heading|striptags }}" class="playful-hero-media-image" />
              {% else %}
                <div class="d-flex align-items-center justify-content-center h-100 hero-breakthrough-visual-shell">
                  <div class="hero-breakthrough-emoji-grid">
                    <div class="hero-breakthrough-emoji-tile">🚀</div>
                    <div class="hero-breakthrough-emoji-tile">💡</div>
                    <div class="hero-breakthrough-emoji-tile">🎯</div>
                    <div class="hero-breakthrough-emoji-tile">📈</div>
                  </div>
                </div>
              {% endif %}
            </div>

          </div>
        </div>
        {% endfor %}
      </div>
    {% else %}
    <div class="shadow-lg playful-hero-frame">
      <div class="row g-0 align-items-stretch playful-hero-row">
        <div class="col-lg-6 d-flex flex-column justify-content-center playful-hero-content-col">
          <div>
            <span class="d-inline-flex align-items-center mb-4 playful-hero-chip">
              <span class="playful-hero-chip-icon">🎯</span> {{ site_name }}
            </span>

            <h1 class="playful-hero-title">
              {{ homepage_settings.hero_fallback_heading }}
            </h1>

            <div class="playful-hero-subtext">
              {{ homepage_settings.hero_fallback_subtext }}
            </div>

            <div class="d-flex flex-wrap gap-4">
              <a href="{{ homepage_settings.hero_fallback_cta_url }}" class="hero-breakthrough-primary">
                {{ homepage_settings.hero_fallback_cta_text }} <i class="fas fa-arrow-right ms-2 hero-breakthrough-cta-icon"></i>
              </a>
              <a href="{{ path('lms_course.catalog') }}" class="hero-breakthrough-secondary">
                {{ homepage_settings.hero_secondary_cta_text }}
              </a>
            </div>
          </div>
        </div>

        <div class="col-lg-6 d-none d-lg-flex align-items-center justify-content-center hero-breakthrough-visual">
          <div class="hero-breakthrough-emoji-grid">
            <div class="hero-breakthrough-emoji-tile">🚀</div>
            <div class="hero-breakthrough-emoji-tile">💡</div>
            <div class="hero-breakthrough-emoji-tile">🎯</div>
            <div class="hero-breakthrough-emoji-tile">📈</div>
          </div>
        </div>
      </div>
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

<!-- Learning Adventures (Categories) -->
{% if (homepage_sections.categories ?? true) and categories %}
<section class="section confetti-section">
  <div class="container">
    <div class="section-header">
      <span class="section-emoji">🗺️</span>
      <h2 class="section-title">{{ homepage_settings.categories_section_title }}</h2>
      {% if homepage_settings.categories_section_subtitle %}
      <p class="section-desc">{{ homepage_settings.categories_section_subtitle }}</p>
      {% endif %}
    </div>
    <div class="adventures-grid">
      {% for category in categories|slice(0,8) %}
      <a href="{{ path('lms_course.catalog') ~ '?category=' ~ category.entity.id() }}" class="adventure-card playful-adventure-link">
        {% if category.entity.field_icon.entity and category.entity.field_icon.entity.uri.value %}
          <div class="playful-adventure-icon-wrap">
            <img src="{{ file_url(category.entity.field_icon.entity.uri.value) }}" alt="{{ category.name }}" class="playful-adventure-icon-img" />
          </div>
        {% endif %}
        <div class="adventure-title">{{ category.name }}</div>
        <div class="adventure-count">{{ category.course_count|default(0) }} {{ 'Courses'|t }}</div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- Featured Courses -->
{% if (homepage_sections.featured ?? true) and featured_courses %}
<section class="section section-alt">
  <div class="container">
    <div class="section-header">
      <span class="section-emoji">🌟</span>
      <h2 class="section-title">{{ homepage_settings.featured_section_title }}</h2>
      {% if homepage_settings.featured_section_subtitle %}
      <p class="section-desc">{{ homepage_settings.featured_section_subtitle }}</p>
      {% endif %}
    </div>
    <div class="courses-grid">
      {% for course in featured_courses %}
      <div class="course-card">
        <div class="course-thumb">
          <a href="{{ course.url }}" class="playful-course-thumb-link">
            {% if course.thumbnail_url %}
              <img src="{{ course.thumbnail_url }}" alt="{{ course.name }}" class="playful-img-hover playful-course-thumb-img" />
            {% else %}
              <img src="https://picsum.photos/seed/{{ course.id }}/600/450" alt="{{ course.name }}" class="playful-img-hover playful-course-thumb-img" />
            {% endif %}
          </a>
          <div class="course-badge">{{ course.price }}</div>
        </div>
        <div class="course-body">
          
          <!-- Category & Level Tags -->
          <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="course-cat">{{ course.category }}</span>
            <span class="course-level">🔥 {{ course.level }}</span>
          </div>

          <!-- Title -->
          <a href="{{ course.url }}" class="course-title">
            {{ course.name }}
          </a>

          <!-- Details & Description -->
          {% if course.short_description %}
          <div class="course-desc">
            {{ course.short_description|raw }}
          </div>
          {% endif %}

          <div class="playful-instructor-wrap">
            {% if course.instructor_avatar %}
              <img src="{{ course.instructor_avatar }}" alt="{{ course.instructor_name }}" class="playful-instructor-avatar">
            {% else %}
              <div class="playful-instructor-placeholder">👷</div>
            {% endif %}
            <div class="playful-instructor-info">
              <span class="playful-instructor-name">{{ course.instructor_name }}</span>
              <span class="playful-instructor-xp">🎯 +{{ random(100, 500) }} XP</span>
            </div>
          </div>
          
          <div class="course-meta">
            <span class="course-meta-item"><i class="fas fa-book-open text-primary course-meta-icon"></i> {{ course.lesson_count }} {{ 'Lessons'|t }}</span>
            <span class="course-rating">⭐ {{ course.rating }}</span>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- Dynamic CMS Introductions (Card Grid) -->
{% if (homepage_sections.introductions ?? true) and introductions %}
<section class="section confetti-section full-width-breakout">
  <div class="container">
    <div class="section-header">
      <span class="section-emoji">⚡</span>
      <h2 class="section-title">{{ homepage_settings.introductions_section_title }}</h2>
      {% if homepage_settings.introductions_section_subtitle %}
      <p class="section-desc">{{ homepage_settings.introductions_section_subtitle }}</p>
      {% endif %}
    </div>
    <div class="powers-grid">
      {% for intro in introductions %}
      <div class="power-card">
        {% if intro.image_url %}
        <div class="power-img-wrap">
          <img src="{{ intro.image_url }}" alt="{{ intro.title }}" />
        </div>
        {% else %}
        <span class="power-emoji">🛑</span>
        {% endif %}
        <div class="power-title">{{ intro.title }}</div>
        <div class="power-desc">{{ intro.body|striptags|raw }}</div>
        {% if intro.link_url and intro.link_url != '#' %}
        <a href="{{ intro.link_url }}" class="power-link">
          {{ intro.link_title|default(homepage_settings.default_intro_cta_text) }}
        </a>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- Level Up / Learning Paths -->
{% if (homepage_sections.bundles ?? true) and bundles %}
<section class="section section-alt journey-section full-width-breakout">
  <div class="container">
    <div class="section-header">
      <span class="section-emoji">🚀</span>
      <h2 class="section-title">{{ homepage_settings.bundles_section_title }}</h2>
      {% if homepage_settings.bundles_section_subtitle %}
      <p class="section-desc">{{ homepage_settings.bundles_section_subtitle }}</p>
      {% endif %}
    </div>
    <div class="journey-paths">
      {% for bundle in bundles|slice(0,3) %}
      <div class="journey-path">
        <div class="journey-icon">🎮</div>
        <div class="journey-info">
          <div class="journey-title">{{ bundle.title }}</div>
          <p class="journey-desc">{{ bundle.summary|striptags }}</p>
          <div class="journey-milestones">
            <span class="milestone">🌱 Trainee</span>
            <span class="milestone">⚡ Associate</span>
            <span class="milestone">🔥 Specialist</span>
            <span class="milestone">👑 Lead</span>
          </div>
        </div>
        <span class="journey-xp">🏆 {{ random(1000, 5000) }} XP</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}



<!-- Star Learners -->
{% if (homepage_sections.testimonials ?? true) and testimonials %}
<section class="section confetti-section full-width-breakout">
  <div class="container">
    <div class="section-header">
      <span class="section-emoji">🌟</span>
      <h2 class="section-title">{{ homepage_settings.testimonials_section_title }}</h2>
      {% if homepage_settings.testimonials_section_subtitle %}
      <p class="section-desc">{{ homepage_settings.testimonials_section_subtitle }}</p>
      {% endif %}
    </div>
    <div class="learners-grid">
      {% for item in testimonials|slice(0,3) %}
      <div class="learner-card">
        <span class="learner-deco">🎉</span>
        <div class="learner-avatar learner-avatar-media">
          {% if item.avatar %}
            <img src="{{ item.avatar }}" alt="{{ item.name }}" class="learner-avatar-image">
          {% else %}
            👧
          {% endif %}
        </div>
        <div class="learner-stars">
          {% for i in 1..item.rating|default(5) %}⭐{% endfor %}
        </div>
        <p class="learner-quote">"{{ item.content|striptags|raw }}"</p>
        <div class="learner-name">{{ item.name }}</div>
        <div class="learner-role">{{ item.role }}</div>
        <span class="learner-badge">🏅 {{ item.course_title }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- Pricing / Memberships -->
{% if (homepage_sections.membership ?? true) and memberships %}
<section class="section section-alt full-width-breakout playful-pricing-section">
  <div class="container">
    <div class="section-header">
      <span class="section-emoji">💎</span>
      <h2 class="section-title">{{ homepage_settings.membership_section_title }}</h2>
      {% if homepage_settings.membership_section_subtitle %}
      <p class="section-desc">{{ homepage_settings.membership_section_subtitle }}</p>
      {% endif %}
    </div>
    
    <div class="pricing-grid">
      {% for plan in memberships %}
      <div class="pricing-card {% if plan.recommended %}popular{% endif %}">
        {% if plan.recommended %}
          <div class="pricing-popular-badge">{{ homepage_settings.membership_recommended_badge_text }}</div>
        {% endif %}
        
        <span class="pricing-emoji">
          {% if loop.index == 1 %}🌱
          {% elseif loop.index == 2 %}🏆
          {% else %}👑{% endif %}
        </span>
        
        <div class="pricing-tier">{{ plan.name }}</div>
        
        <div class="pricing-price pricing-price-stack">
          <span class="currency pricing-currency">
            {% if plan.currency == 'USD' %}${% elseif plan.currency == 'EUR' %}€{% else %}£{% endif %}
          </span>
          <span class="pricing-amount">{{ plan.price }}</span>
          <span class="period pricing-period">/mo</span>
        </div>
        
        <ul class="pricing-features playful-pricing-features">
          {% for feature in plan.features %}
            <li class="playful-pricing-feature-item">
              <span class="playful-pricing-feature-check">✔</span> {{ feature }}
            </li>
          {% endfor %}
        </ul>
        
        <a href="{{ path('lms_course.pricing') }}" class="pricing-btn {% if plan.price == 0 %}pricing-btn-free{% elseif plan.recommended %}pricing-btn-popular{% else %}pricing-btn-legend{% endif %}">
          {% if plan.price == 0 %}
            {{ homepage_settings.membership_free_cta_text }}
          {% elseif plan.recommended %}
            {{ homepage_settings.membership_recommended_cta_text }}
          {% else %}
            {{ homepage_settings.membership_paid_cta_text }}
          {% endif %}
        </a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- FAQ -->
{% if (homepage_sections.faqs ?? true) and faqs %}
<section class="section section-alt full-width-breakout">
  <div class="container">
    <div class="section-header">
      <span class="section-emoji">❓</span>
      <h2 class="section-title">{{ homepage_settings.faq_section_title }}</h2>
      {% if homepage_settings.faq_section_subtitle %}
      <p class="section-desc">{{ homepage_settings.faq_section_subtitle }}</p>
      {% endif %}
    </div>
    <div class="faq-list">
      {% for f in faqs %}
      <div class="faq-item">
        <button class="faq-question">
          <span>{{ f.question }}</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          {{ f.answer|raw }}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- CTA Banner -->
{% if homepage_sections.cta_guest ?? true %}
<section class="cta-banner full-width-breakout">
  <div class="container">
    <h2>{{ homepage_settings.cta_banner_title }}</h2>
    <p>{{ homepage_settings.cta_banner_description }}</p>
    <a href="{{ path('lms_course.catalog') }}" class="btn-cta-white">{{ homepage_settings.cta_primary_text }}</a>
  </div>
</section>
{% endif %}
</div>
