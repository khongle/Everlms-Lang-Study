{# Homepage template — modernized according to EverLMS plan #}
{{ attach_library('lms_theme/global') }}
{{ attach_library('lms_theme/homepage') }}

{# 1. Hero Section (Dynamic Slideshow + Glassmorphism Search + Animated Stats) #}
<section class="lms-hero lms-hero--carousel position-relative">
  
  {# Bootstrap Carousel #}
  {% if slideshows|length > 0 %}
  <div id="homeSlideshow" class="carousel slide lms-home-carousel" data-bs-ride="carousel" data-bs-interval="6000">
    <div class="carousel-inner h-100">
      {% for slide in slideshows %}
        <div class="carousel-item h-100 {% if loop.first %}active{% endif %}">
          {# Background Image with Ken Burns Effect #}
          <div class="lms-carousel-image-wrapper h-100 w-100 position-absolute top-0 start-0">
            {% if slide.image_url %}
              <img src="{{ slide.image_url }}" class="d-block w-100 h-100 object-fit-cover lms-kenburns-img" alt="{{ slide.heading }}">
            {% else %}
              <div class="w-100 h-100 bg-secondary"></div>
            {% endif %}
          </div>
          
          {# Slide Content in Glass Box #}
          <div class="carousel-caption d-flex h-100 align-items-center pb-5 {% if slide.position == 'left' %}justify-content-start text-start{% elseif slide.position == 'right' %}justify-content-end text-start{% else %}justify-content-center text-center{% endif %}">
            <div class="lms-carousel-content container" data-aos="fade-up">
              <div class="lms-glass-content-box p-4 p-lg-5 rounded-4 d-inline-block shadow-lg border border-white border-opacity-10">
                <div class="lms-hero__badge mb-3 d-inline-block px-3 py-1 rounded-pill fw-semibold" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); backdrop-filter: blur(8px);">{{ '⭐ Featured'|t }}</div>
                <h1 class="lms-hero__title lms-hero__title--lg mb-3 text-white fw-bolder">
                  {{ slide.heading }}
                </h1>
                <div class="lms-hero__subtitle text-white-50 mb-4 fs-6 lh-lg">
                  {{ slide.subheading|raw }}
                </div>
                <a href="{{ slide.link_url }}" class="lms-btn lms-btn--primary lms-btn--lg lms-btn-glow px-4 py-2 rounded-pill fw-bold">
                  {{ slide.link_title }} <i class="fas fa-arrow-right ms-2"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    
    {# Carousel Controls #}
    {% if slideshows|length > 1 %}
    <button class="carousel-control-prev lms-carousel-control" type="button" data-bs-target="#homeSlideshow" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next lms-carousel-control" type="button" data-bs-target="#homeSlideshow" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
    {% endif %}
  </div>
  {% else %}
    {# Elegant Fallback if no slideshow available #}
    <div class="lms-hero__fallback-wrapper w-100 position-relative d-flex align-items-center justify-content-center text-center" style="min-height: 60vh; background: linear-gradient(135deg, #161b22 0%, #0d1117 100%);">
      <div class="lms-carousel-overlay position-absolute top-0 start-0 w-100 h-100" style="background: url('https://picsum.photos/seed/fallback/1920/800') center/cover no-repeat; opacity: 0.15; pointer-events: none;"></div>
      <div class="container lms-hero__container position-relative z-2 pb-5">
        <div class="lms-hero__badge mb-3 d-inline-block">{{ '⭐ Welcome'|t }}</div>
        <h1 class="lms-hero__title lms-hero__title--lg mb-4 text-white">
          {{ 'Welcome to EverLMS'|t }}
        </h1>
        <div class="lms-hero__subtitle text-white-50 mb-5 fs-5">
          {{ 'Start your learning journey with our premium courses today.'|t }}
        </div>
      </div>
    </div>
  {% endif %}

  {# Floating Controls (Search Bar + Stats) #}
  <div class="lms-hero__floating-ui position-absolute w-100 z-3" style="bottom: 0; transform: translateY(50%);">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-10">
          <div class="lms-glass-panel lms-hero__floating-panel p-3 p-md-4 mx-2 rounded-4 shadow-lg border border-white border-opacity-10 d-flex flex-column flex-md-row align-items-center justify-content-between gap-4">
            
            {# Search Bar Side #}
            <div class="lms-hero__floating-search flex-grow-1 w-100">
              <form action="{{ path('lms_course.catalog') }}" method="get">
                <div class="lms-search-bar d-flex align-items-center w-100 bg-black bg-opacity-25 rounded-pill p-2 border border-white border-opacity-25">
                  <i class="fas fa-search lms-search-icon text-white ms-3 me-2"></i>
                  <input type="text" name="q" placeholder="{{ 'What do you want to learn today?'|t }}" class="form-control bg-transparent border-0 text-white shadow-none" style="outline: none;">
                  <button type="submit" class="lms-btn lms-btn--primary rounded-pill px-4 ms-2 fw-semibold">
                    {{ 'Search'|t }}
                  </button>
                </div>
              </form>
            </div>
            
            {# Stats Side #}
            <div class="lms-hero__floating-stats d-flex w-100 w-md-auto gap-4 justify-content-around text-center border-md-start border-white border-opacity-25 ps-md-4">
              <div class="lms-hero-stat-item px-2">
                <h3 class="lms-stat-number fw-bold mb-1"><span class="fs-3">{{ stats.courses }}</span></h3>
                <span class="lms-stat-label text-white-50 small text-uppercase fw-semibold" style="letter-spacing: 1px; font-size: 0.7rem;">{{ 'Premium Courses'|t }}</span>
              </div>
              <div class="lms-hero-stat-item px-2">
                <h3 class="lms-stat-number fw-bold mb-1"><span class="fs-3">{{ stats.students }}</span></h3>
                <span class="lms-stat-label text-white-50 small text-uppercase fw-semibold" style="letter-spacing: 1px; font-size: 0.7rem;">{{ 'Enrolled Students'|t }}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{# Spacer to prevent section below from being overlapped by the floating panel #}
<div class="lms-hero-spacer" style="height: 140px; background-color: transparent;"></div>

{# 1.5. Dynamic Introductions #}
{% if introductions|length > 0 %}
  {% for intro in introductions %}
    <section class="lms-section lms-introduction lms-intro-bg--{{ intro.background_color }}" data-aos="fade-up">
      <div class="container">
        <div class="lms-intro-grid {% if intro.image_position == 'left' %}lms-intro-grid--img-left{% else %}lms-intro-grid--img-right{% endif %}">
          
          <div class="lms-intro__content d-flex flex-column justify-content-center">
            {% if intro.subheading %}
              <div class="lms-intro__subheading">{{ intro.subheading }}</div>
            {% endif %}
            <h2 class="lms-intro__title">{{ intro.title }}</h2>
            <div class="lms-intro__body text-white-75 lh-lg">
              {{ intro.body|raw }}
            </div>
            {% if intro.link_url and intro.link_url != '#' %}
              <div class="lms-intro__action mt-4">
                <a href="{{ intro.link_url }}" class="lms-btn lms-btn--primary lms-btn--glow rounded-pill fw-bold">
                  {{ intro.link_title }} <i class="fas fa-arrow-right ms-2"></i>
                </a>
              </div>
            {% endif %}
          </div>
          
          <div class="lms-intro__visual position-relative">
            {% if intro.image_url %}
              <div class="lms-intro__image-wrapper lms-glass-image-wrapper">
                <img src="{{ intro.image_url }}" alt="{{ intro.title }}" class="img-fluid lms-intro__image object-fit-cover w-100 h-100">
              </div>
            {% endif %}
          </div>
          
        </div>
      </div>
    </section>
  {% endfor %}
{% endif %}

{# 2. Continue Learning Widget (Only for logged-in users) #}
{% if logged_in and my_courses|length > 0 %}
<section class="lms-section lms-section--my-learning" data-aos="fade-up">
  <div class="container">
    <div class="lms-section-header">
      <h2 class="lms-section-title"><i class="fas fa-book-reader text-primary"></i> {{ 'Continue Learning'|t }}</h2>
      <a href="{{ path('lms_progress.dashboard')|default('#') }}" class="lms-link-more">{{ 'My Dashboard'|t }} <i class="fas fa-arrow-right"></i></a>
    </div>
    <div class="lms-progress-cards">
      {% for item in my_courses %}
        <div class="lms-progress-card lms-glass-card">
          <div class="lms-progress-card__thumb">
            {% if item.course.thumbnail_url %}
              <img src="{{ item.course.thumbnail_url }}" alt="{{ item.course.name }}">
            {% else %}
              <div class="lms-thumb-placeholder"><i class="fas fa-video"></i></div>
            {% endif %}
          </div>
          <div class="lms-progress-card__info">
            <h4 class="lms-course-title">{{ item.course.name }}</h4>
            <div class="lms-progress-wrapper">
              <div class="lms-progress-bar">
                <div class="lms-progress-fill lms-gradient-bg" style="width: {{ item.progress }}%;"></div>
              </div>
              <span class="lms-progress-text">{{ item.progress }}% {{ 'Completed'|t }}</span>
            </div>
          </div>
          <div class="lms-progress-card__action">
            <a href="{{ item.course.continue_url }}" class="lms-btn lms-btn--sm lms-btn--outline">{{ 'Resume'|t }}</a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# 3. Popular Categories #}
{% if categories|length > 0 %}
<section class="lms-section lms-bg-darker" data-aos="fade-up">
  <div class="container">
    <div class="lms-section-header text-center">
      <h2 class="lms-section-title">{{ 'Explore Popular Categories'|t }}</h2>
      <p class="lms-section-subtitle">{{ 'Find the perfect topic to boost your skills and career'|t }}</p>
    </div>
    <div class="lms-categories-grid lms-categories-grid--images">
      {% for cat in categories %}
        <a href="{{ path('lms_course.category_detail', {'taxonomy_term': cat.entity.id})|default('#') }}" class="lms-category-card lms-category-card--has-image">
          <div class="lms-category-card__thumb">
            {% if cat.thumbnail_url %}
              <img src="{{ cat.thumbnail_url }}" alt="{{ cat.name }}">
            {% else %}
              <div class="lms-category-card__fallback lms-gradient-bg">
                <i class="fas fa-layer-group"></i>
              </div>
            {% endif %}
            <div class="lms-category-card__overlay"></div>
          </div>
          <div class="lms-category-card__content border-top-glow">
            <h3 class="lms-category-card__title">{{ cat.name }}</h3>
            <span class="lms-category-card__count">{{ cat.course_count }} {{ 'Courses'|t }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# 4. Featured Courses (Case Studies) #}
{% if featured_courses|length > 0 %}
<section class="lms-section" data-aos="fade-up">
  <div class="container">
    <div class="lms-section-header">
      <h2 class="lms-section-title">{{ 'Featured Courses'|t }}</h2>
      <a href="{{ path('lms_course.catalog') }}" class="lms-link-more">{{ 'View All Courses'|t }} <i class="fas fa-arrow-right"></i></a>
    </div>
    <div class="grid-courses lms-courses-grid">
      {% for card in featured_courses %}
        <div class="lms-course-wrapper" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 100 }}">
          {{ { '#theme': 'lms_course_card', '#card': card } }}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# 5. Popular Bundles (If available) #}
{% if bundles is defined and bundles|length > 0 %}
<section class="lms-section lms-section--bundles lms-bg-gradient" data-aos="fade-up">
  <div class="container">
    <div class="lms-section-header lms-text-light text-center">
      <h2 class="lms-section-title">{{ 'Popular Learning Bundles'|t }}</h2>
      <p class="lms-section-subtitle">{{ 'Save up to 40% with our curated course bundles'|t }}</p>
    </div>
    <div class="lms-bundles-grid">
      {% for bundle in bundles %}
        <div class="lms-bundle-card lms-glass-card">
          <div class="lms-bundle-card__badge">{{ 'Save Big'|t }}</div>
          <h3 class="lms-bundle-card__title">{{ bundle.label() }}</h3>
          <div class="lms-bundle-card__price">
            <span class="lms-price-current">${{ bundle.get('field_price').value }}</span>
          </div>
          <a href="#" class="lms-btn lms-btn--primary lms-btn--block">{{ 'View Bundle'|t }}</a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}


{# 7. Testimonials #}
{% if testimonials|length > 0 %}
<section class="lms-section lms-section--testimonials" data-aos="fade-up">
  <div class="container">
    <div class="lms-section-header text-center">
      <h2 class="lms-section-title">{{ 'What Our Students Say'|t }}</h2>
    </div>
    <div class="lms-testimonials-carousel">
      {% for tm in testimonials %}
        <div class="lms-testimonial-card lms-glass-card">
          <div class="lms-testimonial-card__rating">
            {% for i in 1..tm.rating %}
              <i class="fas fa-star text-warning"></i>
            {% endfor %}
          </div>
          <p class="lms-testimonial-card__content">"{{ tm.content }}"</p>
          <div class="lms-testimonial-card__author">
            <img src="{{ tm.avatar }}" alt="{{ tm.name }}" class="lms-author-avatar">
            <div class="lms-author-info">
              <h4 class="lms-author-name">{{ tm.name }}</h4>
              <span class="lms-author-role">{{ tm.role }}</span>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# 8. Call to Action Banner #}
<section class="lms-section lms-cta-banner" data-aos="zoom-in">
  <div class="container">
    <div class="lms-cta-inner lms-gradient-bg lms-glass-panel">
      <h2>{{ 'Ready to Transform Your Career?'|t }}</h2>
      <p>{{ 'Join thousands of students and start learning today.'|t }}</p>
      <div class="lms-cta-actions">
        <a href="{{ path('user.register')|default('#') }}" class="lms-btn lms-btn--light lms-btn--lg">{{ 'Start Free Trial'|t }}</a>
        <a href="{{ path('lms_course.catalog') }}" class="lms-btn lms-btn--outline-light lms-btn--lg">{{ 'Browse Courses'|t }}</a>
      </div>
    </div>
  </div>
</section>
