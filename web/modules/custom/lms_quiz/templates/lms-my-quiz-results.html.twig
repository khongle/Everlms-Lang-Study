{# My Quiz Results #}
{{ attach_library('lms_theme/global') }}

<style>
  .lms-quiz-results-page .lms-quiz-result-row {
    grid-template-columns: 3.75rem minmax(0, 1fr) auto auto;
    gap: 1.1rem;
    align-items: center;
    padding: 1rem 1.15rem;
  }

  .lms-quiz-results-page .lms-quiz-result-row__icon {
    width: 2.75rem;
    height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #eff6ff;
    color: #0369a1;
  }

  .lms-quiz-results-page .lms-quiz-result-row__content,
  .lms-quiz-results-page .lms-quiz-result-row__score {
    min-width: 0;
  }

  .lms-quiz-results-page .lms-quiz-result-row__title {
    overflow-wrap: anywhere;
  }

  .lms-quiz-results-page .lms-quiz-result-row__action {
    justify-self: end;
    align-self: center;
    min-height: 2.75rem;
    padding-inline: 1.1rem;
  }

  @media (max-width: 991px) {
    .lms-quiz-results-page .lms-quiz-result-row {
      grid-template-columns: 1fr;
    }

    .lms-quiz-results-page .lms-quiz-result-row__action {
      justify-self: stretch;
      width: 100%;
    }
  }
</style>

<section class="lms-section lms-quiz-results-page">
  <div class="container">
    <div class="lms-quiz-results-page__hero">
      <div class="lms-quiz-results-page__hero-copy">
        <span class="lms-quiz-results-page__eyebrow">{{ 'Assessment history'|t }}</span>
        <h1 class="lms-quiz-results-page__title">{{ 'My Quiz Results'|t }}</h1>
        <p class="lms-quiz-results-page__subtitle">{{ 'Review every attempt, spot assessments that need another pass, and keep your average score moving upward.'|t }}</p>
      </div>

      <div class="lms-quiz-results-page__summary">
        <div class="lms-quiz-results-page__summary-card">
          <span class="lms-quiz-results-page__summary-value">{{ summary.total }}</span>
          <span class="lms-quiz-results-page__summary-label">{{ 'Attempts'|t }}</span>
        </div>
        <div class="lms-quiz-results-page__summary-card is-success">
          <span class="lms-quiz-results-page__summary-value">{{ summary.passed }}</span>
          <span class="lms-quiz-results-page__summary-label">{{ 'Passed'|t }}</span>
        </div>
        <div class="lms-quiz-results-page__summary-card">
          <span class="lms-quiz-results-page__summary-value">{{ summary.average_score|number_format(0) }}%</span>
          <span class="lms-quiz-results-page__summary-label">{{ 'Average score'|t }}</span>
        </div>
        <div class="lms-quiz-results-page__summary-card is-accent">
          <span class="lms-quiz-results-page__summary-value">{{ summary.best_score|number_format(0) }}%</span>
          <span class="lms-quiz-results-page__summary-label">{{ 'Best score'|t }}</span>
        </div>
      </div>
    </div>

    {% if results|length > 0 %}
      <div class="lms-quiz-results-board">
        {% for item in results %}
          {% set status_text = item.state == 'passed' ? 'Passed'|t : (item.state == 'review' ? 'Review'|t : 'Retry'|t) %}
          {% set icon_class = item.state == 'passed' ? 'fa-check-circle' : (item.state == 'review' ? 'fa-eye' : 'fa-redo') %}

          <article class="lms-quiz-result-row is-{{ item.state }}">
            <div class="lms-quiz-result-row__icon">
              <i class="fas {{ icon_class }}"></i>
            </div>

            <div class="lms-quiz-result-row__content">
              <div class="lms-quiz-result-row__topline">
                <h2 class="lms-quiz-result-row__title">{{ item.quiz_name }}</h2>
                <span class="lms-quiz-result-row__badge is-{{ item.state }}">{{ status_text }}</span>
              </div>
              <p class="lms-quiz-result-row__meta">{{ 'Threshold'|t }} {{ item.threshold|number_format(0) }}% · {{ 'Completed'|t }} {{ item.date|date('M d, Y') }}</p>
            </div>

            <div class="lms-quiz-result-row__score">
              <span class="lms-quiz-result-row__score-value">{{ item.score|number_format(0) }}%</span>
              <span class="lms-quiz-result-row__score-label">{{ 'Final score'|t }}</span>
            </div>

            <a href="{{ item.url }}" class="btn-lms-primary lms-quiz-result-row__action{% if item.state != 'passed' %} is-secondary{% endif %}">
              {{ 'Review Result'|t }}
            </a>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="lms-quiz-results-empty">
        <i class="fas fa-clipboard-check"></i>
        <h3>{{ 'No quiz results yet'|t }}</h3>
        <p class="text-muted">{{ 'Take an assessment to see your performance history.'|t }}</p>
      </div>
    {% endif %}
  </div>
</section>
