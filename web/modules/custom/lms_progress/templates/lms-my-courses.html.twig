{# My Courses page #}
{{ attach_library('lms_theme/global') }}

{% set featured_course = courses|first %}

<section class="lms-section lms-my-courses-page" data-course-filter-root>
  <div class="container">
    <div class="lms-my-courses-page__hero">
      <div class="lms-my-courses-page__hero-copy">
        <span class="lms-my-courses-page__eyebrow">{{ 'Learning hub'|t }}</span>
        <h1 class="lms-my-courses-page__title">{{ 'My Courses'|t }}</h1>
        <p class="lms-my-courses-page__subtitle">{{ 'Organize active enrollments, restart paused work, and revisit completed courses from one place.'|t }}</p>
      </div>

      <div class="lms-my-courses-page__summary">
        <div class="lms-my-courses-page__summary-card">
          <span class="lms-my-courses-page__summary-value">{{ summary.in_progress }}</span>
          <span class="lms-my-courses-page__summary-label">{{ 'In Progress'|t }}</span>
        </div>
        <div class="lms-my-courses-page__summary-card">
          <span class="lms-my-courses-page__summary-value">{{ summary.completed }}</span>
          <span class="lms-my-courses-page__summary-label">{{ 'Completed'|t }}</span>
        </div>
        <div class="lms-my-courses-page__summary-card">
          <span class="lms-my-courses-page__summary-value">{{ summary.not_started }}</span>
          <span class="lms-my-courses-page__summary-label">{{ 'Not Started'|t }}</span>
        </div>
      </div>
    </div>

    {% if courses|length > 0 %}
      {% if featured_course %}
        {% set featured_status = featured_course.status == 'completed' ? 'Completed'|t : (featured_course.status == 'not_started' ? 'Ready to start'|t : 'In progress'|t) %}
        {% set featured_action = featured_course.status == 'completed' ? 'Review Course'|t : (featured_course.status == 'not_started' ? 'Start Course'|t : 'Continue Learning'|t) %}
        <article class="lms-learning-spotlight lms-learning-spotlight--compact">
          <a class="lms-learning-spotlight__media" href="{{ featured_course.url }}">
            {% if featured_course.thumbnail_url %}
              <img src="{{ featured_course.thumbnail_url }}" alt="{{ featured_course.title }}" loading="lazy">
            {% else %}
              <span class="lms-learning-spotlight__placeholder">
                <i class="fas fa-graduation-cap"></i>
              </span>
            {% endif %}
          </a>

          <div class="lms-learning-spotlight__body">
            <div class="lms-learning-spotlight__meta">
              {% if featured_course.category %}
                <span class="lms-learning-spotlight__category">{{ featured_course.category }}</span>
              {% endif %}
              <span class="lms-learning-spotlight__status">{{ featured_status }}</span>
            </div>

            <h2 class="lms-learning-spotlight__title">
              <a href="{{ featured_course.url }}">{{ featured_course.title }}</a>
            </h2>

            <p class="lms-learning-spotlight__copy">{{ 'Keep your queue tidy and move directly into the next course that needs your attention.'|t }}</p>

            <div class="lms-learning-progress lms-learning-progress--hero">
              <div class="lms-learning-progress__meta">
                <span>{{ 'Progress'|t }}</span>
                <strong>{{ featured_course.progress|number_format(0) }}%</strong>
              </div>
              <div class="lms-learning-progress__track">
                <span class="lms-learning-progress__fill{% if featured_course.status == 'completed' %} is-completed{% endif %}" data-progress="{{ featured_course.progress|number_format(2, '.', '') }}"></span>
              </div>
            </div>

            <a href="{{ featured_course.url }}" class="btn-lms-primary lms-learning-spotlight__cta{% if featured_course.status == 'completed' %} is-secondary{% endif %}">
              {{ featured_action }}
            </a>
          </div>
        </article>
      {% endif %}

      <div class="lms-learning-toolbar">
        <div>
          <h2 class="lms-learning-toolbar__title">{{ 'My learning queue'|t }}</h2>
          <p class="lms-learning-toolbar__subtitle">{{ 'Switch between active, completed, and untouched courses without leaving the page.'|t }}</p>
        </div>

        <div class="lms-learning-filters" role="tablist" aria-label="{{ 'Filter courses'|t }}">
          <button type="button" class="lms-learning-filters__button is-active" data-course-filter="all">{{ 'All'|t }}<span>{{ summary.all }}</span></button>
          <button type="button" class="lms-learning-filters__button" data-course-filter="in_progress">{{ 'In Progress'|t }}<span>{{ summary.in_progress }}</span></button>
          <button type="button" class="lms-learning-filters__button" data-course-filter="completed">{{ 'Completed'|t }}<span>{{ summary.completed }}</span></button>
          <button type="button" class="lms-learning-filters__button" data-course-filter="not_started">{{ 'Not Started'|t }}<span>{{ summary.not_started }}</span></button>
        </div>
      </div>

      <div class="grid-courses lms-learning-grid">
        {% for item in courses %}
          {% set status_text = item.status == 'completed' ? 'Completed'|t : (item.status == 'not_started' ? 'Ready to start'|t : 'In progress'|t) %}
          {% set action_text = item.status == 'completed' ? 'Review Course'|t : (item.status == 'not_started' ? 'Start Course'|t : 'Continue Learning'|t) %}
          <article class="card-lms lms-learning-card course-item" data-course-status="{{ item.status }}">
            <a class="lms-learning-card__media" href="{{ item.url }}">
              {% if item.thumbnail_url %}
                <img src="{{ item.thumbnail_url }}" alt="{{ item.title }}" loading="lazy">
              {% else %}
                <span class="lms-learning-card__placeholder"><i class="fas fa-graduation-cap"></i></span>
              {% endif %}

              <div class="lms-learning-card__chips">
                {% if item.category %}
                  <span class="lms-learning-card__category">{{ item.category }}</span>
                {% endif %}
                <span class="lms-learning-card__badge{% if item.status == 'completed' %} is-completed{% elseif item.status == 'not_started' %} is-idle{% endif %}">{{ status_text }}</span>
              </div>
            </a>

            <div class="lms-learning-card__body">
              <h3 class="lms-learning-card__title">
                <a href="{{ item.url }}">{{ item.title }}</a>
              </h3>

              <div class="lms-learning-card__meta">
                <span>{{ item.progress|number_format(0) }}% {{ 'complete'|t }}</span>
                <span>{{ status_text }}</span>
              </div>

              <div class="lms-learning-progress">
                <div class="lms-learning-progress__meta">
                  <span>{{ 'Progress'|t }}</span>
                  <strong>{{ item.progress|number_format(0) }}%</strong>
                </div>
                <div class="lms-learning-progress__track">
                  <span class="lms-learning-progress__fill{% if item.status == 'completed' %} is-completed{% endif %}" data-progress="{{ item.progress|number_format(2, '.', '') }}"></span>
                </div>
              </div>

              <a href="{{ item.url }}" class="btn-lms-primary btn-lms-sm lms-learning-card__cta{% if item.status == 'completed' %} is-secondary{% endif %}">
                {{ action_text }}
              </a>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="lms-learning-empty">
        <i class="fas fa-book-open"></i>
        <h3>{{ 'No enrolled courses yet'|t }}</h3>
        <a href="{{ path('lms_course.catalog') }}" class="lms-btn lms-btn--primary">{{ 'Browse Courses'|t }}</a>
      </div>
    {% endif %}
  </div>
</section>
