{# My Certificates page #}
{{ attach_library('lms_theme/global') }}

<section class="lms-section lms-certificates-page">
  <div class="container">
    <div class="lms-certificates-page__hero">
      <div class="lms-certificates-page__hero-copy">
        <span class="lms-certificates-page__eyebrow">{{ 'Credential archive'|t }}</span>
        <h1 class="lms-certificates-page__title">{{ 'My Certificates'|t }}</h1>
        <p class="lms-certificates-page__subtitle">{{ 'Every completed course is stored here with a certificate number, issue date, and downloadable proof of completion.'|t }}</p>
      </div>

      <div class="lms-certificates-page__summary">
        <div class="lms-certificates-page__summary-card">
          <span class="lms-certificates-page__summary-value">{{ summary.total }}</span>
          <span class="lms-certificates-page__summary-label">{{ 'Certificates earned'|t }}</span>
        </div>
        <div class="lms-certificates-page__summary-card">
          <span class="lms-certificates-page__summary-value">{{ summary.templates }}</span>
          <span class="lms-certificates-page__summary-label">{{ 'Template tracks'|t }}</span>
        </div>
        <div class="lms-certificates-page__summary-card">
          <span class="lms-certificates-page__summary-value">{{ summary.latest_issue ? summary.latest_issue|date('M Y') : '—' }}</span>
          <span class="lms-certificates-page__summary-label">{{ 'Latest issue'|t }}</span>
        </div>
      </div>
    </div>

    {% if certificates|length > 0 %}
      <div class="lms-certificates-grid">
        {% for cert in certificates %}
          <article class="lms-certificate-card">
            <div class="lms-certificate-card__preview">
              <div class="lms-certificate-card__frame">
                <span class="lms-certificate-card__brand">{{ 'EverLMS'|t }}</span>
                <strong class="lms-certificate-card__heading">{{ 'Certificate of Completion'|t }}</strong>
                <span class="lms-certificate-card__course">{{ cert.course_name }}</span>
                <span class="lms-certificate-card__track">{{ cert.template_name }}</span>
                <span class="lms-certificate-card__serial">#{{ cert.certificate_number }}</span>
              </div>
            </div>

            <div class="lms-certificate-card__body">
              <div class="lms-certificate-card__meta">
                <div>
                  <span class="lms-certificate-card__meta-label">{{ 'Issued'|t }}</span>
                  <strong class="lms-certificate-card__meta-value">{{ cert.issued_at|date('M d, Y') }}</strong>
                </div>
                <div>
                  <span class="lms-certificate-card__meta-label">{{ 'Certificate ID'|t }}</span>
                  <strong class="lms-certificate-card__meta-value lms-certificate-card__meta-value--mono">{{ cert.certificate_number }}</strong>
                </div>
              </div>

              <div class="lms-certificate-card__actions">
                {% if cert.pdf %}
                  <a href="{{ file_url(cert.pdf.uri.value) }}" target="_blank" class="btn-lms-primary lms-certificate-card__button">
                    {{ 'Download PDF'|t }}
                  </a>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="lms-certificates-empty">
        <i class="fas fa-award"></i>
        <h3>{{ 'No certificates yet'|t }}</h3>
        <p>{{ 'Complete a course to earn your first prestigious certificate!'|t }}</p>
      </div>
    {% endif %}
  </div>
</section>
