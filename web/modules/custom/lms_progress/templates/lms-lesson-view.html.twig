{# Lesson View — Learning page #}
{{ attach_library('lms_theme/global') }}

<div class="lms-learn"
  data-course-id="{{ course.id() }}"
  data-lesson-id="{{ lesson.id() }}"
  data-lesson-type="{{ lesson.field_type.value }}"
  data-my-courses-url="{{ path('lms_progress.my_courses') }}">
  <div class="lms-learn__main">
    {# Content area #}
    <div class="lms-learn__content">
      {# Lesson title, with compact icon-only utility actions on the same row.
         "Back to Course" now lives on the sidebar course title (see below);
         removing the separate breadcrumb/toolbar row reclaims that vertical
         space for the actual lesson content. #}
      <div class="lms-learn__title-wrap">
        <h1 class="lms-learn__title">{{ lesson.label }}</h1>
        <div class="lms-learn__title-actions">
          {% if is_admin %}
            <a href="{{ path('entity.lms_lesson.edit_form', {'lms_lesson': lesson.id()}) }}" class="lms-learn__icon-btn" title="{{ 'Edit Lesson'|t }}" aria-label="{{ 'Edit Lesson'|t }}">
              <i class="fas fa-pencil-alt"></i>
            </a>
          {% endif %}
          <button id="lms-sidebar-toggle" class="lms-learn__icon-btn" title="{{ 'Theater Mode'|t }}" aria-label="{{ 'Theater Mode'|t }}">
            <i class="fas fa-expand-arrows-alt"></i>
          </button>
        </div>
      </div>

      {# Video / Content #}
      <div class="lms-learn__player">
        {% set type = lesson.field_type.value %}

        {% if type == 'video' %}
          {% if video_embed_url %}
            <div class="lms-learn__video-wrapper">
              <iframe src="{{ video_embed_url }}"
                allowfullscreen
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                class="lms-learn__iframe">
              </iframe>
            </div>
          {% elseif rendered_attachments %}
            <div class="lms-learn__video-container">
              {{ rendered_attachments }}
            </div>
          {% else %}
            <div class="lms-learn__placeholder lms-learn__placeholder--compact">
              <i class="fas fa-video-slash lms-learn__placeholder-icon"></i>
              <h3 class="lms-learn__placeholder-title">{{ 'No video uploaded yet'|t }}</h3>
              <p class="lms-learn__placeholder-copy">{{ 'Please upload an .mp4 file in the lesson edit screen.'|t }}</p>
            </div>
          {% endif %}
        {% elseif type == 'text' %}
          <div class="lms-learn__text-content">
            {{ lesson.field_content.value|raw }}
          </div>
        {% elseif type == 'scorm' %}
          {% if scorm_url %}
            <div class="lms-learn__video-wrapper lms-learn__video-wrapper--scorm">
              <iframe class="lms-learn__iframe" src="{{ scorm_url }}?v={{ random() }}" allowfullscreen></iframe>
            </div>
          {% else %}
            <div class="lms-learn__placeholder lms-learn__placeholder--compact">
              <i class="fas fa-box-open lms-learn__placeholder-icon"></i>
              <h3 class="lms-learn__placeholder-title">{{ 'Interactive package unavailable'|t }}</h3>
              <p class="lms-learn__placeholder-copy">{{ 'This SCORM package has not been published to the learning player yet. The lesson overview remains available below.'|t }}</p>
            </div>
          {% endif %}
        {% elseif type == 'h5p' %}
          <div class="lms-learn__h5p-wrapper">
            {% if rendered_attachments %}
              {{ rendered_attachments }}
            {% elseif lesson.field_h5p_embed.value %}
              <div class="lms-learn__video-wrapper">
                {{ lesson.field_h5p_embed.value|raw }}
              </div>
            {% else %}
              <div class="lms-learn__placeholder lms-learn__placeholder--compact">
                <i class="fas fa-cubes lms-learn__placeholder-icon"></i>
                <h3 class="lms-learn__placeholder-title">Chưa có nội dung H5P</h3>
                <p class="lms-learn__placeholder-copy">Vui lòng upload tệp .h5p trong phần chỉnh sửa bài học.</p>
              </div>
            {% endif %}
          </div>
        {% elseif type == 'pdf' %}
          <div class="lms-learn__pdf-wrapper">
            {% if rendered_attachments|length > 0 %}
              {{ rendered_attachments }}
            {% else %}
              <div class="lms-learn__placeholder">
                <i class="fas fa-file-pdf"></i>
                <h3>{{ 'No PDF Attachment Found'|t }}</h3>
              </div>
            {% endif %}
          </div>
        {% elseif type == 'pptx' %}
           <div class="lms-learn__video-wrapper lms-learn__video-wrapper--pptx">
            {% if rendered_attachments|length > 0 %}
               {{ rendered_attachments }}
              <div class="lms-learn__viewer-note">
                  <i class="fas fa-info-circle text-warning"></i> Demo note: Microsoft viewer requires a public URL (localhost won't work).
               </div>
            {% else %}
              <div class="lms-learn__placeholder">
                <i class="fas fa-file-powerpoint"></i>
                <h3>{{ 'No PPTX Attachment Found'|t }}</h3>
              </div>
            {% endif %}
          </div>

        {% elseif type == 'quiz' %}
          <div class="lms-learn__placeholder">
            <i class="fas fa-question-circle lms-learn__placeholder-icon lms-learn__placeholder-icon--accent"></i>
            <h3 class="lms-learn__placeholder-title lms-learn__placeholder-title--large">{{ lesson.label }}</h3>
            {% if quiz_id %}
              <a href="{{ path('lms_quiz.take', {'lms_quiz': quiz_id}) }}" class="btn-lms-primary lms-learn__quiz-cta">
                <i class="fas fa-play"></i> Bắt đầu bài thi (Take Quiz)
              </a>
              <p class="lms-learn__quiz-note">
                Hệ thống sẽ chuyển hướng bạn đến trang làm bài thi. Xin lưu ý tính năng chấm điểm hiện đang được xây dựng.
              </p>
            {% else %}
              <p class="lms-learn__placeholder-copy lms-learn__placeholder-copy--error">Chưa có bài Quiz nào được gắn vào bài học này.</p>
            {% endif %}
          </div>
        {% elseif type == 'zoom' %}
          <div class="lms-learn__zoom-wrapper">
            {% if rendered_attachments %}
              {{ rendered_attachments }}
            {% else %}
              <div class="lms-learn__placeholder lms-learn__placeholder--compact">
                <i class="fas fa-video-slash lms-learn__placeholder-icon lms-learn__placeholder-icon--error"></i>
                <h3 class="lms-learn__placeholder-title">{{ 'Zoom room not ready'|t }}</h3>
                <p class="lms-learn__placeholder-copy">{{ 'The Zoom configuration may have an error, or a Meeting ID has not been generated yet.'|t }}</p>
              </div>
            {% endif %}
          </div>
        {% else %}
          <div class="lms-learn__placeholder">
            <i class="fas fa-{{ type == 'h5p' ? 'puzzle-piece' : (type == 'zoom' ? 'video' : 'file-alt') }}"></i>
            <p>{{ type|capitalize }} {{ 'content'|t }}</p>
          </div>
        {% endif %}
      </div>

      {# Lesson Tabs Section, with the completion action inline on the same
         row — it used to sit alone in its own full-width block, which read
         as a lot of empty space for a single button. #}
      <div class="lms-learn__tabs-container">
        <div class="lms-learn__tabs-row">
          <ul class="lms-nav-tabs">
            <li class="lms-tab-item active" data-tab="overview">{{ 'Overview'|t }}</li>
            <li class="lms-tab-item" data-tab="resources">{{ 'Resources'|t }}</li>
            <li class="lms-tab-item" data-tab="notes">{{ 'My Notes'|t }}</li>
            <li class="lms-tab-item" data-tab="qna">{{ 'Q&A Discussion'|t }}</li>
          </ul>

          <div class="lms-learn__actions">
            {% set current_lesson_completed = false %}
            {% for item in curriculum %}
              {% for l in item.lessons %}
                {% if l.entity.id() == lesson.id() and l.is_completed %}
                  {% set current_lesson_completed = true %}
                {% endif %}
              {% endfor %}
            {% endfor %}

            {% if current_lesson_completed %}
              <button class="btn-lms-outline lms-learn__action-completed" disabled>
                <i class="fas fa-check-double"></i> <span>{{ 'Completed!'|t }}</span>
              </button>
            {% else %}
              <button id="lms-mark-complete"
                      class="btn-lms-success lms-learn__action-mark"
                      data-course-id="{{ course.id() }}"
                      data-lesson-id="{{ lesson.id() }}">
                <i class="fas fa-check"></i> <span>{{ 'Mark Complete'|t }}</span>
              </button>
            {% endif %}
          </div>
        </div>

        <div class="lms-tab-content">
          {# Tab 1: Overview #}
          <div id="tab-overview" class="lms-tab-pane is-active">
            {% if lesson.field_content.value and type != 'text' %}
              <div class="lms-learn__description">
                {{ lesson.field_content.value|raw }}
              </div>
            {% else %}
               <div class="lms-learn__placeholder lms-learn__placeholder--muted">
                 {% if type == 'text' %}
                   {{ 'The full lesson reading is shown above. Use the Resources, Notes, and Q&A tabs for extras.'|t }}
                 {% else %}
                   {{ 'No overview description available for this lesson.'|t }}
                 {% endif %}
               </div>
            {% endif %}
          </div>

          {# Tab 2: Resources #}
          <div id="tab-resources" class="lms-tab-pane">
            {% if lesson.field_attachments|length > 0 %}
              <div class="lms-learn__attachments">
                <h3 class="lms-learn__resources-title"><i class="fas fa-paperclip lms-learn__resources-title-icon"></i> {{ 'Downloadable Materials'|t }}</h3>
                <ul class="lms-learn__resource-list">
                  {% for file in lesson.field_attachments %}
                    <li class="lms-learn__resource-item">
                      <div class="lms-learn__resource-meta">
                        <i class="fas fa-file-alt lms-learn__resource-icon"></i>
                        <span class="lms-learn__resource-name">{{ file.entity.filename.value }}</span>
                      </div>
                      <a href="{{ file_url(file.entity.uri.value) }}" target="_blank" class="btn-lms-outline btn-lms-sm lms-learn__resource-download">
                        <i class="fas fa-download"></i> {{ 'Download'|t }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% else %}
              <div class="lms-learn__placeholder lms-learn__placeholder--resource-empty">
                <i class="fas fa-folder-open lms-learn__placeholder-icon"></i>
                <h4 class="lms-learn__placeholder-subtitle">{{ 'No resources available'|t }}</h4>
                <p class="lms-learn__placeholder-copy">{{ 'There are no materials attached to this lesson.'|t }}</p>
              </div>
            {% endif %}
          </div>

          {# Tab 2: Notes #}
          <div id="tab-notes" class="lms-tab-pane">
            <div class="lms-learn__notes">
              <div class="lms-learn__notes-head">
                <h3 class="lms-learn__notes-title"><i class="fas fa-edit lms-learn__notes-title-icon"></i> {{ 'My Notes'|t }}</h3>
                <span id="lms-note-status" class="lms-learn__notes-status"></span>
              </div>
              <textarea id="lms-note-textarea" class="lms-form-control lms-learn__notes-textarea" rows="8" placeholder="{{ 'Loading...'|t }}" disabled></textarea>

              <div class="lms-learn__notes-attachments">
                <ul id="lms-note-attachment-list" class="lms-learn__notes-attachment-list"></ul>

                <label class="lms-learn__notes-attach-btn" for="lms-note-attachment-input">
                  <i class="fas fa-paperclip"></i> {{ 'Attach a file'|t }}
                  <input type="file" id="lms-note-attachment-input" accept=".mp3,.wav,.pdf,.jpg,.jpeg,.png,.gif" multiple hidden disabled>
                </label>
                <span class="lms-learn__notes-attach-hint">{{ 'mp3, wav, pdf, jpg, png, gif — up to 10 MB each'|t }}</span>
              </div>

              <div class="lms-learn__notes-actions">
                <button id="lms-note-delete-btn" class="lms-btn lms-learn__notes-btn lms-learn__notes-btn--delete">
                  <i class="fas fa-trash-alt"></i> {{ 'Delete Note'|t }}
                </button>
                <button id="lms-note-save-btn" class="lms-btn lms-learn__notes-btn lms-learn__notes-btn--save" disabled>
                  <i class="fas fa-save"></i> {{ 'Save Note'|t }}
                </button>
              </div>
            </div>
          </div>

          {# Tab 3: Q&A #}
          <div id="tab-qna" class="lms-tab-pane">
            <div class="lms-learn__discussion">
              <div class="lms-learn__discussion-head">
                <h3 class="lms-learn__discussion-title"><i class="fas fa-comments lms-learn__discussion-title-icon"></i> {{ 'Q&A Discussion'|t }}</h3>
                <p class="lms-learn__discussion-subtitle">{{ 'Have a question or want to discuss this lesson? Leave a comment below.'|t }}</p>
              </div>
              <div class="lms-comments-wrapper lms-comments-wrapper--lesson">
                <div id="lms-comments-ajax-wrapper">
                  {{ comments }}
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

  {# Sidebar — Curriculum #}
  <aside class="lms-learn__sidebar">
    <button id="lms-floating-sidebar-toggle" class="lms-floating-sidebar-toggle" title="Toggle Sidebar">
       <i class="fas fa-chevron-right"></i>
    </button>
    
    <div class="lms-learn__sidebar-header">
      <a href="{{ path('lms_course.detail', {'lms_course': course.id()}) }}" class="lms-learn__course-title-link" title="{{ 'Back to Course'|t }}">
        <i class="fas fa-arrow-left lms-learn__course-title-back-icon"></i>
        <h2 class="lms-learn__course-title">{{ course.label }}</h2>
      </a>

      {% set total_lessons = 0 %}
      {% set completed_lessons = 0 %}
      {% for item in curriculum %}
        {% for l in item.lessons %}
          {% set total_lessons = total_lessons + 1 %}
          {% if l.is_completed %}
            {% set completed_lessons = completed_lessons + 1 %}
          {% endif %}
        {% endfor %}
      {% endfor %}
      {% set progress_percent = total_lessons > 0 ? (completed_lessons / total_lessons * 100)|round(0, 'floor') : 0 %}
      
      <div class="lms-learn__progress-wrapper">
        <div class="lms-learn__progress-meta">
          <span class="lms-learn__progress-label">Course Progress</span>
          <span class="lms-learn__progress-value">{{ progress_percent }}%</span>
        </div>
        <div class="lms-progress-bar">
          <div class="lms-progress-bar__fill" data-progress="{{ progress_percent|number_format(2, '.', '') }}"></div>
        </div>
        <div class="lms-learn__progress-legend">
          {{ completed_lessons }} / {{ total_lessons }} lessons
        </div>
      </div>
    </div>
    <nav class="lms-learn__nav">
      {% for item in curriculum %}
        {% set is_active_chapter = false %}
        {% for l in item.lessons %}
          {% if l.entity.id() == lesson.id() %}
            {% set is_active_chapter = true %}
          {% endif %}
        {% endfor %}

        <details class="lms-learn__chapter-accordion" {% if is_active_chapter %}open{% endif %}>
          <summary class="lms-learn__chapter-summary">
            <h4 class="lms-learn__chapter-title">{{ item.chapter.label }}</h4>
            <i class="fas fa-chevron-down toggle-icon"></i>
          </summary>
          <ul class="lms-learn__lesson-list">
            {% for l in item.lessons %}
              <li class="lms-learn__lesson-item {% if l.entity.id() == lesson.id() %}lms-learn__lesson-item--active{% endif %}">
                <a href="{{ path('lms_progress.lesson_view', {'lms_course': course.id(), 'lms_lesson': l.entity.id()}) }}" class="lms-learn__lesson-link">
                  <div class="lms-learn__lesson-main">
                    {% if l.is_completed %}
                      <i class="fas fa-check-circle lms-learn__lesson-icon is-completed"></i>
                    {% else %}
                      {% set type_icons = {
                        'video': 'fa-play-circle',
                        'text': 'fa-file-alt',
                        'quiz': 'fa-question-circle',
                        'h5p': 'fa-puzzle-piece',
                        'pdf': 'fa-file-pdf',
                        'scorm': 'fa-box-open',
                        'pptx': 'fa-file-powerpoint',
                        'zoom': 'fa-video',
                      } %}
                      <i class="fas {{ type_icons[l.entity.field_type.value] ?? 'fa-file' }} lms-learn__lesson-icon"></i>
                    {% endif %}
                    <span class="lms-learn__lesson-text">{{ l.entity.label }}</span>
                  </div>
                  {% if l.entity.field_duration.value > 0 %}
                    <small class="lms-learn__lesson-duration">{{ l.entity.field_duration.value }}m</small>
                  {% endif %}
                </a>
              </li>
            {% endfor %}
          </ul>
        </details>
      {% endfor %}
    </nav>
  </aside>
</div>
