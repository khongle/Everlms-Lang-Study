{# Dashboard page #}
{{ attach_library('lms_theme/global') }}

<section class="lms-section">
  <div class="container">
    <h1 class="lms-manage__title">{{ 'Dashboard'|t }}</h1>

    {# KPI Cards #}
    <div class="lms-kpi-grid">
      <div class="lms-card lms-kpi-card">
        <div class="lms-kpi-card__icon lms-kpi-card__icon--primary">
          <i class="fas fa-book-open"></i>
        </div>
        <div class="lms-kpi-card__content">
          <span class="lms-kpi-card__value">{{ stats.enrolled }}</span>
          <span class="lms-kpi-card__label">{{ 'Enrolled Courses'|t }}</span>
        </div>
      </div>

      <div class="lms-card lms-kpi-card">
        <div class="lms-kpi-card__icon lms-kpi-card__icon--warning">
          <i class="fas fa-spinner"></i>
        </div>
        <div class="lms-kpi-card__content">
          <span class="lms-kpi-card__value">{{ stats.in_progress }}</span>
          <span class="lms-kpi-card__label">{{ 'In Progress'|t }}</span>
        </div>
      </div>

      <div class="lms-card lms-kpi-card">
        <div class="lms-kpi-card__icon lms-kpi-card__icon--success">
          <i class="fas fa-check-circle"></i>
        </div>
        <div class="lms-kpi-card__content">
          <span class="lms-kpi-card__value">{{ stats.completed }}</span>
          <span class="lms-kpi-card__label">{{ 'Completed'|t }}</span>
        </div>
      </div>

      <div class="lms-card lms-kpi-card">
        <div class="lms-kpi-card__icon lms-kpi-card__icon--info">
          <i class="fas fa-certificate"></i>
        </div>
        <div class="lms-kpi-card__content">
          <span class="lms-kpi-card__value">{{ stats.certificates }}</span>
          <span class="lms-kpi-card__label">{{ 'Certificates'|t }}</span>
        </div>
      </div>
    </div>

    {# Continue Learning #}
    {% if recent_courses|length > 0 %}
      <div class="lms-manage__header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; margin-top: 3rem;">
        <h2 class="lms-section__title" style="margin: 0;">{{ 'Continue Learning'|t }}</h2>
        <div class="lms-course-filters" style="display: flex; gap: 0.5rem; background: #161b22; padding: 0.25rem; border-radius: 0.5rem; border: 1px solid hsla(0,0%,100%,0.1);">
          <button class="lms-filter-btn active" data-filter="all" style="background: #667eea; color: #fff; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; font-size: 0.8125rem; font-weight: 600; cursor: pointer; transition: all 0.2s;">{{ 'All'|t }}</button>
          <button class="lms-filter-btn" data-filter="in_progress" style="background: transparent; color: #8b949e; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; font-size: 0.8125rem; font-weight: 500; cursor: pointer; transition: all 0.2s;">{{ 'In Progress'|t }}</button>
          <button class="lms-filter-btn" data-filter="completed" style="background: transparent; color: #8b949e; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; font-size: 0.8125rem; font-weight: 500; cursor: pointer; transition: all 0.2s;">{{ 'Completed'|t }}</button>
        </div>
      </div>

      <div class="grid-courses" id="course-grid">
        {% for item in recent_courses %}
          <div class="course-item card-lms card-lms--course" data-status="{{ item.status }}" style="display: flex; flex-direction: column; height: 100%; transition: opacity 0.3s ease;">
            {% if item.thumbnail_url %}
              <div class="card-lms__image">
                {% if item.category %}
                  <span class="card-lms__category">{{ item.category }}</span>
                {% endif %}
                <img src="{{ item.thumbnail_url }}" alt="{{ item.course.label }}" loading="lazy">
              </div>
            {% else %}
              <div class="card-lms__image card-lms__image--placeholder">
                {% if item.category %}
                  <span class="card-lms__category">{{ item.category }}</span>
                {% endif %}
                <i class="fas fa-graduation-cap"></i>
              </div>
            {% endif %}

            <div class="card-lms__body" style="flex: 1; display: flex; flex-direction: column;">
              <h3 class="card-lms__title" style="margin-bottom: 1rem;">
                <a href="{{ item.url }}" style="color: #e6edf3; text-decoration: none; transition: color 0.15s ease;" onmouseover="this.style.color='#667eea'" onmouseout="this.style.color='#e6edf3'">{{ item.course.label }}</a>
              </h3>
              
              <div style="margin-top: auto; margin-bottom: 1rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                  <span style="font-size: 0.8125rem; color: #8b949e; font-weight: 500;">
                    {% if item.status == 'completed' %}
                      <span style="color: #43e97b;"><i class="fas fa-check-circle"></i> {{ 'Completed'|t }}</span>
                    {% else %}
                      {{ 'Progress'|t }}
                    {% endif %}
                  </span>
                  <span style="font-size: 0.8125rem; color: #e6edf3; font-weight: 600;">{{ item.progress|number_format(0) }}%</span>
                </div>
                <div class="lms-progress-bar" style="background: rgba(102, 126, 234, 0.15); height: 8px; border-radius: 1rem; overflow: hidden; margin: 0;">
                  <div class="lms-progress-bar__fill" style="width: {{ item.progress }}%; height: 100%; {% if item.status == 'completed' %}background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);{% else %}background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);{% endif %} border-radius: 1rem; transition: width 0.3s ease;"></div>
                </div>
              </div>

              <a href="{{ item.url }}" class="btn-lms-primary btn-lms-sm" style="border-radius: 2rem; width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; {% if item.status == 'completed' %}background: rgba(255,255,255,0.05); color: #8b949e; border: 1px solid rgba(255,255,255,0.1);{% endif %}">
                {% if item.status == 'completed' %}
                  {{ 'Review Course'|t }} <i class="fas fa-redo" style="font-size: 0.85em;"></i>
                {% else %}
                  {{ 'Continue Learning'|t }} <i class="fas fa-play" style="font-size: 0.85em;"></i>
                {% endif %}
              </a>
            </div>
          </div>
        {% endfor %}
      </div>

      <script>
        document.addEventListener('DOMContentLoaded', function() {
          const filterBtns = document.querySelectorAll('.lms-filter-btn');
          const courseItems = document.querySelectorAll('.course-item');

          filterBtns.forEach(btn => {
            btn.addEventListener('click', function() {
              filterBtns.forEach(b => {
                b.classList.remove('active');
                b.style.background = 'transparent';
                b.style.color = '#8b949e';
                b.style.fontWeight = '500';
              });
              
              this.classList.add('active');
              this.style.background = '#667eea';
              this.style.color = '#fff';
              this.style.fontWeight = '600';

              const filterValue = this.getAttribute('data-filter');

              courseItems.forEach(item => {
                item.style.opacity = '0';
                setTimeout(() => {
                  if (filterValue === 'all' || item.getAttribute('data-status') === filterValue) {
                    item.style.display = 'flex';
                    setTimeout(() => item.style.opacity = '1', 50);
                  } else {
                    item.style.display = 'none';
                  }
                }, 300);
              });
            });
          });
        });
      </script>
    {% else %}
      <div class="lms-empty-state">
        <i class="fas fa-graduation-cap"></i>
        <h3>{{ "You haven't enrolled in any courses yet"|t }}</h3>
        <a href="{{ path('lms_course.catalog') }}" class="lms-btn lms-btn--primary">
          {{ 'Browse Courses'|t }}
        </a>
      </div>
    {% endif %}
  </div>
</section>
