{#
/**
 * @file
 * Template for the Notification Bell block.
 *
 * Available variables:
 * - unread_count: The number of unread notifications.
 * - notifications_url: URL to the notifications listing page.
 */
#}
{{ attach_library('lms_notification/bell') }}
<style>
  .lms-bell-icon-wrapper {
    position: relative;
    display: inline-block;
    cursor: pointer;
  }

  .lms-bell-icon-wrapper .lms-bell-link {
    color: #e6edf3;
    text-decoration: none;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    transition: all 0.2s ease;
  }
  .lms-bell-icon-wrapper .lms-bell-link:hover {
    background: rgba(255,255,255,0.05);
    color: #e6edf3;
  }

  .lms-bell-icon-wrapper .lms-bell-counter {
    position: absolute;
    top: -8px;
    right: -12px;
    background: linear-gradient(135deg, #0077b6 0%, #0096c7 100%);
    color: white;
    border-radius: 999px;
    padding: 0.15rem 0.4rem;
    font-size: 0.65rem;
    min-width: 18px;
    min-height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    box-shadow: 0 8px 18px rgba(0, 119, 182, 0.24);
    line-height: 1;
  }
</style>
<div class="lms-bell-icon-wrapper" title="{{ 'Notifications'|t }}">
  <a href="{{ notifications_url }}" class="lms-bell-link">
    <i class="far fa-bell"></i>
  </a>
  <span class="lms-bell-counter" style="display: {{ unread_count > 0 ? 'flex' : 'none' }};">
    {{ unread_count > 99 ? '99+' : unread_count }}
  </span>

  {# The Hover Dropdown #}
  <div class="lms-bell-dropdown">
    <div class="lms-bell-dropdown__header">
      <span>{{ 'Recent Notifications'|t }}</span>
      {% if unread_count > 0 %}
        <span style="font-size: 0.75rem; color: #ef4444;">{{ unread_count }} {{ 'New'|t }}</span>
      {% endif %}
    </div>
    
    <div class="lms-bell-dropdown__body">
      {% if latest_notifications|length > 0 %}
        {% set type_icons = {
          'enrollment': 'fa-user-plus',
          'quiz_result': 'fa-clipboard-check',
          'certificate': 'fa-certificate',
          'payment': 'fa-credit-card',
          'forum_reply': 'fa-comment',
          'system': 'fa-bell',
          'announcement': 'fa-bullhorn',
          'reminder': 'fa-clock',
        } %}

        {% for notif in latest_notifications %}
          {% set item_url = notif.link ?: notifications_url %}
          <a href="{{ item_url }}" class="lms-bell-dropdown-item {{ not notif.read ? 'lms-bell-dropdown-item--unread' }}">
            <div class="lms-bell-dropdown-item__icon">
              <i class="fas {{ type_icons[notif.type] ?? 'fa-bell' }}"></i>
            </div>
            <div class="lms-bell-dropdown-item__content">
              <h4>{{ notif.title }}</h4>
              {% if notif.message %}
                <p>{{ notif.message|striptags }}</p>
              {% endif %}
              <div class="lms-bell-dropdown-item__time">{{ notif.created|date('M d - H:i') }}</div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        <div style="padding: 2rem; text-align: center; color: #94a3b8;">
          <i class="fas fa-check-circle" style="font-size: 2rem; margin-bottom: 0.5rem; color: #475569;"></i>
          <div>{{ "You're all caught up!"|t }}</div>
        </div>
      {% endif %}
    </div>
    
    <div class="lms-bell-dropdown__footer">
      <a href="{{ notifications_url }}">{{ 'View all notifications'|t }} <i class="fas fa-arrow-right" style="font-size: 0.8rem; margin-left: 0.25rem;"></i></a>
    </div>
  </div>
</div>
