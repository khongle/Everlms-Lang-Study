{{ attach_library('lms_theme/global') }}
{{ attach_library('lms_flashcard/flashcard_admin') }}

<div class="lms-admin lms-flashcard-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: 'flashcards' } %}

  <main class="lms-admin__main">
    <header class="lms-admin__header lms-flashcard-admin__header">
      <div>
        <span class="lms-flashcard-admin__eyebrow">{{ 'Learning content'|t }}</span>
        <h1 class="lms-admin__title">{{ 'Flashcard Management'|t }}</h1>
        <p class="lms-admin__subtitle">{{ 'Manage every public and private flashcard deck created by users.'|t }}</p>
      </div>
      <div class="lms-flashcard-admin__header-actions">
        <a href="{{ import_url }}" class="btn-lms-outline"><i class="fas fa-file-import"></i> {{ 'Import'|t }}</a>
        <a href="{{ add_url }}" class="btn-lms-primary"><i class="fas fa-plus"></i> {{ 'Create Deck'|t }}</a>
      </div>
    </header>

    <section class="lms-flashcard-admin__stats" aria-label="{{ 'Flashcard statistics'|t }}">
      <article class="lms-flashcard-admin__stat"><i class="fas fa-layer-group"></i><div><strong>{{ stats.decks }}</strong><span>{{ 'Total decks'|t }}</span></div></article>
      <article class="lms-flashcard-admin__stat"><i class="fas fa-clone"></i><div><strong>{{ stats.cards }}</strong><span>{{ 'Total cards'|t }}</span></div></article>
      <article class="lms-flashcard-admin__stat"><i class="fas fa-users"></i><div><strong>{{ stats.owners }}</strong><span>{{ 'Deck owners'|t }}</span></div></article>
      <article class="lms-flashcard-admin__stat"><i class="fas fa-eye"></i><div><strong>{{ stats.published }}</strong><span>{{ 'Published'|t }}</span></div></article>
    </section>

    <form method="get" action="{{ path('lms_flashcard.admin_decks') }}" class="lms-admin-filter lms-flashcard-admin__filters">
      <div class="lms-admin-filter__group lms-flashcard-admin__search">
        <label class="lms-admin-filter__label" for="flashcard-search">{{ 'Search deck'|t }}</label>
        <div class="lms-flashcard-admin__search-control">
          <i class="fas fa-search"></i>
          <input id="flashcard-search" type="search" name="search" value="{{ filters.search }}" class="lms-admin-filter__input" placeholder="{{ 'Deck name...'|t }}">
        </div>
      </div>
      <div class="lms-admin-filter__group">
        <label class="lms-admin-filter__label" for="flashcard-owner">{{ 'Owner'|t }}</label>
        <select id="flashcard-owner" name="owner" class="lms-admin-filter__select">
          <option value="0">{{ 'All users'|t }}</option>
          {% for id, name in owner_options %}
            <option value="{{ id }}" {{ filters.owner == id ? 'selected' : '' }}>{{ name }} (#{{ id }})</option>
          {% endfor %}
        </select>
      </div>
      <div class="lms-admin-filter__group">
        <label class="lms-admin-filter__label" for="flashcard-status">{{ 'Status'|t }}</label>
        <select id="flashcard-status" name="status" class="lms-admin-filter__select">
          <option value="all" {{ filters.status == 'all' ? 'selected' : '' }}>{{ 'All statuses'|t }}</option>
          <option value="published" {{ filters.status == 'published' ? 'selected' : '' }}>{{ 'Published'|t }}</option>
          <option value="draft" {{ filters.status == 'draft' ? 'selected' : '' }}>{{ 'Draft'|t }}</option>
        </select>
      </div>
      <button type="submit" class="btn-lms-primary lms-flashcard-admin__filter-button">{{ 'Filter'|t }}</button>
      <a href="{{ path('lms_flashcard.admin_decks') }}" class="btn-lms-outline lms-flashcard-admin__filter-button">{{ 'Reset'|t }}</a>
    </form>

    <section class="lms-admin-card lms-flashcard-admin__table-card">
      <div class="lms-table-responsive">
        <table class="lms-table lms-flashcard-admin__table">
          <thead>
            <tr>
              <th>{{ 'Deck'|t }}</th>
              <th>{{ 'Owner'|t }}</th>
              <th>{{ 'Topic'|t }}</th>
              <th>{{ 'Cards'|t }}</th>
              <th>{{ 'Status'|t }}</th>
              <th>{{ 'Updated'|t }}</th>
              <th class="lms-flashcard-admin__actions-heading">{{ 'Actions'|t }}</th>
            </tr>
          </thead>
          <tbody>
            {% for deck in decks %}
              <tr>
                <td><a href="{{ deck.edit_url }}" class="lms-flashcard-admin__deck-name">{{ deck.name }}</a><span class="lms-flashcard-admin__machine-name">{{ deck.machine_name }}</span></td>
                <td><span class="lms-flashcard-admin__owner">{{ deck.owner_name }}</span><small>#{{ deck.owner_id }}</small></td>
                <td>{{ deck.topic }}</td>
                <td><span class="lms-flashcard-admin__count">{{ deck.card_count }}</span></td>
                <td><span class="lms-status lms-status--{{ deck.status }}">{{ deck.status == 'published' ? 'Published'|t : 'Draft'|t }}</span></td>
                <td>{{ deck.changed }}</td>
                <td>
                  <div class="lms-admin-actions">
                    <a href="{{ deck.study_url }}" class="lms-admin-action-link" title="{{ 'Study deck'|t }}" aria-label="{{ 'Study deck'|t }}"><i class="fas fa-play"></i></a>
                    <a href="{{ deck.edit_url }}" class="lms-admin-action-link" title="{{ 'Edit deck and cards'|t }}" aria-label="{{ 'Edit deck and cards'|t }}"><i class="fas fa-edit"></i></a>
                    <a href="{{ deck.delete_url }}" class="lms-admin-action-link lms-admin-action-link--danger" title="{{ 'Delete deck'|t }}" aria-label="{{ 'Delete deck'|t }}"><i class="fas fa-trash"></i></a>
                  </div>
                </td>
              </tr>
            {% else %}
              <tr><td colspan="7" class="lms-flashcard-admin__empty">{{ 'No flashcard decks match these filters.'|t }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <footer class="lms-admin-footer">
        <span>{{ decks|length }} {{ 'decks on this page'|t }}</span>
        {{ pager }}
      </footer>
    </section>
  </main>
</div>
