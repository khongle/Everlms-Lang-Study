<?php

/**
 * @file
 * Primary module hooks for LMS Wishlist module.
 */

/**
 * Implements hook_theme().
 */
function lms_wishlist_theme($existing, $type, $theme, $path) {
  return [
    'lms_my_wishlist' => [
      'variables' => [
        'cards' => NULL,
      ],
      'template' => 'lms-my-wishlist',
    ],
  ];
}
