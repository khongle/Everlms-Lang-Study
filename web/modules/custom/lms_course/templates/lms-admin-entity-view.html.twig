{# Admin Entity View Wrapper #}
{{ attach_library('lms_theme/global') }}

<div class="lms-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: active_menu } %}

  <div class="lms-admin__main">
    <div class="lms-admin__header">
      <h1 class="lms-admin__title">{{ title }}</h1>
      <div class="lms-admin-header__actions">
        <a href="javascript:history.back()" class="btn-lms-secondary"><i class="fas fa-arrow-left"></i> {{ 'Back'|t }}</a>
      </div>
    </div>

    <div class="lms-admin-card lms-admin-form-card">
      <style>
        /* HIDE GLOBAL NAVBAR IN WORKSPACE TO SAVE VERTICAL SPACE */
        .lms-navbar {
           display: none !important;
        }

        .lms-admin-entity-view-wrapper {
          background: #ffffff; /* Clean white */
          border-radius: 0.5rem;
          padding: 1.5rem;
          color: #334155;
          box-shadow: 0 4px 15px rgba(0,0,0,0.05); /* Soft premium shadow */
          display: flex;
          flex-direction: column;
          gap: 2rem;
        }

        .lms-premium-image-wrapper {
            width: 100%;
            max-height: 400px;
            overflow: hidden;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            background: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .lms-premium-image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .lms-premium-field {
            background: #f8fafc;
            padding: 1.5rem;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
        }

        .lms-premium-label {
            font-size: 15px;
            text-transform: none;
            font-weight: 700;
            color: #64748b;
            letter-spacing: normal;
            margin-bottom: 0.75rem;
            border-bottom: 1px solid #cbd5e1;
            padding-bottom: 0.5rem;
        }

        .lms-premium-value {
            font-size: 15px;
            color: #1e293b;
            line-height: 1.6;
        }
      </style>
      
      <div class="lms-admin-entity-view-wrapper">
        {% if content.image_url %}
        <div class="lms-premium-image-wrapper">
          <img src="{{ content.image_url }}" alt="Cover Image">
        </div>
        {% endif %}

        {% if content.fields %}
          {% for field in content.fields %}
            <div class="lms-premium-field">
              <div class="lms-premium-label">{{ field.label }}</div>
              <div class="lms-premium-value">{{ field.content }}</div>
            </div>
          {% endfor %}
        {% else %}
          <div style="color: #64748b; font-style: italic;">No fields configured or accessible for preview.</div>
        {% endif %}
      </div>

    </div>
  </div>
</div>
