<form id="lms-bulk-users-form" method="post" action="{{ url('lms_course.admin.users.bulk') }}">
  <div class="lms-table-responsive">
    <table class="lms-table lms-users-table">
      <thead><tr>
        <th scope="col" class="lms-table__select"><input type="checkbox" id="bulk-select-all" aria-label="{{ 'Select all users on this page'|t }}"></th>
        <th scope="col">{{ 'User'|t }}</th><th scope="col">{{ 'Email'|t }}</th><th scope="col">{{ 'Role'|t }}</th><th scope="col">{{ 'Courses Enrolled'|t }}</th><th scope="col">{{ 'Last Login'|t }}</th><th scope="col">{{ 'Status'|t }}</th><th scope="col" class="lms-table__actions">{{ 'Actions'|t }}</th>
      </tr></thead>
      <tbody>
        {% for user in users %}
          <tr>
            <td class="lms-table__select"><input type="checkbox" name="users[]" value="{{ user.uid }}" class="bulk-user-checkbox" aria-label="{{ 'Select @name'|t({'@name': user.name}) }}"></td>
            <td><div class="lms-admin-person">{% if user.avatar_url %}<img src="{{ user.avatar_url }}" alt="">{% else %}<span class="lms-admin-person__avatar" aria-hidden="true">{{ user.name|first|upper }}</span>{% endif %}<span class="lms-table__primary">{{ user.name }}</span></div></td>
            <td>{{ user.email }}</td>
            <td><span class="lms-status lms-role--{{ user.role|lower }}">{{ user.role }}</span></td>
            <td class="lms-table__numeric">{{ user.enrolled }}</td><td>{{ user.last_login ? user.last_login|date('M d, Y') : 'Never'|t }}</td>
            <td><span class="lms-status {{ user.status == 'Active' ? 'lms-status--active' : 'lms-status--inactive' }}">{{ user.status }}</span></td>
            <td class="lms-table__actions"><div class="lms-admin-actions">
              {% if user.switch_url %}<a href="{{ user.switch_url }}" class="lms-admin-action-link" title="{{ 'Impersonate User'|t }}" aria-label="{{ 'Impersonate User'|t }}"><i class="fas fa-user-secret" aria-hidden="true"></i></a>{% endif %}
              <a href="{{ user.edit_url }}" class="lms-admin-action-link" title="{{ 'Edit User'|t }}" aria-label="{{ 'Edit User'|t }}"><i class="fas fa-edit" aria-hidden="true"></i></a>
              <a href="{{ user.view_url }}" class="lms-admin-action-link" title="{{ 'View Profile'|t }}" aria-label="{{ 'View Profile'|t }}"><i class="fas fa-eye" aria-hidden="true"></i></a>
            </div></td>
          </tr>
        {% else %}<tr><td colspan="8" class="lms-table__empty">{{ 'No users match your filters.'|t }}</td></tr>{% endfor %}
      </tbody>
    </table>
  </div>
  <div class="lms-admin-footer">
    <div class="lms-admin-bulk-actions">
      <strong>{{ 'Bulk actions'|t }}</strong><span id="bulk-selected-count" aria-live="polite">{{ '0 selected users'|t }}</span>
      <button type="submit" name="action" value="activate" class="btn-lms-primary">{{ 'Activate'|t }}</button>
      <button type="submit" name="action" value="deactivate" class="btn-lms-secondary lms-button--danger">{{ 'Deactivate'|t }}</button>
      <button type="submit" name="action" value="export" class="btn-lms-secondary">{{ 'Export'|t }}</button>
    </div>
    <div class="lms-admin-footer__summary"><span>{{ users|length }} {{ 'users on this page'|t }}</span><div class="lms-pagination-container">{{ pager }}</div></div>
  </div>
</form>
