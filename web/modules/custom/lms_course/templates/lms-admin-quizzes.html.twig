{{ attach_library('lms_theme/global') }}
<div class="lms-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: 'quizzes' } %}
  <div class="lms-admin__main">
    <div class="lms-admin__header">
      <div><h1 class="lms-admin__title">{{ 'Quiz Management'|t }}</h1><p class="lms-admin__subtitle">{{ 'Manage questions, time limits and passing scores.'|t }}</p></div>
      <div class="lms-admin-header__actions"><a href="{{ add_quiz_url }}" class="btn-lms-primary"><i class="fas fa-plus" aria-hidden="true"></i> {{ 'Create New Quiz'|t }}</a></div>
    </div>
    <form method="get" action="{{ path('lms_course.admin_quizzes') }}" class="lms-admin-filter">
      <div class="lms-admin-filter__group"><label for="quiz-search" class="lms-admin-filter__label">{{ 'Search quizzes'|t }}</label><input id="quiz-search" type="search" name="search" value="{{ filters.search }}" class="lms-admin-filter__input" placeholder="{{ 'Quiz title'|t }}"></div>
      <div class="lms-admin-filter__group"><label for="quiz-course" class="lms-admin-filter__label">{{ 'Linked course'|t }}</label><select id="quiz-course" name="course" class="lms-admin-filter__select"><option value="all">{{ 'All courses'|t }}</option>{% for id, label in course_options %}<option value="{{ id }}" {% if filters.course == id %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>
      <div class="lms-admin-filter__group"><label for="quiz-status" class="lms-admin-filter__label">{{ 'Status'|t }}</label><select id="quiz-status" name="status" class="lms-admin-filter__select">{% for value, label in {'all': 'All statuses', 'active': 'Active', 'draft': 'Draft'} %}<option value="{{ value }}" {% if filters.status == value %}selected{% endif %}>{{ label|t }}</option>{% endfor %}</select></div>
      <div class="lms-admin-filter__actions"><button type="submit" class="btn-lms-primary"><i class="fas fa-filter" aria-hidden="true"></i> {{ 'Apply filters'|t }}</button><a href="{{ path('lms_course.admin_quizzes') }}" class="btn-lms-secondary"><i class="fas fa-undo" aria-hidden="true"></i> {{ 'Reset'|t }}</a></div>
    </form>
    <div class="lms-admin-card">
      <div class="lms-table-responsive">
        <table class="lms-table lms-quizzes-table">
          <thead><tr><th scope="col">{{ 'Quiz Title'|t }}</th><th scope="col">{{ 'Linked Course'|t }}</th><th scope="col">{{ 'Questions'|t }}</th><th scope="col">{{ 'Time Limit'|t }}</th><th scope="col">{{ 'Pass Score'|t }}</th><th scope="col">{{ 'Max Attempts'|t }}</th><th scope="col">{{ 'Status'|t }}</th><th scope="col" class="lms-table__actions">{{ 'Actions'|t }}</th></tr></thead>
          <tbody>{% for quiz in quizzes %}<tr>
            <td class="lms-table__primary">{{ quiz.name }}</td><td>{{ quiz.course }}</td><td class="lms-table__numeric">{{ quiz.question_count }}</td><td>{{ quiz.time_limit > 0 ? quiz.time_limit ~ ' min' : 'Unlimited'|t }}</td><td class="lms-table__numeric">{{ quiz.pass_score }}%</td><td>{{ quiz.attempts > 0 ? quiz.attempts : 'Unlimited'|t }}</td><td><span class="lms-status {{ quiz.status == 'Active' ? 'lms-status--active' : 'lms-status--draft' }}">{{ quiz.status }}</span></td>
            <td class="lms-table__actions"><div class="lms-admin-actions"><a href="{{ quiz.edit_url }}" class="lms-admin-action-link" title="{{ 'Edit quiz'|t }}" aria-label="{{ 'Edit quiz'|t }}"><i class="fas fa-edit" aria-hidden="true"></i></a></div></td>
          </tr>{% else %}<tr><td colspan="8" class="lms-table__empty">{{ 'No quizzes match your filters.'|t }}</td></tr>{% endfor %}</tbody>
        </table>
      </div>
      <div class="lms-admin-footer"><span>{{ quick_stats.total_quizzes }} {{ 'quizzes on this page'|t }} · {{ quick_stats.active_quizzes }} {{ 'active'|t }} · {{ quick_stats.bank_questions }} {{ 'linked questions'|t }}</span>{{ pager }}</div>
    </div>
  </div>
</div>
