{{ attach_library('lms_theme/global') }}
<div class="lms-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: active_menu } %}
  <div class="lms-admin__main">
    <div class="lms-admin__header">
      <div><h1 class="lms-admin__title">{{ content_type_label }}</h1><p class="lms-admin__subtitle">{{ 'Review, organize and publish learning content.'|t }}</p></div>
      <div class="lms-admin-header__actions"><a href="{{ add_content_url }}" class="btn-lms-primary"><i class="fas fa-plus" aria-hidden="true"></i> {{ 'Add New'|t }}</a></div>
    </div>
    <form method="get" action="{{ path('<current>') }}" id="lms-admin-filter-form" class="lms-admin-filter">
      <div class="lms-admin-filter__group">
        <label for="content-search" class="lms-admin-filter__label">{{ 'Search content'|t }}</label>
        <input id="content-search" type="search" name="search" value="{{ filters.search }}" class="lms-admin-filter__input" placeholder="{{ 'Content title'|t }}">
      </div>
      {% if (supports_publishing ?? true) %}
      <div class="lms-admin-filter__group">
        <label for="content-status" class="lms-admin-filter__label">{{ 'Status'|t }}</label>
        <select id="content-status" name="status" class="lms-admin-filter__select">
          {% for value, label in {'all': 'All statuses', 'published': 'Published', 'unpublished': 'Unpublished'} %}
            <option value="{{ value }}" {% if filters.status == value %}selected{% endif %}>{{ label|t }}</option>
          {% endfor %}
        </select>
      </div>
      {% endif %}
      <div class="lms-admin-filter__actions">
        <button type="submit" class="btn-lms-primary"><i class="fas fa-filter" aria-hidden="true"></i> {{ 'Apply filters'|t }}</button>
        <button type="button" id="lms-filter-reset-btn" class="btn-lms-secondary"><i class="fas fa-undo" aria-hidden="true"></i> {{ 'Reset'|t }}</button>
      </div>
    </form>
    <div class="lms-admin-card" id="lms-table-container">
      {% include '@lms_course/lms-admin-content-table.html.twig' %}
    </div>
  </div>
</div>

<div id="lms-toast" class="lms-toast" style="display:none;">
    <div class="lms-toast-icon"><i class="fas fa-check-circle"></i></div>
    <div class="lms-toast-message">Success</div>
</div>

<style>
.lms-toast {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: rgba(30,34,45, 0.95);
    border: 1px solid rgba(255,255,255,0.1);
    border-left: 4px solid #10b981;
    color: white;
    padding: 1rem 1.5rem;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    box-shadow: 0 10px 15px -3px rgba(0,0,0,0.5);
    z-index: 9999;
    transform: translateY(20px);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
.lms-toast.show {
    transform: translateY(0);
    opacity: 1;
}
.lms-toast.error {
    border-left-color: #ef4444;
}
.lms-toast.error .lms-toast-icon i {
    color: #ef4444;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('lms-admin-filter-form');
  const container = document.getElementById('lms-table-container');
  const resetBtn = document.getElementById('lms-filter-reset-btn');

  function fetchResults(url) {
    container.style.opacity = '0.5';
    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(r => r.text())
      .then(html => {
        container.innerHTML = html;
        container.style.opacity = '1';
      })
      .catch(e => {
        container.style.opacity = '1';
        console.error(e);
      });
  }

  function applyFilters() {
    const url = new URL(form.action, window.location.origin);
    for (const [key, value] of new FormData(form)) { url.searchParams.set(key, value); }
    window.history.pushState({}, '', url.toString());
    url.searchParams.set('ajax', '1');
    fetchResults(url.toString());
  }

  form.addEventListener('change', function(e) {
    if (e.target.tagName === 'SELECT') applyFilters();
  });
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    applyFilters();
  });

  let debounceTimer;
  form.querySelector('input[name="search"]').addEventListener('input', function(e) {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      applyFilters();
    }, 400);
  });

  resetBtn.addEventListener('click', function() {
    form.querySelector('input[name="search"]').value = '';
    const statusSelect = form.querySelector('select[name="status"]');
    if (statusSelect) statusSelect.value = 'all';
    const url = new URL(window.location.href);
    url.searchParams.delete('search');
    url.searchParams.delete('status');
    url.searchParams.delete('page');
    url.searchParams.set('ajax', '1');
    fetchResults(url.toString());
    url.searchParams.delete('ajax');
    window.history.pushState({}, '', url.toString());
  });

  container.addEventListener('click', function(e) {
    if (e.target.closest('.pager__item a')) {
      e.preventDefault();
      const a = e.target.closest('.pager__item a');
      const url = new URL(a.href);
      url.searchParams.set('ajax', '1');
      fetchResults(url.toString());
      url.searchParams.delete('ajax');
      window.history.pushState({}, '', url.toString());
    }
  });

  // Bulk Master Checkbox
  container.addEventListener('change', function(e) {
    if(e.target.id === 'lms-check-all') {
      const checkboxes = container.querySelectorAll('.lms-row-check');
      checkboxes.forEach(cb => cb.checked = e.target.checked);
    } else if (e.target.classList.contains('lms-row-check')) {
      const allCb = container.querySelectorAll('.lms-row-check');
      const checkedCb = container.querySelectorAll('.lms-row-check:checked');
      document.getElementById('lms-check-all').checked = (allCb.length === checkedCb.length);
    }
  });

  window.lmsBulkAction = function(action) {
    const checked = document.querySelectorAll('.lms-row-check:checked');
    if (checked.length === 0) {
      showToast('Please select at least one item.', true);
      return;
    }
    const ids = Array.from(checked).map(cb => cb.value);
    
    fetch('/workspace/content/bulk', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify({ action: action, ids: ids })
    })
    .then(r => {
      if (!r.ok) {
        throw new Error('HTTP error ' + r.status);
      }
      return r.json();
    })
    .then(data => {
      if (data && data.success) {
        showToast(data.message);
        
        // Reload the table maintaining current filters
        const url = new URL(window.location.href);
        const formData = new FormData(document.getElementById('lms-admin-filter-form'));
        for(let [key, val] of formData.entries()) { url.searchParams.set(key, val); }
        url.searchParams.set('ajax', '1');
        
        const container = document.getElementById('lms-table-container');
        container.style.opacity = '0.5';
        fetch(url.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
          .then(res => res.text())
          .then(html => {
            container.innerHTML = html;
            container.style.opacity = '1';
          });
          
      } else {
        showToast(data ? data.message : 'Error executing action', true);
      }
    })
    .catch(err => {
      console.error(err);
      showToast('Network error or server failed.', true);
    });
  }

  function showToast(message, isError = false) {
    const t = document.getElementById('lms-toast');
    t.querySelector('.lms-toast-message').textContent = message;
    if(isError) {
      t.classList.add('error');
      t.querySelector('i').className = 'fas fa-exclamation-circle';
    } else {
      t.classList.remove('error');
      t.querySelector('i').className = 'fas fa-check-circle';
    }
    t.style.display = 'flex';
    setTimeout(() => t.classList.add('show'), 10);
    setTimeout(() => {
      t.classList.remove('show');
      setTimeout(() => t.style.display = 'none', 300);
    }, 4000);
  }
});
</script>
