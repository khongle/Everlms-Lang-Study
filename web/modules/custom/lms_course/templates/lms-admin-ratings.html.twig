{# Admin Ratings Manager #}
{{ attach_library('lms_theme/global') }}

<div class="lms-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: active } %}

  <div class="lms-admin__main">
    <div class="lms-admin__header">
      <h1 class="lms-admin__title" style="margin-bottom: 0;">{{ 'Student Feedback & Ratings'|t }}</h1>
      <div style="display: flex; gap: 1rem; align-items: center;">
        <span class="lms-admin__subtitle">{{ ratings|length }} Reviews Found</span>
      </div>
    </div>

    <div class="lms-admin-card" style="margin-bottom: 0; display: flex; flex-direction: column;">
      <div class="lms-table-responsive" style="min-height: 400px;">
        <table class="lms-table">
          <thead>
            <tr>
              <th style="width: 5%">ID</th>
              <th style="width: 20%">Course</th>
              <th style="width: 15%">Student</th>
              <th style="width: 10%">Rating</th>
              <th style="width: 30%">Review</th>
              <th style="width: 10%">Status</th>
              <th style="width: 10%">Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for row in ratings %}
              <tr>
                <td>#{{ row.id }}</td>
                <td><strong style="color: #fff;">{{ row.course }}</strong><br><span style="font-size: 0.8rem; color: #64748b;">{{ row.created|date('M d, Y') }}</span></td>
                <td>
                  <div style="display: flex; align-items: center; gap: 0.5rem;">
                    {% if row.avatar %}
                      <img src="{{ row.avatar }}" alt="" style="width: 24px; height: 24px; border-radius: 50%;">
                    {% endif %}
                    <span>{{ row.student }}</span>
                  </div>
                </td>
                <td>
                  <div style="color: #fbbf24; font-size: 0.8rem;">
                    {% for i in 1..row.score %}
                      <i class="fas fa-star"></i>
                    {% endfor %}
                    <span style="color: #fff; font-weight: bold; margin-left: 0.25rem;">{{ row.score|number_format(1) }}</span>
                  </div>
                </td>
                <td>
                  <div style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 0.85rem;" title="{{ row.review }}">
                    {{ row.review }}
                  </div>
                </td>
                <td>
                  <span class="lms-status {{ row.approved ? 'lms-status--published' : 'lms-status--pending' }}">
                    {{ row.approved ? 'Approved' : 'Pending' }}
                  </span>
                  {% if row.featured %}
                    <span class="lms-status" style="background: rgba(236,72,153,0.1); color: #ec4899; border-color: rgba(236,72,153,0.2); margin-top: 4px;">
                      <i class="fas fa-heart" style="margin-right: 4px;"></i> Featured
                    </span>
                  {% endif %}
                </td>
                <td>
                  <div style="display: flex; gap: 0.5rem;">
                    <a href="{{ path('lms_rating.admin_action', {'lms_rating': row.id, 'action': 'approve'}) }}" title="Toggle Approve" style="color: {{ row.approved ? '#10b981' : '#94a3b8' }}; padding: 0.5rem; background: rgba(255,255,255,0.05); border-radius: 0.375rem; transition: background 0.2s;">
                      <i class="fas fa-check-circle"></i>
                    </a>
                    <a href="{{ path('lms_rating.admin_action', {'lms_rating': row.id, 'action': 'feature'}) }}" title="Toggle Featured" style="color: {{ row.featured ? '#ec4899' : '#94a3b8' }}; padding: 0.5rem; background: rgba(255,255,255,0.05); border-radius: 0.375rem; transition: background 0.2s;">
                      <i class="fas fa-star"></i>
                    </a>
                  </div>
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="7" style="text-align: center; padding: 3rem; color: #64748b;">
                  <i class="fas fa-inbox" style="font-size: 2rem; margin-bottom: 1rem; display: block; opacity: 0.5;"></i>
                  {{ 'No ratings found.'|t }}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      
      {% if pager %}
        <div class="lms-admin-footer">
          {{ pager }}
        </div>
      {% endif %}
    </div>

  </div>
</div>
