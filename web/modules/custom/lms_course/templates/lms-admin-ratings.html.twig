{{ attach_library('lms_theme/global') }}
<div class="lms-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: active } %}
  <div class="lms-admin__main">
    <div class="lms-admin__header"><div><h1 class="lms-admin__title">{{ 'Student Feedback & Ratings'|t }}</h1><p class="lms-admin__subtitle">{{ 'Read reviews and manage approval and featured feedback.'|t }}</p></div></div>
    <form method="get" action="{{ path('lms_rating.admin_list') }}" class="lms-admin-filter">
      <div class="lms-admin-filter__group"><label for="rating-search" class="lms-admin-filter__label">{{ 'Search review text'|t }}</label><input id="rating-search" type="search" name="search" value="{{ filters.search }}" class="lms-admin-filter__input" placeholder="{{ 'Words in the review'|t }}"></div>
      <div class="lms-admin-filter__group"><label for="rating-status" class="lms-admin-filter__label">{{ 'Approval status'|t }}</label><select id="rating-status" name="status" class="lms-admin-filter__select">{% for value, label in {'all': 'All statuses', 'approved': 'Approved', 'pending': 'Pending'} %}<option value="{{ value }}" {% if filters.status == value %}selected{% endif %}>{{ label|t }}</option>{% endfor %}</select></div>
      <div class="lms-admin-filter__group"><label for="rating-score" class="lms-admin-filter__label">{{ 'Rating'|t }}</label><select id="rating-score" name="score" class="lms-admin-filter__select"><option value="all">{{ 'All ratings'|t }}</option>{% for score in 1..5 %}<option value="{{ score }}" {% if filters.score == score %}selected{% endif %}>{{ score }} / 5</option>{% endfor %}</select></div>
      <div class="lms-admin-filter__actions"><button type="submit" class="btn-lms-primary"><i class="fas fa-filter" aria-hidden="true"></i> {{ 'Apply filters'|t }}</button><a href="{{ path('lms_rating.admin_list') }}" class="btn-lms-secondary"><i class="fas fa-undo" aria-hidden="true"></i> {{ 'Reset'|t }}</a></div>
    </form>
    <div class="lms-admin-card"><div class="lms-table-responsive"><table class="lms-table lms-ratings-table">
      <thead><tr><th scope="col">{{ 'ID'|t }}</th><th scope="col">{{ 'Course'|t }}</th><th scope="col">{{ 'Student'|t }}</th><th scope="col">{{ 'Rating'|t }}</th><th scope="col">{{ 'Review'|t }}</th><th scope="col">{{ 'Status'|t }}</th><th scope="col" class="lms-table__actions">{{ 'Actions'|t }}</th></tr></thead>
      <tbody>{% for row in ratings %}<tr>
        <td class="lms-table__numeric">#{{ row.id }}</td><td><div class="lms-table__primary">{{ row.course }}</div><div class="lms-table__muted">{{ row.created|date('M d, Y') }}</div></td>
        <td><div class="lms-admin-person">{% if row.avatar %}<img src="{{ row.avatar }}" alt="">{% endif %}<span>{{ row.student }}</span></div></td>
        <td class="lms-table__numeric"><span class="lms-rating-score"><i class="fas fa-star" aria-hidden="true"></i> {{ row.score|number_format(1) }} / 5</span></td>
        <td class="lms-table__review">{{ row.review }}</td>
        <td><div class="lms-admin-statuses"><span class="lms-status {{ row.approved ? 'lms-status--published' : 'lms-status--pending' }}">{{ row.approved ? 'Approved'|t : 'Pending'|t }}</span>{% if row.featured %}<span class="lms-status lms-status--featured"><i class="fas fa-star" aria-hidden="true"></i> {{ 'Featured'|t }}</span>{% endif %}</div></td>
        <td class="lms-table__actions"><div class="lms-admin-actions">
          <a href="{{ path('lms_rating.admin_action', {'lms_rating': row.id, 'action': 'approve'}) }}" class="lms-admin-action-link" title="{{ row.approved ? 'Remove approval'|t : 'Approve review'|t }}" aria-label="{{ row.approved ? 'Remove approval'|t : 'Approve review'|t }}"><i class="fas fa-check-circle" aria-hidden="true"></i></a>
          <a href="{{ path('lms_rating.admin_action', {'lms_rating': row.id, 'action': 'feature'}) }}" class="lms-admin-action-link" title="{{ row.featured ? 'Remove featured status'|t : 'Feature review'|t }}" aria-label="{{ row.featured ? 'Remove featured status'|t : 'Feature review'|t }}"><i class="fas fa-star" aria-hidden="true"></i></a>
        </div></td>
      </tr>{% else %}<tr><td colspan="7" class="lms-table__empty">{{ 'No reviews match your filters.'|t }}</td></tr>{% endfor %}</tbody>
    </table></div><div class="lms-admin-footer"><span>{{ ratings|length }} {{ 'reviews on this page'|t }}</span>{{ pager }}</div></div>
  </div>
</div>
