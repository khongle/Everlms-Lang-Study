{# Course card partial — reusable across pages #}
{% set target_link = (card.is_enrolled and card.continue_url) ? card.continue_url : card.url %}
<div class="card-lms card-lms--course" data-category="{{ card.category_id }}" data-level="{{ card.level_id }}" data-price="{{ card.price_raw }}" data-rating="{{ card.rating|default(5.0) }}">
  {% if card.has_thumbnail %}
    <div class="card-lms__image">
      <div style="position: absolute; top: 0.5rem; left: 0.5rem; display: flex; flex-direction: column; gap: 0.5rem; z-index: 10; align-items: flex-start;">
        {% if card.category %}
          <span class="card-lms__category" style="position: static; margin: 0;">{{ card.category }}</span>
        {% endif %}
        {% if card.bestseller %}
          <span class="card-lms__badge" style="position: static; margin: 0; top: auto; left: auto;"><i class="fas fa-fire" style="margin-right: 4px; color: #fcd34d;"></i>Bestseller</span>
        {% endif %}
      </div>
      <a href="{{ target_link }}" style="display: block; color: inherit; text-decoration: none; height: 100%;">
        <img src="{{ card.thumbnail_url }}" alt="{{ card.name }}" loading="eager" decoding="async">
      </a>
      
      <button class="lms-wishlist-toggle lms-btn-icon" data-course-id="{{ card.id }}" style="position: absolute; top: 12px; right: 12px; z-index: 10; background: rgba(0,0,0,0.5); color: white; border: 1px solid rgba(255,255,255,0.2); border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; padding: 0;" aria-label="Toggle Wishlist">
        <i class="{{ card.is_wishlisted ? 'fas' : 'far' }} fa-heart" {% if card.is_wishlisted %}style="color: #ff7b72;"{% endif %}></i>
      </button>

      {% if card.price_raw == 0 %}
        <span class="card-lms__badge" style="position: absolute; bottom: 12px; left: 12px; top: auto; z-index: 10; background: linear-gradient(135deg, #10b981 0%, #059669 100%);">Free</span>
      {% endif %}
    </div>
  {% else %}
    <div class="card-lms__image card-lms__image--placeholder">
      <div style="position: absolute; top: 0.5rem; left: 0.5rem; display: flex; flex-direction: column; gap: 0.5rem; z-index: 10; align-items: flex-start;">
        {% if card.category %}
          <span class="card-lms__category" style="position: static; margin: 0;">{{ card.category }}</span>
        {% endif %}
        {% if card.bestseller %}
          <span class="card-lms__badge" style="position: static; margin: 0; top: auto; left: auto;"><i class="fas fa-fire" style="margin-right: 4px; color: #fcd34d;"></i>Bestseller</span>
        {% endif %}
      </div>
      <a href="{{ target_link }}" style="display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; color: inherit; text-decoration: none;">
        <i class="fas fa-graduation-cap"></i>
      </a>
      <button class="lms-wishlist-toggle lms-btn-icon" data-course-id="{{ card.id }}" style="position: absolute; top: 12px; right: 12px; z-index: 10; background: rgba(0,0,0,0.5); color: white; border: 1px solid rgba(255,255,255,0.2); border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; padding: 0;" aria-label="Toggle Wishlist">
        <i class="{{ card.is_wishlisted ? 'fas' : 'far' }} fa-heart" {% if card.is_wishlisted %}style="color: #ff7b72;"{% endif %}></i>
      </button>
      {% if card.price_raw == 0 %}
        <span class="card-lms__badge" style="position: absolute; bottom: 12px; left: 12px; top: auto; z-index: 10; background: linear-gradient(135deg, #10b981 0%, #059669 100%);">Free</span>
      {% endif %}
    </div>
  {% endif %}

  <div class="card-lms__body">
    <h3 class="card-lms__title">
      <a href="{{ card.url }}">{{ card.name }}</a>
    </h3>

    {% if card.instructor_name %}
      <div class="card-lms__instructor" style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
        {% if card.instructor_avatar %}
          <a href="{{ card.instructor_url|default('#') }}"><img src="{{ card.instructor_avatar }}" alt="{{ card.instructor_name }}" class="card-lms__instructor-avatar" style="width: 24px; height: 24px; border-radius: 50%; object-fit: cover;"></a>
        {% else %}
          <a href="{{ card.instructor_url|default('#') }}"><div class="card-lms__instructor-avatar-fallback" style="width: 24px; height: 24px; border-radius: 50%; background: #333; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #fff;">
            <i class="fas fa-user"></i>
          </div></a>
        {% endif %}
        <span class="card-lms__instructor-name" style="font-size: 0.85rem; color: #a1a1aa;"><a href="{{ card.instructor_url|default('#') }}" style="color: inherit; text-decoration: none;">{{ card.instructor_name }}</a></span>
      </div>
    {% endif %}

    {% if card.short_description %}
      <div class="card-lms__desc">
        <a href="{{ target_link }}" style="color: inherit; text-decoration: none;">
          {{ card.short_description|striptags }}
        </a>
      </div>
    {% endif %}

    <div class="card-lms__meta">
      {% if card.level %}
        <span class="card-lms__level"><i class="fas fa-signal"></i> {{ card.level }}</span>
      {% endif %}
      {% if card.duration %}
        <span class="card-lms__duration"><i class="fas fa-clock"></i> {{ card.duration }}</span>
      {% endif %}
      <span class="card-lms__rating" style="margin-left: auto; color: #fee140;">
        {% set rating_floor = card.rating|default(5.0)|round(0, 'floor') %}
        {% set has_half = (card.rating|default(5.0) - rating_floor) >= 0.5 %}
        {% set empty_stars = 5 - rating_floor - (has_half ? 1 : 0) %}
        
        {% if rating_floor > 0 %}
          {% for i in 1..rating_floor %}
            <i class="fas fa-star"></i>
          {% endfor %}
        {% endif %}
        
        {% if has_half %}
          <i class="fas fa-star-half-alt"></i>
        {% endif %}
        
        {% if empty_stars > 0 %}
          {% for i in 1..empty_stars %}
            <i class="far fa-star"></i>
          {% endfor %}
        {% endif %}
        <span style="color: #a1a1aa; margin-left: 4px;">{{ card.rating|default(5.0)|number_format(1) }}</span>
      </span>
    </div>

    <div class="card-lms__footer" style="display: flex; align-items: center; justify-content: space-between;">
      {% if card.is_enrolled %}
        <div style="display: flex; flex-direction: column; gap: 2px;">
           <span style="font-size: 0.7rem; color: #10b981; font-weight: 700; text-transform: uppercase; text-shadow: 0 0 10px rgba(16, 185, 129, 0.4);"><i class="fas fa-unlock"></i> Unlocked</span>
           {% if card.price_raw > 0 %}
             <span class="card-lms__price" style="font-size: 0.9rem; color: #a1a1aa; text-decoration: line-through;">{{ card.price }}</span>
           {% else %}
             <span class="card-lms__price" style="font-size: 0.9rem; color: #a1a1aa;">{{ card.price }}</span>
           {% endif %}
        </div>
        <a href="{{ card.continue_url }}" class="btn-lms-primary btn-lms-sm" style="background: linear-gradient(to right, #6366f1, #a855f7); border-radius: 2rem; box-shadow: 0 4px 15px rgba(168, 85, 247, 0.4); border: none; padding: 0.5rem 1.25rem;">
          {{ 'Continue Learning'|t }}
        </a>
      {% else %}
        <span class="card-lms__price {% if card.price_raw == 0 %}card-lms__price--free{% endif %}" style="font-size: 1.25rem;">
          {{ card.price }}
        </span>
        <a href="{{ card.url }}" class="btn-lms-outline btn-lms-sm" style="border-radius: 2rem; border-color: rgba(255,255,255,0.2); transition: all 0.3s; padding: 0.5rem 1.25rem;" onmouseover="this.style.background='linear-gradient(to right, #6366f1, #a855f7)'; this.style.borderColor='transparent';" onmouseout="this.style.background='transparent'; this.style.borderColor='rgba(255,255,255,0.2)';">
          {{ 'Enroll Now'|t }}
        </a>
      {% endif %}
    </div>
  </div>
</div>
