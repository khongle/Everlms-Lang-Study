{{ attach_library('lms_theme/global') }}
<div class="lms-admin lms-admin-orders-page">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: 'orders' } %}
  <div class="lms-admin__main">
    <div class="lms-admin__header"><div><h1 class="lms-admin__title">{{ 'Manage Orders'|t }}</h1><p class="lms-admin__subtitle">{{ 'Review payments, learners and order status.'|t }}</p></div></div>

    {# Filter Bar #}
    <form method="GET" class="lms-admin-filter" action="{{ path('<current>') }}">
      <div class="lms-admin-filter__group">
        <label for="order-search" class="lms-admin-filter__label">{{ 'Search Orders'|t }}</label>
        <input id="order-search" type="search" name="search" class="lms-admin-filter__input" placeholder="{{ 'Enter Order ID or Learner name...'|t }}" value="{{ filters.search }}">
      </div>
      <div class="lms-admin-filter__group">
        <label for="order-status" class="lms-admin-filter__label">{{ 'Status'|t }}</label>
        <select id="order-status" name="status" class="lms-admin-filter__select">
          <option value="all" {% if filters.status == 'all' %}selected{% endif %}>{{ 'All Statuses'|t }}</option>
          <option value="pending" {% if filters.status == 'pending' %}selected{% endif %}>{{ 'Pending'|t }}</option>
          <option value="processing" {% if filters.status == 'processing' %}selected{% endif %}>{{ 'Processing'|t }}</option>
          <option value="completed" {% if filters.status == 'completed' %}selected{% endif %}>{{ 'Completed'|t }}</option>
          <option value="paid" {% if filters.status == 'paid' %}selected{% endif %}>{{ 'Paid'|t }}</option>
          <option value="failed" {% if filters.status == 'failed' %}selected{% endif %}>{{ 'Failed'|t }}</option>
        </select>
      </div>
      <div class="lms-admin-filter__actions">
        <button type="submit" class="btn-lms-primary"><i class="fas fa-filter" aria-hidden="true"></i> {{ 'Apply filters'|t }}</button>
        <a href="{{ path('<current>') }}" class="btn-lms-secondary"><i class="fas fa-undo" aria-hidden="true"></i> {{ 'Reset'|t }}</a>
      </div>
    </form>

    <div class="lms-card">
      <div class="lms-table-responsive">
        <table class="lms-table lms-orders-table">
          <thead><tr><th scope="col">{{ 'Order ID'|t }}</th><th scope="col">{{ 'Learner'|t }}</th><th scope="col">{{ 'Amount'|t }}</th><th scope="col">{{ 'Date'|t }}</th><th scope="col">{{ 'Status'|t }}</th><th scope="col" class="lms-table__actions">{{ 'Actions'|t }}</th></tr></thead>
          <tbody>
            {% for order in orders %}
              <tr>
                <td class="lms-table__primary">#{{ order.id }}</td>
                <td>{{ order.learner }}</td>
                <td class="lms-table__numeric">${{ order.total|number_format(2) }}</td>
                <td>{{ order.created|date('M d, Y') }}</td>
                <td>
                  {% set sc = { 'paid': 'lms-badge--success', 'completed': 'lms-badge--success', 'pending': 'lms-badge--warning', 'processing': 'lms-badge--info', 'failed': 'lms-badge--danger' } %}
                  <span class="lms-badge {{ sc[order.status] ?? 'lms-badge--secondary' }}">{{ order.status|capitalize }}</span>
                </td>
                <td class="lms-table__actions">
                  <a href="{{ order.edit_url }}" class="btn-lms-secondary" title="{{ 'Edit order @id'|t({'@id': order.id}) }}">{{ 'Edit'|t }}</a>
                </td>
              </tr>
            {% else %}
              <tr><td colspan="6" class="lms-table__empty">{{ 'No orders match your filters.'|t }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="lms-admin-footer"><span>{{ orders|length }} {{ 'orders found'|t }}</span></div>
    </div>
  </div>
</div>
