{# Content List Table Partial #}
<div class="lms-admin-table-wrapper" style="overflow-x: auto;">
  <table class="lms-admin-table" style="width: 100%; border-collapse: collapse;">
    <thead>
      <tr style="background: rgba(30, 41, 59, 1); border-bottom: 2px solid rgba(255,255,255,0.05); text-align: left;">
        <th style="padding: 1rem 1.5rem; width: 40px; color: #fff;">
          <input type="checkbox" id="lms-check-all" style="accent-color: #3b82f6; width: 16px; height: 16px; cursor: pointer;">
        </th>
        {% if not hide_thumbnail %}
        <th style="padding: 1rem 1.5rem; text-transform: uppercase; font-size: 0.75rem; font-weight: 700; color: #fff; letter-spacing: 0.05em; width: 100px;">Thumbnail</th>
        {% endif %}
        <th style="padding: 1rem 1.5rem; text-transform: uppercase; font-size: 0.75rem; font-weight: 700; color: #fff; letter-spacing: 0.05em;">Content Title</th>
        <th style="padding: 1rem 1.5rem; text-transform: uppercase; font-size: 0.75rem; font-weight: 700; color: #fff; letter-spacing: 0.05em;">Created</th>
        <th style="padding: 1rem 1.5rem; text-transform: uppercase; font-size: 0.75rem; font-weight: 700; color: #fff; letter-spacing: 0.05em;">Status</th>
        <th style="padding: 1rem 1.5rem; text-transform: uppercase; font-size: 0.75rem; font-weight: 700; color: #fff; letter-spacing: 0.05em; text-align: right; width: 120px;">Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for item in contents %}
        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
          <td style="padding: 1rem 1.5rem;">
            <input type="checkbox" class="lms-row-check" value="{{ item.id }}" style="accent-color: #3b82f6; width: 16px; height: 16px; cursor: pointer;">
          </td>
          {% if not hide_thumbnail %}
          <td style="padding: 1rem 1.5rem;">
            {% if item.thumbnail_url %}
              <div style="width: 60px; height: 40px; border-radius: 4px; overflow: hidden; background: #1e293b;">
                <img src="{{ item.thumbnail_url }}" alt="" style="width:100%; height:100%; object-fit:cover;">
              </div>
            {% else %}
              <div style="width: 60px; height: 40px; border-radius: 4px; background: #1e293b; display: flex; align-items: center; justify-content: center; color: #475569;">
                <i class="fas fa-image"></i>
              </div>
            {% endif %}
          </td>
          {% endif %}
          <td style="padding: 1rem 1.5rem;">
            <div style="font-weight: 500; color: #f8fafc; margin-bottom: 0.25rem;">{{ item.title }}</div>
            <div style="font-size: 0.75rem; color: #64748b;">ID: {{ item.id }}</div>
          </td>
          <td style="padding: 1rem 1.5rem; color: #e2e8f0; font-size: 0.875rem;">
            {{ item.created|date('Y-m-d') }}
          </td>
          <td style="padding: 1rem 1.5rem;">
            {% if item.status is same as('N/A') %}
              <span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; background: rgba(148, 163, 184, 0.1); color: #94a3b8; border: 1px solid rgba(148,163,184,0.2);">N/A</span>
            {% elseif item.status %}
              <span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16,185,129,0.2);">Published</span>
            {% else %}
              <span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; background: rgba(245, 158, 11, 0.1); color: #f59e0b; border: 1px solid rgba(245,158,11,0.2);">Unpublished</span>
            {% endif %}
          </td>
          <td style="padding: 1rem 1.5rem; text-align: right;">
            <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
              <a href="{{ item.view_url }}" class="lms-admin-action-btn" title="View">
                <i class="fas fa-eye"></i>
              </a>
              <a href="{{ item.edit_url }}" class="lms-admin-action-btn" title="Edit">
                <i class="fas fa-edit"></i>
              </a>
            </div>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="6" style="padding: 3rem; text-align: center; color: #94a3b8;">
            No content found matching your criteria.
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<div style="padding: 1rem 1.5rem; border-top: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.01);">
  <div class="lms-admin-bulk-actions" style="display: flex; gap: 0.75rem; align-items: center;">
    <span style="font-size: 0.875rem; color: #94a3b8;"><i class="fas fa-level-up-alt fa-rotate-90"></i> Bulk Actions:</span>
    <button type="button" onclick="lmsBulkAction('publish')" class="btn-lms-secondary" style="padding: 0.35rem 1rem; border-radius: 0.375rem; font-size: 0.875rem;">
      <i class="fas fa-check" style="color: #10b981; margin-right: 0.35rem;"></i> Publish
    </button>
    <button type="button" onclick="lmsBulkAction('unpublish')" class="btn-lms-secondary" style="padding: 0.35rem 1rem; border-radius: 0.375rem; font-size: 0.875rem;">
      <i class="fas fa-times" style="color: #f59e0b; margin-right: 0.35rem;"></i> Unpublish
    </button>
  </div>
  <div>
    {{ pager }}
  </div>
</div>

<style>
.lms-admin-action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 4px;
  background: rgba(255,255,255,0.05);
  color: #94a3b8;
  text-decoration: none;
  transition: all 0.2s;
}
.lms-admin-action-btn:hover {
  background: #3b82f6;
  color: #fff;
}
</style>
