{% set can_publish = (supports_publishing ?? true) %}
<div class="lms-table-responsive">
  <table class="lms-table lms-content-table">
    <thead><tr>
      {% if can_publish %}<th scope="col" class="lms-table__select"><input type="checkbox" id="lms-check-all" aria-label="{{ 'Select all content on this page'|t }}"></th>{% endif %}
      {% if not hide_thumbnail %}<th scope="col">{{ 'Thumbnail'|t }}</th>{% endif %}
      <th scope="col">{{ 'Content Title'|t }}</th><th scope="col">{{ 'Created'|t }}</th><th scope="col">{{ 'Status'|t }}</th><th scope="col" class="lms-table__actions">{{ 'Actions'|t }}</th>
    </tr></thead>
    <tbody>
      {% for item in contents %}
        <tr>
          {% if can_publish %}<td class="lms-table__select"><input type="checkbox" class="lms-row-check" value="{{ item.id }}" aria-label="{{ 'Select @title'|t({'@title': item.title}) }}"></td>{% endif %}
          {% if not hide_thumbnail %}<td><div class="lms-admin-thumbnail">{% if item.thumbnail_url %}<img src="{{ item.thumbnail_url }}" alt="">{% else %}<i class="fas fa-image" aria-hidden="true"></i>{% endif %}</div></td>{% endif %}
          <td><div class="lms-table__primary">{{ item.title }}</div><div class="lms-table__muted">{{ 'ID'|t }}: {{ item.id }}</div></td>
          <td>{{ item.created ? item.created|date('M d, Y') : '—' }}</td>
          <td>{% if item.status is same as('N/A') %}<span class="lms-status lms-status--archived">{{ 'N/A'|t }}</span>{% elseif item.status %}<span class="lms-status lms-status--published">{{ 'Published'|t }}</span>{% else %}<span class="lms-status lms-status--draft">{{ 'Unpublished'|t }}</span>{% endif %}</td>
          <td class="lms-table__actions"><div class="lms-admin-actions">
            <a href="{{ item.view_url }}" class="lms-admin-action-link" title="{{ 'View content'|t }}" aria-label="{{ 'View content'|t }}"><i class="fas fa-eye" aria-hidden="true"></i></a>
            <a href="{{ item.edit_url }}" class="lms-admin-action-link" title="{{ 'Edit content'|t }}" aria-label="{{ 'Edit content'|t }}"><i class="fas fa-edit" aria-hidden="true"></i></a>
          </div></td>
        </tr>
      {% else %}<tr><td colspan="{{ 4 + (can_publish ? 1 : 0) + (hide_thumbnail ? 0 : 1) }}" class="lms-table__empty">{{ 'No content matches your filters.'|t }}</td></tr>{% endfor %}
    </tbody>
  </table>
</div>
<div class="lms-admin-footer">
  {% if can_publish %}<div class="lms-admin-bulk-actions"><strong>{{ 'Bulk actions'|t }}</strong>
    <button type="button" onclick="lmsBulkAction('publish')" class="btn-lms-secondary"><i class="fas fa-check" aria-hidden="true"></i> {{ 'Publish'|t }}</button>
    <button type="button" onclick="lmsBulkAction('unpublish')" class="btn-lms-secondary"><i class="fas fa-times" aria-hidden="true"></i> {{ 'Unpublish'|t }}</button>
  </div>
  {% endif %}
  <div class="lms-admin-footer__summary"><span>{{ contents|length }} {{ 'items on this page'|t }}</span>{{ pager }}</div>
</div>
