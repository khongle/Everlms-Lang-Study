{# Admin User List — matches mockup #}
{{ attach_library('lms_theme/global') }}

<div class="lms-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: 'users' } %}

  <div class="lms-admin__main">
    <form method="get" action="{{ url('<current>') }}" id="lms-admin-user-filter-form">
      <div class="lms-admin__header">
        <h1 class="lms-admin__title" style="margin-bottom: 0;">{{ 'User Management'|t }}</h1>
        <div style="display: flex; gap: 1rem; align-items: center;">
          <a href="{{ add_user_url }}" class="btn-lms-primary"><i class="fas fa-plus"></i> {{ 'Add User'|t }}</a>
          <a href="#" class="lms-admin-filter__select" style="display: none; align-items: center; justify-content: center; width: auto; background: rgba(255,255,255,0.05); color: #e2e8f0; text-decoration: none; padding: 0.625rem 1.25rem;">{{ 'Bulk Import'|t }}</a>
        </div>
      </div>

      <div class="lms-admin-card" style="border-bottom-left-radius: 0; border-bottom-right-radius: 0; margin-bottom: 0; border-bottom: none;">
        <div style="padding: 1.5rem; display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 1px solid rgba(255,255,255,0.05);">
          <div style="display: flex; gap: 1.5rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <div style="position: relative;">
                <input type="text" name="search" value="{{ current_search }}" class="lms-admin-filter__input" placeholder="{{ 'Search users by name, email...'|t }}" style="padding-left: 1rem; padding-right: 2.5rem; width: 250px; padding-top: 0.35rem; padding-bottom: 0.35rem; border-radius: 0.375rem;">
                <i class="fas fa-search" style="position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); color: #64748b; pointer-events: none;"></i>
              </div>
            </div>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <span style="color: #94a3b8; font-size: 0.875rem; font-weight: 500;">Role:</span>
              <select name="role" class="lms-admin-filter__select" style="width: 140px; padding: 0.35rem 0.75rem;">
                <option value="All" {% if current_role == 'All' %}selected{% endif %}>All</option>
                <option value="Student" {% if current_role == 'Student' %}selected{% endif %}>Student</option>
                <option value="Instructor" {% if current_role == 'Instructor' %}selected{% endif %}>Instructor</option>
                <option value="Manager" {% if current_role == 'Manager' %}selected{% endif %}>Manager</option>
                <option value="Admin" {% if current_role == 'Admin' %}selected{% endif %}>Admin</option>
              </select>
            </div>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <span style="color: #94a3b8; font-size: 0.875rem; font-weight: 500;">Status:</span>
              <select name="status" class="lms-admin-filter__select" style="width: 140px; padding: 0.35rem 0.75rem;">
                <option value="All" {% if current_status == 'All' %}selected{% endif %}>All</option>
                <option value="Active" {% if current_status == 'Active' %}selected{% endif %}>Active</option>
                <option value="Inactive" {% if current_status == 'Inactive' %}selected{% endif %}>Inactive</option>
              </select>
            </div>
          </div>
          <div style="display: flex; gap: 0.75rem;">
            <button type="button" id="lms-user-reset-btn" class="lms-admin-filter__select" style="background: transparent; color: #cbd5e1; padding: 0.35rem 1rem; font-size: 0.875rem; cursor: pointer;">
              <i class="fas fa-sync-alt" style="margin-right:0.5rem"></i> Reset
            </button>
          </div>
        </div>
      </div>
    </form>

    <div class="lms-admin-card" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-top: 0; border-top: none;">
      <div id="lms-user-table-container">
        {% include '@lms_course/lms-admin-users-table.html.twig' %}
      </div>
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('lms-admin-user-filter-form');
    const container = document.getElementById('lms-user-table-container');
    let timeout = null;

    // Delegate Checkbox events (because table elements are replaced by AJAX)
    container.addEventListener('change', function(e) {
      if (e.target.id === 'bulk-select-all') {
        const userCheckboxes = document.querySelectorAll('.bulk-user-checkbox');
        userCheckboxes.forEach(cb => cb.checked = e.target.checked);
        updateCount();
      } else if (e.target.classList.contains('bulk-user-checkbox')) {
        updateCount();
      }
    });

    function updateCount() {
      const userCheckboxes = document.querySelectorAll('.bulk-user-checkbox');
      const count = document.querySelectorAll('.bulk-user-checkbox:checked').length;
      const selectedCountText = document.getElementById('bulk-selected-count');
      const selectAllBtn = document.getElementById('bulk-select-all');

      if (selectedCountText) {
        selectedCountText.textContent = count === 1 ? '1 selected user' : count + ' selected users';
      }
      
      if(selectAllBtn) {
        selectAllBtn.checked = (count === userCheckboxes.length && userCheckboxes.length > 0);
      }
    }

    // Ajax Filtering Logic
    function fetchUsers(overrideUrl = null) {
      container.style.opacity = '0.5';
      container.style.pointerEvents = 'none';

      let url;
      if (overrideUrl) {
        url = new URL(overrideUrl, window.location.origin);
      } else {
        url = new URL(form.getAttribute('action'), window.location.origin);
        const formData = new FormData(form);
        for (const [key, value] of formData) {
          url.searchParams.append(key, value);
        }
      }
      
      history.pushState(null, '', url.toString());
      url.searchParams.append('ajax', '1');

      fetch(url)
        .then(response => response.text())
        .then(html => {
          container.innerHTML = html;
          container.style.opacity = '1';
          container.style.pointerEvents = 'auto';
          updateCount(); // Reset counter
        })
        .catch(error => {
          console.error('Error fetching users:', error);
          container.style.opacity = '1';
          container.style.pointerEvents = 'auto';
        });
    }

    form.addEventListener('input', function(e) {
      if (e.target.name === 'search') {
        clearTimeout(timeout);
        timeout = setTimeout(() => fetchUsers(), 400);
      }
    });

    form.addEventListener('change', function(e) {
      if (e.target.tagName.toLowerCase() === 'select') {
        fetchUsers();
      }
    });

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      fetchUsers();
    });

    // Handle Reset
    const resetBtn = document.getElementById('lms-user-reset-btn');
    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        form.reset();
        const searchInput = form.querySelector('input[name="search"]');
        if(searchInput) searchInput.value = '';
        
        const selects = form.querySelectorAll('select');
        selects.forEach(s => s.value = 'All');

        fetchUsers(form.getAttribute('action'));
      });
    }

    // Handle Pagination
    container.addEventListener('click', function(e) {
      const pagerLink = e.target.closest('a');
      if (pagerLink && (pagerLink.closest('ul.pager__items') || pagerLink.closest('nav.pager') || pagerLink.closest('.pager'))) {
        e.preventDefault();
        fetchUsers(pagerLink.href);
      }
    });
    // Attach Toast Container once
    if (!document.getElementById('lms-toast-container')) {
      const toastContainer = document.createElement('div');
      toastContainer.id = 'lms-toast-container';
      toastContainer.style.cssText = 'position: fixed; top: 1.5rem; right: 1.5rem; z-index: 9999; display: flex; flex-direction: column; gap: 0.75rem;';
      document.body.appendChild(toastContainer);
    }

    function showToast(message, type = 'error') {
      const container = document.getElementById('lms-toast-container');
      const toast = document.createElement('div');
      const bgColor = type === 'error' ? 'rgba(239, 68, 68, 0.9)' : 'rgba(34, 197, 94, 0.9)';
      const icon = type === 'error' ? 'fa-exclamation-circle' : 'fa-check-circle';
      
      toast.style.cssText = `
        background: ${bgColor};
        color: white;
        padding: 1rem 1.5rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        transform: translateX(100%);
        opacity: 0;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.1);
      `;
      
      toast.innerHTML = `<i class="fas ${icon}" style="font-size: 1.25rem;"></i> <span>${message}</span>`;
      container.appendChild(toast);
      
      // Animate in
      requestAnimationFrame(() => {
        toast.style.transform = 'translateX(0)';
        toast.style.opacity = '1';
      });
      
      // Animate out and remove
      setTimeout(() => {
        toast.style.transform = 'translateX(100%)';
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }

    // Intercept Bulk Action submit
    container.addEventListener('submit', function(e) {
      if (e.target.id === 'lms-bulk-users-form') {
        const count = document.querySelectorAll('.bulk-user-checkbox:checked').length;
        if (count === 0) {
          e.preventDefault();
          showToast('Vui lòng chọn ít nhất 1 thành viên để thực hiện thao tác!', 'error');
        }
      }
    });

  });
</script>
