{# Admin Reports — matches 14-admin-reports.png #}
{{ attach_library('lms_theme/global') }}
{{ attach_library('lms_analytics/admin_report') }}

<div class="lms-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: 'reports' } %}
  <div class="lms-admin__main">
    <h1 class="lms-admin__title">{{ 'Reports & Analytics'|t }}</h1>

    <div class="lms-kpi-grid">
      <div class="lms-card lms-kpi-card">
        <div class="lms-kpi-card__icon"><i class="fas fa-user-graduate"></i></div>
        <div class="lms-kpi-card__content">
          <span class="lms-kpi-card__label">{{ 'Total Enrollments'|t }}</span>
          <span class="lms-kpi-card__value">{{ metrics.total_enrollments }}</span>
        </div>
      </div>
      <div class="lms-card lms-kpi-card">
        <div class="lms-kpi-card__icon lms-kpi-card__icon--success"><i class="fas fa-check-circle"></i></div>
        <div class="lms-kpi-card__content">
          <span class="lms-kpi-card__label">{{ 'Completions'|t }}</span>
          <span class="lms-kpi-card__value">{{ metrics.completions }}</span>
        </div>
      </div>
      <div class="lms-card lms-kpi-card">
        <div class="lms-kpi-card__icon lms-kpi-card__icon--info"><i class="fas fa-certificate"></i></div>
        <div class="lms-kpi-card__content">
          <span class="lms-kpi-card__label">{{ 'Certificates Issued'|t }}</span>
          <span class="lms-kpi-card__value">{{ metrics.certificates_issued }}</span>
        </div>
      </div>
      <div class="lms-card lms-kpi-card">
        <div class="lms-kpi-card__icon lms-kpi-card__icon--warning"><i class="fas fa-percentage"></i></div>
        <div class="lms-kpi-card__content">
          <span class="lms-kpi-card__label">{{ 'Completion Rate'|t }}</span>
          <span class="lms-kpi-card__value">{{ metrics.completion_rate }}%</span>
        </div>
      </div>
    </div>

    <!-- Tab Navigation -->
    <div class="lms-report-tabs" style="margin-top: 2.5rem; display: block;">
      <ul class="lms-report-tabs__list" style="display: flex; list-style: none; gap: 2rem; border-bottom: 1px solid #334155; padding: 0 0 0.5rem 0; margin-bottom: 2rem;">
        <li class="lms-report-tabs__item active" data-tab="course-analytics" style="cursor: pointer; padding: 0.5rem 0; border-bottom: 2px solid #3b82f6; font-weight: bold; color: #fff; font-size: 1.1rem;">{{ 'Course Analytics'|t }}</li>
        <li class="lms-report-tabs__item" data-tab="learner-analytics" style="cursor: pointer; padding: 0.5rem 0; border-bottom: 2px solid transparent; color: #94a3b8; font-size: 1.1rem;">{{ 'Learner Analytics'|t }}</li>
        <li class="lms-report-tabs__item" data-tab="quiz-analytics" style="cursor: pointer; padding: 0.5rem 0; border-bottom: 2px solid transparent; color: #94a3b8; font-size: 1.1rem;">{{ 'Quiz Analytics'|t }}</li>
      </ul>

      <!-- Tab Content: Course Analytics -->
      <div id="course-analytics" class="lms-report-tab-content" style="display: block;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
          <h2 style="margin: 0; color: #e2e8f0; font-size: 1.25rem;">{{ 'Course Financials & Engagement'|t }}</h2>
          <a href="{{ url('lms_analytics.course_report_export') }}" class="btn-lms-primary" style="text-decoration: none; display: inline-flex; align-items: center;"><i class="fas fa-download" style="margin-right: 8px;"></i> {{ 'Export Course Data'|t }}</a>
        </div>
        
        <!-- Chart Container -->
        {% if course_stats is not empty %}
        <div class="lms-card" style="margin-bottom: 2rem; padding: 1.5rem;">
          <canvas id="courseAnalyticsChart" height="80"></canvas>
        </div>
        {% endif %}

        <div class="lms-card">
          <div class="lms-table-responsive">
            <table class="lms-table">
              <thead>
                <tr>
                  <th>{{ 'Course Name'|t }}</th>
                  <th style="text-align: center;">{{ 'Enrollments'|t }}</th>
                  <th style="text-align: center;">{{ 'Completions'|t }}</th>
                  <th style="text-align: center;">{{ 'Completion Rate'|t }}</th>
                  <th style="text-align: right;">{{ 'Total Revenue'|t }}</th>
                </tr>
              </thead>
              <tbody>
                {% for course in course_stats %}
                  <tr>
                    <td>
                      <div style="font-weight: 600;">{{ course.title }}</div>
                      <div style="font-size: 0.8rem; color: #94a3b8; margin-top: 4px;">{{ course.category }}</div>
                    </td>
                    <td style="text-align: center; font-weight: bold;">{{ course.enrollments }}</td>
                    <td style="text-align: center;">{{ course.completions }}</td>
                    <td style="text-align: center; width: 15%;">
                      <div style="background: #334155; border-radius: 10px; height: 6px; width: 100%; overflow: hidden; margin-bottom: 4px;">
                        <div style="background: {{ course.completion_rate >= 50 ? '#10b981' : '#f59e0b' }}; height: 100%; width: {{ course.completion_rate }}%;"></div>
                      </div>
                      <small style="color: #cbd5e1;">{{ course.completion_rate }}%</small>
                    </td>
                    <td style="text-align: right; font-weight: 600; color: #34d399;">${{ course.revenue|number_format(2) }}</td>
                  </tr>
                {% else %}
                  <tr>
                    <td colspan="5" style="text-align: center; color: #94a3b8; padding: 2rem;">{{ 'No course data available.'|t }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Tab Content: Learner Analytics -->
      <div id="learner-analytics" class="lms-report-tab-content" style="display: none;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
          <h2 style="margin: 0; color: #e2e8f0; font-size: 1.25rem;">{{ 'Learner Progress & Certifications'|t }}</h2>
          <a href="{{ url('lms_analytics.user_report_export') }}" class="btn-lms-primary" style="text-decoration: none; display: inline-flex; align-items: center;"><i class="fas fa-download" style="margin-right: 8px;"></i> {{ 'Export Learner Data'|t }}</a>
        </div>
        
        <div class="lms-card">
          <div class="lms-table-responsive">
            <table class="lms-table">
              <thead>
                <tr>
                  <th>{{ 'Student'|t }}</th>
                  <th style="text-align: center;">{{ 'Enrolled Courses'|t }}</th>
                  <th style="text-align: center;">{{ 'Completed'|t }}</th>
                  <th style="text-align: center;">{{ 'Avg Quiz Score'|t }}</th>
                  <th style="text-align: center;">{{ 'Certificates'|t }}</th>
                  <th style="text-align: right;">{{ 'Last Active'|t }}</th>
                  <th style="text-align: center; width: 60px;">{{ 'Action'|t }}</th>
                </tr>
              </thead>
              <tbody>
                {% for user in user_stats %}
                  <tr class="lms-user-row">
                    <td>
                      <div style="font-weight: 600;">{{ user.name }}</div>
                      <div style="font-size: 0.8rem; color: #94a3b8; margin-top: 4px;">{{ user.email }}</div>
                    </td>
                    <td style="text-align: center; font-weight: bold;">{{ user.enrolled }}</td>
                    <td style="text-align: center; color: #10b981;">{{ user.completed }}</td>
                    <td style="text-align: center;">
                      <span style="color: {{ user.avg_score >= 80 ? '#10b981' : (user.avg_score >= 50 ? '#f59e0b' : '#ef4444') }}; font-weight: bold;">
                        {{ user.avg_score|number_format(1) }}
                      </span>
                    </td>
                    <td style="text-align: center;">{{ user.certs }}</td>
                    <td style="text-align: right; color: #cbd5e1; font-size: 0.9rem;">
                      {{ user.last_login ? user.last_login|date('M d, Y') : 'Never' }}
                    </td>
                    <td style="text-align: center;">
                      <button type="button" class="lms-btn lms-btn--outline" onclick="toggleTracking({{ user.uid }})" style="padding: 4px 10px; font-size: 13px;" title="View Tracking">
                        <i class="fas fa-eye"></i>
                      </button>
                    </td>
                  </tr>

                  <!-- Accordion Row -->
                  <tr id="tracking-{{ user.uid }}" style="display: none; background: #0f172a;">
                    <td colspan="7" style="padding: 0;">
                      <div style="display: flex; gap: 2rem; padding: 1.5rem; border-top: 1px solid #1e293b; border-bottom: 2px solid #3b82f6;">
                        
                        <!-- Courses In Progress -->
                        <div style="flex: 1;">
                          <h4 style="color: #f59e0b; border-bottom: 2px solid #334155; padding-bottom: 8px; margin-top: 0; font-size: 0.95rem;">{{ 'Courses (In Progress)'|t }}</h4>
                          <ul style="list-style: none; padding: 0; margin-top: 1rem;">
                            {% set has_in_progress = false %}
                            {% for c in user.tracking.courses %}
                              {% if c.status != 'completed' %}
                                {% set has_in_progress = true %}
                                <li style="display: flex; justify-content: space-between; border-bottom: 1px solid #1e293b; padding: 8px 0;">
                                  <span style="color: #e2e8f0; font-size: 0.9rem;">{{ c.title }}</span>
                                  <span style="color: #f59e0b; font-size: 0.85rem; font-weight: bold;">{{ c.progress }}%</span>
                                </li>
                              {% endif %}
                            {% endfor %}
                            {% if not has_in_progress %}
                              <li style="color: #64748b; font-size: 0.85rem; padding: 8px 0;">{{ 'No courses in progress.'|t }}</li>
                            {% endif %}
                          </ul>
                        </div>
                        
                        <!-- Courses Completed -->
                        <div style="flex: 1;">
                          <h4 style="color: #10b981; border-bottom: 2px solid #334155; padding-bottom: 8px; margin-top: 0; font-size: 0.95rem;">{{ 'Courses (Completed)'|t }}</h4>
                          <ul style="list-style: none; padding: 0; margin-top: 1rem;">
                            {% set has_completed = false %}
                            {% for c in user.tracking.courses %}
                              {% if c.status == 'completed' %}
                                {% set has_completed = true %}
                                <li style="display: flex; justify-content: space-between; border-bottom: 1px solid #1e293b; padding: 8px 0;">
                                  <span style="color: #e2e8f0; font-size: 0.9rem;">{{ c.title }}</span>
                                  <span style="color: #10b981; font-size: 0.85rem; font-weight: bold;"><i class="fas fa-check"></i> 100%</span>
                                </li>
                              {% endif %}
                            {% endfor %}
                            {% if not has_completed %}
                              <li style="color: #64748b; font-size: 0.85rem; padding: 8px 0;">{{ 'No completed courses.'|t }}</li>
                            {% endif %}
                          </ul>
                        </div>

                        <!-- Quizzes Taken -->
                        <div style="flex: 1;">
                          <h4 style="color: #3b82f6; border-bottom: 2px solid #334155; padding-bottom: 8px; margin-top: 0; font-size: 0.95rem;">{{ 'Quizzes (Taken)'|t }}</h4>
                          <ul style="list-style: none; padding: 0; margin-top: 1rem;">
                            {% for q in user.tracking.quizzes %}
                              <li style="display: flex; justify-content: space-between; border-bottom: 1px solid #1e293b; padding: 8px 0;">
                                <span style="color: #e2e8f0; font-size: 0.9rem;">{{ q.title }}</span>
                                <span style="color: #3b82f6; font-size: 0.85rem; font-weight: bold;">{{ q.score }}%</span>
                              </li>
                            {% else %}
                              <li style="color: #64748b; font-size: 0.85rem; padding: 8px 0;">{{ 'No quizzes taken.'|t }}</li>
                            {% endfor %}
                          </ul>
                        </div>

                      </div>
                    </td>
                  </tr>

                {% else %}
                  <tr>
                    <td colspan="7" style="text-align: center; color: #94a3b8; padding: 2rem;">{{ 'No learner data available.'|t }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Tab Content: Quiz Analytics -->
      <div id="quiz-analytics" class="lms-report-tab-content" style="display: none;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
          <h2 style="margin: 0; color: #e2e8f0; font-size: 1.25rem;">{{ 'Quiz Performance Overview'|t }}</h2>
        </div>
        
        <div class="lms-card">
          <div class="lms-table-responsive">
            <table class="lms-table">
              <thead>
                <tr>
                  <th>{{ 'Quiz Title'|t }}</th>
                  <th style="text-align: center;">{{ 'Total Attempts'|t }}</th>
                  <th style="text-align: center;">{{ 'Avg. Score'|t }}</th>
                  <th style="text-align: center;">{{ 'Pass Rate'|t }}</th>
                  <th style="text-align: right;">{{ 'Action'|t }}</th>
                </tr>
              </thead>
              <tbody>
                {% for quiz in quiz_stats %}
                  <tr>
                    <td>
                      <div style="font-weight: 600;">{{ quiz.title }}</div>
                      <div style="font-size: 0.8rem; color: #94a3b8; margin-top: 4px;">{{ 'Min score:'|t }} {{ quiz.pass_threshold }}%</div>
                    </td>
                    <td style="text-align: center; font-weight: bold;">{{ quiz.attempts }}</td>
                    <td style="text-align: center; color: #60a5fa; font-weight: bold;">{{ quiz.avg_score|number_format(1) }}</td>
                    <td style="text-align: center;">
                      <span style="color: {{ quiz.pass_rate >= 50 ? '#10b981' : '#ef4444' }};">{{ quiz.pass_rate }}%</span>
                    </td>
                    <td style="text-align: right;">
                      <a href="{{ url('lms_analytics.quiz_report_detail', {'quiz_id': quiz.id}) }}" class="lms-btn lms-btn--outline" style="padding: 4px 12px; font-size: 13px;">{{ 'Item Analysis'|t }}</a>
                    </td>
                  </tr>
                {% else %}
                  <tr>
                    <td colspan="5" style="text-align: center; color: #94a3b8; padding: 2rem;">{{ 'No quiz data available.'|t }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Tracking Row Toggle Function
  function toggleTracking(uid) {
    const trackingRow = document.getElementById('tracking-' + uid);
    if (trackingRow) {
      if (trackingRow.style.display === 'none' || trackingRow.style.display === '') {
        trackingRow.style.display = 'table-row';
      } else {
        trackingRow.style.display = 'none';
      }
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    // 1. Tab Switching Logic
    const tabs = document.querySelectorAll('.lms-report-tabs__item');
    const contents = document.querySelectorAll('.lms-report-tab-content');

    tabs.forEach(tab => {
      tab.addEventListener('click', function() {
        tabs.forEach(t => {
          t.style.borderBottomColor = 'transparent';
          t.style.color = '#94a3b8';
          t.style.fontWeight = 'normal';
        });
        
        this.style.borderBottomColor = '#3b82f6';
        this.style.color = '#fff';
        this.style.fontWeight = 'bold';

        contents.forEach(c => c.style.display = 'none');
        
        const targetId = this.getAttribute('data-tab');
        const targetContent = document.getElementById(targetId);
        if (targetContent) {
            targetContent.style.display = 'block';
        }
      });
    });

    // 2. Chart.js Rendering Logic
    if (typeof Chart !== 'undefined' && document.getElementById('courseAnalyticsChart')) {
      const courseStatsRaw = {{ course_stats|json_encode|raw }};
      const courseStats = Object.values(courseStatsRaw);
      
      if (courseStats.length > 0) {
        const labels = [];
        const enrollmentsData = [];
        const revenueData = [];

        courseStats.forEach(course => {
          let title = course.title;
          if (title.length > 30) {
              title = title.substring(0, 30) + '...';
          }
          labels.push(title);
          enrollmentsData.push(course.enrollments);
          revenueData.push(course.revenue);
        });

        const ctx = document.getElementById('courseAnalyticsChart').getContext('2d');
        new Chart(ctx, {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [
              {
                label: 'Total Enrollments',
                data: enrollmentsData,
                backgroundColor: '#3b82f6',
                borderRadius: 4,
                yAxisID: 'y',
                order: 2
              },
              {
                label: 'Total Revenue ($)',
                data: revenueData,
                type: 'line',
                borderColor: '#10b981',
                backgroundColor: '#10b981',
                borderWidth: 3,
                tension: 0.3,
                pointBackgroundColor: '#10b981',
                pointRadius: 4,
                yAxisID: 'y1',
                order: 1
              }
            ]
          },
          options: {
            responsive: true,
            interaction: {
              mode: 'index',
              intersect: false,
            },
            plugins: {
              legend: {
                labels: {
                  color: '#cbd5e1',
                  font: {
                    family: "'Inter', sans-serif",
                    size: 13
                  }
                }
              },
              tooltip: {
                backgroundColor: '#0f172a',
                titleColor: '#f8fafc',
                bodyColor: '#e2e8f0',
                borderColor: '#334155',
                borderWidth: 1,
                padding: 12
              }
            },
            scales: {
              x: {
                grid: {
                  color: '#334155',
                  drawBorder: false,
                },
                ticks: {
                  color: '#94a3b8',
                  font: {
                    family: "'Inter', sans-serif"
                  }
                }
              },
              y: {
                type: 'linear',
                display: true,
                position: 'left',
                title: {
                  display: true,
                  text: 'Enrollments',
                  color: '#94a3b8'
                },
                grid: {
                  color: '#334155',
                  drawBorder: false,
                },
                ticks: {
                  color: '#94a3b8',
                  stepSize: 1
                }
              },
              y1: {
                type: 'linear',
                display: true,
                position: 'right',
                title: {
                  display: true,
                  text: 'Revenue ($)',
                  color: '#94a3b8'
                },
                grid: {
                  drawOnChartArea: false,
                },
                ticks: {
                  color: '#10b981'
                }
              }
            }
          }
        });
      }
    }
  });
</script>
