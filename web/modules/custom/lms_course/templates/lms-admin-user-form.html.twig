{# Admin User Form Wrapper #}
{{ attach_library('lms_theme/global') }}

<div class="lms-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: active_menu } %}

  <div class="lms-admin__main">
    <div class="lms-admin__header" style="padding-top: 3rem;">
      <h1 class="lms-admin__title" style="margin-bottom: 0;">{{ title }}</h1>
    </div>

    <div class="lms-admin-card" style="padding: 2.5rem; background: #0b0f19; border-top: 1px solid rgba(255,255,255,0.05); min-height: calc(100vh - 100px);">
      <style>
        /* HIDE GLOBAL NAVBAR IN WORKSPACE TO SAVE VERTICAL SPACE */
        .lms-navbar {
           display: none !important;
        }

        /* Professional Light Mode Form */
        .lms-admin-user-form-wrapper {
          background: #ffffff; /* Clean white */
          border-radius: 0.5rem;
          padding: 2.5rem;
          color: #334155;
          box-shadow: 0 4px 15px rgba(0,0,0,0.05); /* Soft premium shadow */
        }

        /* Form Item Typography & Spacing */
        .lms-form-content .form-item {
          margin-bottom: 1.5rem;
          width: 100%;
        }
        .lms-form-content .form-item label {
          display: block;
          color: #334155;
          font-weight: 600;
          margin-bottom: 0.5rem;
          font-size: 0.95rem;
        }

        /* Light Inputs - Overriding _workspace-admin.scss bleeding dark mode */
        #lms-admin-form-app .lms-form-content label,
        #lms-admin-form-app .lms-form-content .form-item > label {
          color: #334155 !important;
        }

        #lms-admin-form-app .lms-form-content input:not([type="submit"]):not([type="button"]):not([value="Edit"]):not([value="Remove"]):not([type="checkbox"]):not([type="radio"]):not([type="hidden"]), 
        #lms-admin-form-app .lms-form-content select, 
        #lms-admin-form-app .lms-form-content textarea,
        #lms-admin-form-app .lms-form-content .form-element, 
        #lms-admin-form-app .lms-form-content .form-select, 
        #lms-admin-form-app .lms-form-content .form-textarea, 
        #lms-admin-form-app .lms-form-content .form-text, 
        #lms-admin-form-app .lms-form-content .form-date, 
        #lms-admin-form-app .lms-form-content .form-time, 
        #lms-admin-form-app .lms-form-content .form-autocomplete, 
        #lms-admin-form-app .lms-form-content .form-number, 
        #lms-admin-form-app .lms-form-content .form-email, 
        #lms-admin-form-app .lms-form-content .form-password,
        #lms-admin-form-app .lms-form-content .ck-editor__editable,
        #lms-admin-form-app .lms-form-content .ck-editor__main {
          width: 100%;
          background: #f8fafc !important; 
          border: 1px solid #cbd5e1 !important; 
          color: #1e293b !important;
          padding: 0.75rem 1rem !important;
          border-radius: 0.5rem !important;
          transition: all 0.2s;
          font-family: inherit;
          box-sizing: border-box;
        }
        
        /* CKEditor Toolbar Light Mode */
        #lms-admin-form-app .lms-form-content .ck.ck-toolbar {
          background: #f1f5f9 !important;
          border: 1px solid #cbd5e1 !important;
          border-bottom: none !important;
          border-top-left-radius: 0.5rem !important;
          border-top-right-radius: 0.5rem !important;
        }
        #lms-admin-form-app .lms-form-content .ck.ck-toolbar *,
        #lms-admin-form-app .lms-form-content .ck.ck-button {
          color: #334155 !important;
        }
        #lms-admin-form-app .lms-form-content .ck.ck-toolbar .ck-button:hover {
          background: #e2e8f0 !important;
        }
        
        #lms-admin-form-app .lms-form-content .ck.ck-editor__main > .ck-editor__editable {
          border-top-left-radius: 0 !important;
          border-top-right-radius: 0 !important;
          min-height: 150px;
          background: #f8fafc !important;
          color: #1e293b !important;
        }

        #lms-admin-form-app .lms-form-content input:focus, 
        #lms-admin-form-app .lms-form-content textarea:focus,
        #lms-admin-form-app .lms-form-content select:focus,
        #lms-admin-form-app .lms-form-content .form-element:focus,
        #lms-admin-form-app .lms-form-content .ck-editor__editable.ck-focused {
          outline: none !important;
          border-color: #3b82f6 !important; /* EverLMS Blue */
          box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15) !important;
          background: #ffffff !important;
        }
        
        /* Form Actions (Save button area) */
        .lms-form-content .form-actions {
          margin-top: 3rem;
          padding-top: 1.5rem;
          border-top: 1px solid #e2e8f0;
          display: flex;
          gap: 1rem;
        }
        .lms-form-content input[type="submit"],
        .lms-form-content .button {
          background: #3b82f6 !important; /* EverLMS Blue */
          color: white !important;
          padding: 0.75rem 2.5rem !important;
          border-radius: 0.5rem !important;
          border: none !important;
          font-weight: 600 !important;
          cursor: pointer !important;
          transition: all 0.2s ease !important;
          font-size: 1rem !important;
        }
        .lms-form-content input[type="submit"]:hover,
        .lms-form-content .button:hover {
          background: #2563eb !important;
          transform: translateY(-2px);
          box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3) !important;
        }
        
        /* Profile Image Field Overrides */
        .lms-form-content .image-preview {
            border-radius: 50%;
            overflow: hidden;
            width: 100px;
            height: 100px;
            object-fit: cover;
        }
      </style>
      
      <div class="lms-admin-user-form-wrapper" id="lms-admin-form-app">
        <div class="lms-form-content">
          {{ form }}
        </div>
      </div>
    </div>
  </div>
</div>
