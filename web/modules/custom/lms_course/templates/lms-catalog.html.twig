{# Course listing — matches 02-course-listing.png: left sidebar + course grid + sort + pagination #}
{{ attach_library('lms_theme/global') }}

    <div class="lms-catalog">
      {# Left sidebar — Search Filters #}
      <aside class="lms-catalog__sidebar">
        <h3 class="lms-catalog__sidebar-title">{{ 'SEARCH FILTERS'|t }}</h3>

        {# Title search #}
        <div class="lms-catalog__filter-group">
          <input type="text" class="form-control lms-input" placeholder="{{ 'Title'|t }}" id="course-search" value="{{ filters.search|default('') }}">
        </div>

        {# Category filter #}
        <div class="lms-catalog__filter-group">
          <h4>{{ 'CATEGORY'|t }}</h4>
          <div class="lms-category-list">
            {% set visible_count = 0 %}
            {% set hidden_count = 0 %}
            {% set wrapper_opened = false %}
            
            {% for cat in categories %}
              {% set cat_id_str = cat.id() ~ '' %}
              {% set is_checked = false %}
              {% for fc in filters.category %}
                {% if (fc ~ '') == cat_id_str %}
                  {% set is_checked = true %}
                {% endif %}
              {% endfor %}
              {% set is_hidden = not is_checked and visible_count >= 5 %}
              
              {% if not is_hidden %}
                {% set visible_count = visible_count + 1 %}
                <label class="lms-catalog__checkbox">
                  <input type="checkbox" value="{{ cat.id() }}" data-filter-type="category" {% if is_checked %}checked{% endif %}>
                  <span>{{ cat.label }}</span>
                </label>
              {% else %}
                {% if not wrapper_opened %}
                  <div class="lms-js-hidden-cats" style="display: none;">
                  {% set wrapper_opened = true %}
                {% endif %}
                
                {% set hidden_count = hidden_count + 1 %}
                <label class="lms-catalog__checkbox">
                  <input type="checkbox" value="{{ cat.id() }}" data-filter-type="category" {% if is_checked %}checked{% endif %}>
                  <span>{{ cat.label }}</span>
                </label>
              {% endif %}
            {% endfor %}

            {% if wrapper_opened %}
              </div>
            {% endif %}

            {% if hidden_count > 0 %}
               <button type="button" class="lms-catalog__show-more" data-hidden-count="{{ hidden_count }}" style="color: #6366f1; font-size: 0.85rem; padding: 6px 12px; margin-top: 4px; border: none; background: transparent; cursor: pointer; transition: color 0.2s;">
                   + {{ hidden_count }} {{ 'More Categories'|t }}
               </button>
            {% endif %}
          </div>
        </div>

        {# Level filter #}
        <div class="lms-catalog__filter-group">
          <h4>{{ 'LEVEL'|t }}</h4>
          {% for level in ['Beginner', 'Intermediate', 'Advanced'] %}
            <label class="lms-catalog__checkbox">
              <input type="checkbox" value="{{ level|lower }}" data-filter-type="level" {% if level|lower in filters.level %}checked{% endif %}>
              <span>{{ level|t }}</span>
            </label>
          {% endfor %}
        </div>

        {# Price filter #}
        <div class="lms-catalog__filter-group">
          <h4>{{ 'PRICE'|t }}</h4>
          <label class="lms-catalog__checkbox">
            <input type="checkbox" value="free" data-filter-type="price" {% if 'free' in filters.price %}checked{% endif %}>
            <span>{{ 'Free'|t }}</span>
          </label>
          <label class="lms-catalog__checkbox">
            <input type="checkbox" value="paid" data-filter-type="price" {% if 'paid' in filters.price %}checked{% endif %}>
            <span>{{ 'Paid'|t }}</span>
          </label>
        </div>

        {# Rating filter #}
        <div class="lms-catalog__filter-group">
          <h4>{{ 'RATING'|t }}</h4>
          {% for r in [5, 4, 3, 2, 1] %}
            <label class="lms-catalog__checkbox">
              <input type="checkbox" value="{{ r }}" data-filter-type="rating" {% if r in filters.rating %}checked{% endif %}>
              <span class="lms-rating-stars">
                {% for i in 1..5 %}
                  <i class="fas fa-star {% if i <= r %}text-warning{% else %}text-muted{% endif %}"></i>
                {% endfor %}
                <span style="margin-left: 4px;">{{ r }} {{ 'Stars'|t }}</span>
              </span>
            </label>
          {% endfor %}
        </div>
      </aside>

      {# Main course grid #}
      <div class="lms-catalog__main">
        {# Sort by & Top Pagination #}
        <div class="lms-catalog__toolbar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
          <span class="lms-catalog__count">{{ courses|length }} {{ 'courses found'|t }}</span>
          
          <div style="display: flex; align-items: center; gap: 1rem;">
            <select class="form-control lms-select" id="sort-courses">
              <option value="Most Popular" {% if filters.sort == 'Most Popular' %}selected{% endif %}>{{ 'Most Popular'|t }}</option>
              <option value="Newest" {% if filters.sort == 'Newest' %}selected{% endif %}>{{ 'Newest'|t }}</option>
              <option value="Highest Rated" {% if filters.sort == 'Highest Rated' %}selected{% endif %}>{{ 'Highest Rated'|t }}</option>
              <option value="Price Low-High" {% if filters.sort == 'Price Low-High' %}selected{% endif %}>{{ 'Price Low-High'|t }}</option>
            </select>
          </div>
        </div>

        {# Course grid #}
        {% if courses|length > 0 %}
          <div class="grid-courses">
            {% for card in courses %}
              {{ { '#theme': 'lms_course_card', '#card': card } }}
            {% endfor %}
          </div>

          {# Pagination #}
          {{ pager }}
        {% else %}
          <div class="lms-empty-state">
            <i class="fas fa-search"></i>
            <h3>{{ 'No courses found'|t }}</h3>
            <p>{{ 'Try adjusting your filters'|t }}</p>
          </div>
        {% endif %}
      </div>
    </div>
