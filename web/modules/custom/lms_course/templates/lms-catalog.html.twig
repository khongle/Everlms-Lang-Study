{# Course listing — matches 02-course-listing.png: left sidebar + course grid + sort + pagination #}
{{ attach_library('lms_theme/global') }}

    <div class="lms-catalog">
      {# Left sidebar — Search Filters #}
      <aside class="lms-catalog__sidebar">
        <h3 class="lms-catalog__sidebar-title">{{ 'SEARCH FILTERS'|t }}</h3>

        {# Title search #}
        <div class="lms-catalog__filter-group">
          <input type="text" class="form-control lms-input" placeholder="{{ 'Title'|t }}" id="course-search" value="{{ filters.search|default('') }}">
        </div>

        {# Category filter #}
        <div class="lms-catalog__filter-group">
          <h4>{{ 'CATEGORY'|t }}</h4>
          <select class="form-control lms-select" id="category-filter">
            <option value="">{{ 'All Categories'|t }}</option>
            {% for cat in categories %}
              <option value="{{ cat.id }}" {% if cat.id in filters.category %}selected{% endif %}>{{ cat.label }}</option>
            {% endfor %}
          </select>
          {% for cat in categories[:6] %}
            <label class="lms-catalog__checkbox">
              <input type="checkbox" value="{{ cat.id }}" data-filter-type="category" {% if cat.id in filters.category %}checked{% endif %}>
              <span>{{ cat.label }}</span>
            </label>
          {% endfor %}
        </div>

        {# Level filter #}
        <div class="lms-catalog__filter-group">
          <h4>{{ 'LEVEL'|t }}</h4>
          {% for level in ['Beginner', 'Intermediate', 'Advanced'] %}
            <label class="lms-catalog__checkbox">
              <input type="checkbox" value="{{ level|lower }}" data-filter-type="level" {% if level|lower in filters.level %}checked{% endif %}>
              <span>{{ level|t }}</span>
            </label>
          {% endfor %}
        </div>

        {# Price filter #}
        <div class="lms-catalog__filter-group">
          <h4>{{ 'PRICE'|t }}</h4>
          <label class="lms-catalog__checkbox">
            <input type="checkbox" value="free" data-filter-type="price" {% if 'free' in filters.price %}checked{% endif %}>
            <span>{{ 'Free'|t }}</span>
          </label>
          <label class="lms-catalog__checkbox">
            <input type="checkbox" value="paid" data-filter-type="price" {% if 'paid' in filters.price %}checked{% endif %}>
            <span>{{ 'Paid'|t }}</span>
          </label>
        </div>

        {# Rating filter #}
        <div class="lms-catalog__filter-group">
          <h4>{{ 'RATING'|t }}</h4>
          {% for r in [5, 4, 3, 2, 1] %}
            <label class="lms-catalog__checkbox">
              <input type="checkbox" value="{{ r }}" data-filter-type="rating" {% if r in filters.rating %}checked{% endif %}>
              <span class="lms-rating-stars">
                {% for i in 1..5 %}
                  <i class="fas fa-star {% if i <= r %}text-warning{% else %}text-muted{% endif %}"></i>
                {% endfor %}
                <span style="margin-left: 4px;">{{ r }} {{ 'Stars'|t }}</span>
              </span>
            </label>
          {% endfor %}
        </div>
      </aside>

      {# Main course grid #}
      <div class="lms-catalog__main">
        {# Sort by #}
        <div class="lms-catalog__toolbar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
          <span class="lms-catalog__count">{{ courses|length }} {{ 'courses found'|t }}</span>
          <div class="lms-catalog__sort" style="display: flex; align-items: center; gap: 0.5rem; white-space: nowrap;">
            <label style="margin: 0;">{{ 'Sort by:'|t }}</label>
            <select class="lms-select lms-select--sm" id="sort-courses" style="width: auto;">
              <option {% if filters.sort == 'Most Popular' %}selected{% endif %}>{{ 'Most Popular'|t }}</option>
              <option {% if filters.sort == 'Newest' %}selected{% endif %}>{{ 'Newest'|t }}</option>
              <option {% if filters.sort == 'Price Low-High' %}selected{% endif %}>{{ 'Price Low-High'|t }}</option>
            </select>
          </div>
        </div>

        {# Course grid #}
        {% if courses|length > 0 %}
          <div class="grid-courses">
            {% for card in courses %}
              {{ { '#theme': 'lms_course_card', '#card': card } }}
            {% endfor %}
          </div>

          {# Pagination #}
          {{ pager }}
        {% else %}
          <div class="lms-empty-state">
            <i class="fas fa-search"></i>
            <h3>{{ 'No courses found'|t }}</h3>
            <p>{{ 'Try adjusting your filters'|t }}</p>
          </div>
        {% endif %}
      </div>
    </div>
