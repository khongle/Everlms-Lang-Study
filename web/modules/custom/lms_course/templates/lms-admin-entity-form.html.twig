{{ attach_library('lms_theme/global') }}
<div class="lms-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: active_menu } %}
  <div class="lms-admin__main">
    <div class="lms-admin__header"><h1 class="lms-admin__title">{{ title }}</h1></div>
    <div class="lms-admin-card lms-admin-form-card">
      <div class="lms-admin-entity-form-wrapper" id="lms-admin-form-app">
        <div class="lms-form-content">{{ form }}</div>
      </div>
    </div>
  </div>
</div>
<style>
  #lms-admin-form-app .layout-node-form,
  #lms-admin-form-app .layout-region-node-main,
  #lms-admin-form-app .layout-region-user-main {
    width: 100%; max-width: none; float: none; margin: 0; padding: 0;
  }
  #lms-admin-form-app .lms-form-tabs {
    display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--workspace-border, #cbd5e1);
  }
  #lms-admin-form-app .lms-form-tab {
    border: 0; border-bottom: 3px solid transparent; padding: 0.75rem 0.25rem;
    background: transparent; color: var(--workspace-muted, #475569); font: inherit; font-weight: 600;
  }
  #lms-admin-form-app .lms-form-tab.active { color: #2563eb; border-bottom-color: #2563eb; }
  #lms-admin-form-app .lms-form-tab:focus-visible { outline: 2px solid #2563eb; outline-offset: 3px; }
  #lms-admin-form-app .lms-form-pane { display: none; }
  #lms-admin-form-app .lms-form-pane.active { display: block; }
  #lms-admin-form-app form.lms-form--tabbed > :not(.lms-form-tabs):not(.lms-form-panes):not(.form-actions) { display: none; }
  #lms-admin-form-app .lms-form-content .description { font: inherit; line-height: 1.6; color: var(--workspace-muted, #475569); }
</style>
<script>
(function () {
  function buildExplicitTabs() {
    const form = document.querySelector('#lms-admin-form-app .lms-form-content form');
    if (!form) return;
    if (form.querySelector('.lms-form-tabs')) {
      const error = form.querySelector('.form-item--error, .form-element--error, [aria-invalid="true"]');
      if (error && error.closest('.lms-form-pane') && form.lmsActivatePane) form.lmsActivatePane(error.closest('.lms-form-pane').id);
      return;
    }
               {% if active_menu == 'courses' or active_menu == 'quizzes' %}
               {% if active_menu == 'courses' %}
               // 1. Structured JFC Tabs with EXPLICIT Field Mapping
               const tabData = [
                  { 
                    id: 'tab-info', 
                    title: "{{ 'Info'|t|escape('js') }}",
                    targetNames: ['name', 'field_thumbnail', 'field_banner', 'field_short_description', 'field_description', 'field_what_learn', 'field_prerequisites', 'field_who_for'] 
                  },
                  { 
                    id: 'tab-collection', 
                    title: "{{ 'Course settings'|t|escape('js') }}",
                    targetNames: ['status', 'field_category', 'field_tags', 'field_level', 'field_language', 'field_instructor', 'field_price', 'field_price_type', 'field_bestseller', 'field_featured'] 
                  },
                  { 
                    id: 'tab-chapter', 
                    title: "{{ 'Chapters & lessons'|t|escape('js') }}",
                    targetNames: ['field_chapters', 'field_duration'] 
                  }
               ];
               {% elseif active_menu == 'quizzes' %}
               const tabData = [
                  { 
                    id: 'tab-info', 
                    title: "{{ 'Quiz Info'|t|escape('js') }}",
                    targetNames: ['name', 'field_body', 'field_threshold', 'field_time_limit', 'field_display_right_answer', 'field_form_style', 'field_question_count', 'field_take_quiz_number', 'field_prerequisite_quizzes', 'uid', 'created'] 
                  },
                  { 
                    id: 'tab-questions', 
                    title: "{{ 'Questions'|t|escape('js') }}",
                    targetNames: ['field_questions'] 
                  }
               ];
               {% endif %}
               

    const tabHeader = document.createElement('div');
    tabHeader.className = 'lms-form-tabs';
    tabHeader.setAttribute('role', 'tablist');
    const tabPanes = document.createElement('div');
    tabPanes.className = 'lms-form-panes';
    const formActions = form.querySelector(':scope > .form-actions') || form.querySelector('.form-actions');
    if (formActions) form.appendChild(formActions);
    function activate(paneId) {
      tabHeader.querySelectorAll('button').forEach(button => {
        const selected = button.getAttribute('aria-controls') === paneId;
        button.classList.toggle('active', selected);
        button.setAttribute('aria-selected', String(selected));
        button.tabIndex = selected ? 0 : -1;
      });
      tabPanes.querySelectorAll('.lms-form-pane').forEach(pane => pane.classList.toggle('active', pane.id === paneId));
      try { sessionStorage.setItem('lms-form-tab:' + window.location.pathname, paneId); } catch (error) {}
    }
    form.lmsActivatePane = activate;
    let invalidPane = null;
    form.addEventListener('invalid', event => {
      const pane = event.target.closest('.lms-form-pane');
      if (pane && !invalidPane) {
        invalidPane = pane;
        activate(pane.id);
        setTimeout(() => { invalidPane = null; }, 0);
      }
    }, true);
    tabHeader.addEventListener('keydown', event => {
      const buttons = Array.from(tabHeader.querySelectorAll('button'));
      const index = buttons.indexOf(document.activeElement);
      if (index === -1) return;
      let next;
      if (event.key === 'ArrowRight') next = (index + 1) % buttons.length;
      else if (event.key === 'ArrowLeft') next = (index - 1 + buttons.length) % buttons.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = buttons.length - 1;
      else return;
      event.preventDefault();
      activate(buttons[next].getAttribute('aria-controls'));
      buttons[next].focus();
    });
    tabData.forEach(tab => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'lms-form-tab';
      button.id = 'lms-' + tab.id;
      button.textContent = tab.title;
      button.setAttribute('role', 'tab');
      button.setAttribute('aria-controls', tab.id);
      const pane = document.createElement('div');
      pane.className = 'lms-form-pane';
      pane.id = tab.id;
      pane.setAttribute('role', 'tabpanel');
      pane.setAttribute('aria-labelledby', button.id);
      button.addEventListener('click', () => activate(tab.id));
      tabHeader.appendChild(button);
      tabPanes.appendChild(pane);
      tab.targetNames.forEach(fieldName => {
        let field = form.querySelector('.field--name-' + fieldName.replace(/_/g, '-'));
        if (!field) {
          const input = form.querySelector('[name^="' + fieldName + '"]');
          if (input) field = input.closest('.form-item, .form-wrapper, .js-form-item, .field-group-html-element');
        }
        if (field) pane.appendChild(field);
      });
    });
    // Keep every unmapped editable field available in the Info section.
    form.querySelectorAll('input:not([type="hidden"]), select, textarea').forEach(input => {
      const wrapper = input.closest('.form-item, .form-wrapper, .field--type-string, .field--type-entity-reference, .field--type-boolean');
      if (wrapper && !tabPanes.contains(wrapper) && (!formActions || !formActions.contains(wrapper))) {
        tabPanes.querySelector('#tab-info').appendChild(wrapper);
      }
    });
    form.insertBefore(tabPanes, form.firstChild);
    form.insertBefore(tabHeader, tabPanes);
    form.classList.add('lms-form--tabbed');
    const invalid = tabPanes.querySelector('.form-item--error, .form-element--error, [aria-invalid="true"]');
    let activePane = tabData[0].id;
    try { activePane = sessionStorage.getItem('lms-form-tab:' + window.location.pathname) || activePane; } catch (error) {}
    if (!tabData.some(tab => tab.id === activePane)) activePane = tabData[0].id;
    if (invalid && invalid.closest('.lms-form-pane')) activePane = invalid.closest('.lms-form-pane').id;
    activate(activePane);
    if (invalid) {
      const input = invalid.matches('input, select, textarea') ? invalid : invalid.querySelector('input:not([type="hidden"]), select, textarea');
      if (input) {
        input.focus({ preventScroll: true });
        input.scrollIntoView({ block: 'nearest' });
      }
    }
    {% endif %}
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', buildExplicitTabs);
  else buildExplicitTabs();
  if (typeof Drupal !== 'undefined') Drupal.behaviors.lmsAdminTabs = { attach: buildExplicitTabs };
})();
</script>
