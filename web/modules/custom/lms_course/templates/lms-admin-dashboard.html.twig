{{ attach_library('lms_theme/workspace') }}

<div class="lms-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: 'dashboard' } %}

  <div class="lms-admin__main lms-dashboard">
    <div class="lms-admin__header">
      <div>
        <h1 class="lms-admin__title">{{ 'Workspace'|t }}</h1>
        <p class="lms-admin__subtitle">{{ 'Overview of your LMS platform performance'|t }}</p>
      </div>
      <a class="btn-lms-primary" href="{{ path('lms_course.admin_reports') }}">
        <i class="fas fa-chart-line" aria-hidden="true"></i> {{ 'View reports'|t }}
      </a>
    </div>

    <div class="lms-kpi-grid">
      <div class="lms-kpi-card">
        <div class="lms-kpi-card__icon"><i class="fas fa-book" aria-hidden="true"></i></div>
        <div class="lms-kpi-card__content">
          <span class="lms-kpi-card__label">{{ 'Total Courses'|t }}</span>
          <span class="lms-kpi-card__value">{{ stats.courses|number_format }}</span>
        </div>
      </div>
      <div class="lms-kpi-card">
        <div class="lms-kpi-card__icon lms-kpi-card__icon--info"><i class="fas fa-users" aria-hidden="true"></i></div>
        <div class="lms-kpi-card__content">
          <span class="lms-kpi-card__label">{{ 'Active Learners'|t }}</span>
          <span class="lms-kpi-card__value">{{ stats.learners|number_format }}</span>
        </div>
      </div>
      <div class="lms-kpi-card">
        <div class="lms-kpi-card__icon lms-kpi-card__icon--success"><i class="fas fa-dollar-sign" aria-hidden="true"></i></div>
        <div class="lms-kpi-card__content">
          <span class="lms-kpi-card__label">{{ 'Revenue'|t }}</span>
          <span class="lms-kpi-card__value">${{ stats.revenue|number_format(2) }}</span>
        </div>
      </div>
      <div class="lms-kpi-card">
        <div class="lms-kpi-card__icon lms-kpi-card__icon--warning"><i class="fas fa-clipboard-check" aria-hidden="true"></i></div>
        <div class="lms-kpi-card__content">
          <span class="lms-kpi-card__label">{{ 'Quiz Completions'|t }}</span>
          <span class="lms-kpi-card__value">{{ stats.quiz_results|number_format }}</span>
        </div>
      </div>
    </div>

    <section class="lms-admin-card lms-dashboard-orders" aria-labelledby="recent-orders-title">
      <div class="lms-admin-card__header">
        <h2 id="recent-orders-title">{{ 'Recent Orders'|t }}</h2>
        <a href="{{ path('lms_course.admin_orders') }}" class="btn-lms-secondary">{{ 'View all orders'|t }} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
      </div>
      <div class="lms-table-responsive" tabindex="0" role="region" aria-label="{{ 'Recent orders table'|t }}">
        <table class="lms-table lms-dashboard-orders__table">
          <colgroup>
            <col class="lms-dashboard-orders__id">
            <col class="lms-dashboard-orders__learner">
            <col class="lms-dashboard-orders__amount">
            <col class="lms-dashboard-orders__date">
            <col class="lms-dashboard-orders__status">
          </colgroup>
          <thead>
            <tr>
              <th scope="col">{{ 'Order ID'|t }}</th>
              <th scope="col">{{ 'Learner'|t }}</th>
              <th scope="col" class="lms-table__numeric">{{ 'Amount'|t }}</th>
              <th scope="col">{{ 'Date'|t }}</th>
              <th scope="col">{{ 'Status'|t }}</th>
            </tr>
          </thead>
          <tbody>
            {% for order in recent_orders %}
              <tr>
                <td><a href="{{ path('lms_course.admin_order.edit', {'lms_order': order.id}) }}">#{{ order.id }}</a></td>
                <td class="lms-table__primary">{{ order.learner }}</td>
                <td class="lms-table__numeric">${{ order.total|number_format(2) }}</td>
                <td>{{ order.created|date('M d, Y') }}</td>
                <td><span class="lms-status lms-status--{{ order.status }}">{{ order.status|capitalize }}</span></td>
              </tr>
            {% else %}
              <tr><td colspan="5">{{ 'No orders yet'|t }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</div>
