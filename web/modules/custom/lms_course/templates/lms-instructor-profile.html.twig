{# Instructor Profile Page #}
<div class="lms-page-wrapper" style="background: #0d1117; min-height: 100vh; padding: 4rem 1.5rem; color: #c9d1d9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <div class="lms-container" style="max-width: 1200px; margin: 0 auto;">
    
    <div style="background: linear-gradient(145deg, #161b22 0%, #0d1117 100%); border: 1px solid hsla(0,0%,100%,0.1); border-radius: 1rem; padding: 3rem; margin-bottom: 3rem; display: flex; flex-direction: column; align-items: center; text-align: center; position: relative; overflow: hidden;">
      
      {# Background abstract shapes #}
      <div style="position: absolute; top: -50px; left: -50px; width: 200px; height: 200px; background: rgba(56, 189, 248, 0.1); filter: blur(60px); border-radius: 50%;"></div>
      <div style="position: absolute; bottom: -50px; right: -50px; width: 250px; height: 250px; background: rgba(168, 85, 247, 0.1); filter: blur(80px); border-radius: 50%;"></div>
      
      {% if instructor_avatar %}
        <div style="width: 160px; height: 160px; border-radius: 50%; overflow: hidden; border: 4px solid #1f2937; box-shadow: 0 10px 25px rgba(0,0,0,0.5); margin-bottom: 1.5rem; position: relative; z-index: 1;">
          <img src="{{ instructor_avatar }}" alt="{{ instructor_name }}" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
      {% else %}
        <div style="width: 160px; height: 160px; border-radius: 50%; background: #21262d; border: 4px solid #1f2937; box-shadow: 0 10px 25px rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; font-size: 4rem; color: #8b949e; margin-bottom: 1.5rem; position: relative; z-index: 1;">
          <i class="fas fa-user-tie"></i>
        </div>
      {% endif %}

      <h1 class="lms-section-title" style="font-size: 2.5rem; font-weight: 700; color: #fff; margin-bottom: 0.5rem; position: relative; z-index: 1;">{{ instructor_name }}</h1>
      
      {% if job_title %}
        <p style="font-size: 1.25rem; color: #38bdf8; margin-bottom: 1.5rem; position: relative; z-index: 1;">{{ job_title }}</p>
      {% endif %}

      <div style="display: inline-flex; gap: 2rem; background: rgba(0,0,0,0.3); padding: 1rem 2rem; border-radius: 3rem; border: 1px solid hsla(0,0%,100%,0.05); margin-bottom: 2rem; position: relative; z-index: 1; backdrop-filter: blur(10px);">
        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
          <strong style="color: #fff; font-size: 1.5rem; line-height: 1;">{{ stats.students|number_format }}</strong>
          <span style="font-size: 0.85rem; color: #8b949e; text-transform: uppercase; letter-spacing: 0.05em;">{{ 'Students'|t }}</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
          <strong style="color: #fff; font-size: 1.5rem; line-height: 1;">{{ stats.courses|number_format }}</strong>
          <span style="font-size: 0.85rem; color: #8b949e; text-transform: uppercase; letter-spacing: 0.05em;">{{ 'Courses'|t }}</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
          <strong style="color: #fff; font-size: 1.5rem; line-height: 1; display: flex; align-items: center; justify-content: center; gap: 4px;">
            {{ stats.rating|number_format(1) }} <i class="fas fa-star" style="color: #eab308; font-size: 1.25rem;"></i>
          </strong>
          <span style="font-size: 0.85rem; color: #8b949e; text-transform: uppercase; letter-spacing: 0.05em;">{{ 'Rating'|t }}</span>
        </div>
      </div>

      {% if bio %}
        <div style="max-width: 800px; margin: 0 auto; line-height: 1.7; font-size: 1.1rem; color: #9ca3af; position: relative; z-index: 1;">
          {{ bio|nl2br }}
        </div>
      {% endif %}

      {% if social_links %}
        <div style="display: flex; gap: 1rem; margin-top: 2rem; justify-content: center; position: relative; z-index: 1;">
          {% for platform, url in social_links %}
             {% set icon_class = 'fas fa-link' %}
             {% set bg_hover = '#0ea5e9' %}
             {% if platform == 'linkedin' %} {% set icon_class = 'fab fa-linkedin-in' %} {% set bg_hover = '#0a66c2' %} {% endif %}
             {% if platform == 'twitter' %} {% set icon_class = 'fab fa-twitter' %} {% set bg_hover = '#1da1f2' %} {% endif %}
             {% if platform == 'youtube' %} {% set icon_class = 'fab fa-youtube' %} {% set bg_hover = '#ff0000' %} {% endif %}
             {% if platform == 'website' %} {% set icon_class = 'fas fa-globe' %} {% set bg_hover = '#10b981' %} {% endif %}
             
             <a href="{{ url }}" target="_blank" rel="noopener noreferrer" style="width: 44px; height: 44px; border-radius: 50%; background: #1f2937; border: 1px solid hsla(0,0%,100%,0.1); display: flex; align-items: center; justify-content: center; color: #d1d5db; text-decoration: none; font-size: 1.25rem; transition: all 0.2s; box-shadow: 0 4px 6px rgba(0,0,0,0.1);" onmouseover="this.style.background='{{ bg_hover }}'; this.style.color='#fff'; this.style.transform='translateY(-2px)';" onmouseout="this.style.background='#1f2937'; this.style.color='#d1d5db'; this.style.transform='translateY(0)';">
               <i class="{{ icon_class }}"></i>
             </a>
          {% endfor %}
        </div>
      {% endif %}

    </div>

    <h2 style="font-size: 2rem; font-weight: 600; color: #fff; margin-bottom: 2rem; border-bottom: 1px solid #30363d; padding-bottom: 1rem;">
      {{ 'Courses by'|t }} {{ instructor_name }}
    </h2>

    {% if courses|length > 0 %}
      <div class="lms-catalog__grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
        {% for course in courses %}
          {% include '@lms_course/lms-course-card.html.twig' with {'card': course} %}
        {% endfor %}
      </div>
    {% else %}
      <div style="background: #161b22; border: 1px dashed #30363d; padding: 4rem 2rem; border-radius: 1rem; text-align: center;">
        <i class="fas fa-books" style="font-size: 3rem; color: #4b5563; margin-bottom: 1rem;"></i>
        <h3 style="color: #fff; font-size: 1.5rem; margin-bottom: 0.5rem;">{{ 'No courses published yet'|t }}</h3>
        <p style="color: #8b949e;">{{ instructor_name }} {{ 'is preparing something amazing. Check back later!'|t }}</p>
      </div>
    {% endif %}

  </div>
</div>
