{# Admin Course List — matches mockup #}
{{ attach_library('lms_theme/global') }}

<div class="lms-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: 'courses' } %}

  <div class="lms-admin__main">
    <form method="GET" action="{{ path('lms_course.admin_courses') }}" id="lms-course-filter-form">
      <div class="lms-admin__header">
        <div>
          <h1 class="lms-admin__title">{{ 'Course Management'|t }}</h1>
          <div class="lms-admin__subtitle">{{ 'Manage and overview all learning courses'|t }}</div>
        </div>
        <div style="display: flex; gap: 1rem; align-items: center;">
          <a href="{{ add_course_url }}" class="btn-lms-primary"><i class="fas fa-plus"></i> {{ 'Add New Course'|t }}</a>
        </div>
      </div>

      <div class="lms-admin-filter">
        <div class="lms-admin-filter__group">
          <label class="lms-admin-filter__label">{{ 'Search title'|t }}</label>
          <div style="position: relative;">
            <i class="fas fa-search" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: #64748b;"></i>
            <input type="text" name="search" value="{{ filters.search }}" class="lms-admin-filter__input" placeholder="{{ 'Search courses...'|t }}" style="padding-left: 2.5rem !important; width: 100%; box-sizing: border-box;">
          </div>
        </div>
        <div class="lms-admin-filter__group">
          <label class="lms-admin-filter__label">{{ 'Status'|t }}</label>
          <select name="status" class="lms-admin-filter__select">
            <option value="all" {% if filters.status == 'all' %}selected{% endif %}>{{ 'All'|t }}</option>
            <option value="published" {% if filters.status == 'published' %}selected{% endif %}>{{ 'Published'|t }}</option>
            <option value="draft" {% if filters.status == 'draft' %}selected{% endif %}>{{ 'Draft'|t }}</option>
            <option value="archived" {% if filters.status == 'archived' %}selected{% endif %}>{{ 'Archived'|t }}</option>
          </select>
        </div>
        <div class="lms-admin-filter__group">
          <label class="lms-admin-filter__label">{{ 'Category'|t }}</label>
          <select name="category" class="lms-admin-filter__select">
            <option value="all" {% if filters.category == 'all' %}selected{% endif %}>{{ 'All Categories'|t }}</option>
            {% for id, label in category_options %}
              <option value="{{ id }}" {% if filters.category == id %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="lms-admin-filter__group">
          <label class="lms-admin-filter__label">{{ 'Instructor'|t }}</label>
          <select name="instructor" class="lms-admin-filter__select">
            <option value="all" {% if filters.instructor == 'all' %}selected{% endif %}>{{ 'All Instructors'|t }}</option>
            {% for id, label in instructor_options %}
              <option value="{{ id }}" {% if filters.instructor == id %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </select>
        </div>
        <div style="display: flex; align-items: flex-end; padding-bottom: 2px;">
          <button type="button" id="lms-course-reset-btn" class="lms-admin-filter__select" style="cursor: pointer; color: #fff; background: rgba(255,255,255,0.05); min-width: max-content; padding-left: 1rem; padding-right: 1rem; width: auto; border: 1px solid rgba(255,255,255,0.1); border-radius: 0.375rem;">
            <i class="fas fa-sync-alt" style="margin-right: 0.5rem"></i> {{ 'Reset'|t }}
          </button>
        </div>
      </div>
    </form>

    <div id="lms-course-table-container">
      {% include '@lms_course/lms-admin-courses-table.html.twig' %}
    </div>

  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('lms-course-filter-form');
  const container = document.getElementById('lms-course-table-container');
  let timeout = null;

  function fetchCourses(overrideUrl = null) {
    container.style.opacity = '0.5';
    container.style.pointerEvents = 'none';

    let url;
    if (overrideUrl) {
      url = new URL(overrideUrl, window.location.origin);
    } else {
      url = new URL(form.action, window.location.origin);
      const formData = new FormData(form);
      for (const [key, value] of formData) {
        url.searchParams.append(key, value);
      }
    }
    
    // Update history
    history.pushState(null, '', url.toString());
    
    // Add ajax param
    url.searchParams.append('ajax', '1');

    fetch(url)
      .then(response => response.text())
      .then(html => {
        container.innerHTML = html;
        container.style.opacity = '1';
        container.style.pointerEvents = 'auto';
      })
      .catch(error => {
        console.error('Error fetching courses:', error);
        container.style.opacity = '1';
        container.style.pointerEvents = 'auto';
      });
  }

  form.addEventListener('input', function(e) {
    if (e.target.name === 'search') {
      clearTimeout(timeout);
      timeout = setTimeout(() => fetchCourses(), 400);
    }
  });

  form.addEventListener('change', function(e) {
    if (e.target.tagName.toLowerCase() === 'select') {
      fetchCourses();
    }
  });

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    fetchCourses();
  });

  // Handle Reset
  const resetBtn = document.getElementById('lms-course-reset-btn');
  if (resetBtn) {
    resetBtn.addEventListener('click', function() {
      form.reset();
      const searchInput = form.querySelector('input[name="search"]');
      if(searchInput) searchInput.value = '';
      
      const selects = form.querySelectorAll('select');
      selects.forEach(s => s.value = 'all');

      fetchCourses(form.action);
    });
  }

  // Handle Pagination
  container.addEventListener('click', function(e) {
    const pagerLink = e.target.closest('a');
    if (pagerLink && (pagerLink.closest('ul.pager__items') || pagerLink.closest('nav.pager') || pagerLink.closest('.pager'))) {
      e.preventDefault();
      fetchCourses(pagerLink.href);
    }
  });
});
</script>
