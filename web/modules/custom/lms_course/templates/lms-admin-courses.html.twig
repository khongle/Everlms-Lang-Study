{# Admin Course List — matches 12-admin-courses.png #}
{{ attach_library('lms_theme/global') }}

<div class="lms-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: 'courses' } only %}

  <div class="lms-admin__main">
    <div class="lms-admin__header">
      <h1 class="lms-admin__title">{{ 'Manage Courses'|t }}</h1>
      <a href="#" class="lms-btn lms-btn--primary"><i class="fas fa-plus"></i> {{ 'Create Course'|t }}</a>
    </div>

    <div class="lms-card">
      <div class="lms-table-responsive">
        <table class="lms-table">
          <thead>
            <tr>
              <th>{{ 'ID'|t }}</th>
              <th>{{ 'Course Name'|t }}</th>
              <th>{{ 'Category'|t }}</th>
              <th>{{ 'Price'|t }}</th>
              <th>{{ 'Status'|t }}</th>
              <th>{{ 'Created'|t }}</th>
              <th>{{ 'Actions'|t }}</th>
            </tr>
          </thead>
          <tbody>
            {% for course in courses %}
              <tr>
                <td>#{{ course.id }}</td>
                <td>{{ course.name }}</td>
                <td>{{ course.category }}</td>
                <td>${{ course.price|number_format(2) }}</td>
                <td>
                  <span class="lms-badge {{ course.status == 'Published' ? 'lms-badge--success' : 'lms-badge--secondary' }}">
                    {{ course.status }}
                  </span>
                </td>
                <td>{{ course.created|date('M d, Y') }}</td>
                <td>
                  <a href="{{ course.edit_url }}" class="lms-btn lms-btn--sm lms-btn--outline">{{ 'Edit'|t }}</a>
                </td>
              </tr>
            {% else %}
              <tr><td colspan="7" class="lms-text-center">{{ 'No courses'|t }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
