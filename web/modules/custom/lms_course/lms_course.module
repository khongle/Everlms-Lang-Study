/**
 * Implements hook_preprocess().
 * Injects generic variables like current_user_name to all admin templates.
 */
function lms_course_preprocess(&$variables, $hook) {
  if (strpos($hook, 'lms_admin_') === 0) {
    $uid = \Drupal::currentUser()->id();
    if ($uid) {
      $user = \Drupal\user\Entity\User::load($uid);
      $first_name = $user->hasField('field_first_name') ? $user->get('field_first_name')->value : '';
      $last_name = $user->hasField('field_last_name') ? $user->get('field_last_name')->value : '';
      $full_name = trim("$first_name $last_name");
      $variables['current_user_name'] = $full_name ?: $user->getDisplayName();
    } else {
      $variables['current_user_name'] = 'Guest';
    }

    // Inject site logo/name so admin sidebar can display the same logo as the frontend.
    if (function_exists('lms_theme_get_site_logo_url')) {
      $variables['site_logo_url'] = lms_theme_get_site_logo_url();
    }
    else {
      $logo_url = trim((string) theme_get_setting('logo.url', 'lms_theme'));
      $variables['site_logo_url'] = $logo_url;
    }
    $site_config = \Drupal::config('system.site');
    $site_name = trim((string) ($site_config->get('name') ?? ''));
    $variables['site_name'] = $site_name ?: 'EverLMS';
    $variables['site_logo_alt'] = trim((string) (theme_get_setting('site_logo_alt', 'lms_theme') ?: ($site_name ?: 'EverLMS')));
  }
}

/**
 * Implements hook_entity_type_alter().
 */
function lms_course_entity_type_alter(array &$entity_types) {
  if (isset($entity_types['lms_course'])) {
    $entity_types['lms_course']->setFormClass('admin_edit', 'Drupal\lms_course\Form\CourseForm');
  }
  if (isset($entity_types['lms_chapter'])) {
    $entity_types['lms_chapter']->setFormClass('admin_edit', 'Drupal\lms_chapter\Form\ChapterForm');
  }
  if (isset($entity_types['lms_lesson'])) {
    $entity_types['lms_lesson']->setFormClass('admin_edit', 'Drupal\lms_lesson\Form\LessonForm');
  }
  if (isset($entity_types['user'])) {
    $entity_types['user']->setFormClass('admin_create', 'Drupal\user\RegisterForm');
    $entity_types['user']->setFormClass('manager_create', 'Drupal\user\RegisterForm');
    $entity_types['user']->setFormClass('admin_edit', 'Drupal\user\ProfileForm');
    $entity_types['user']->setFormClass('manager_edit', 'Drupal\user\ProfileForm');
  }
}

/**
 * Implements hook_entity_access().
 */
function lms_course_entity_access(\Drupal\Core\Entity\EntityInterface $entity, $operation, \Drupal\Core\Session\AccountInterface $account) {
  if ($entity->getEntityTypeId() === 'user' && in_array($operation, ['view', 'update', 'delete'])) {
    if (in_array('manager', $account->getRoles())) {
      // Prevent managers from viewing/editing/deleting administrators to ensure security.
      if (in_array('administrator', $entity->getRoles())) {
        return \Drupal\Core\Access\AccessResult::forbidden('Managers cannot modify or view administrators.')->cachePerUser()->addCacheableDependency($entity);
      }
      return \Drupal\Core\Access\AccessResult::allowedIfHasPermission($account, 'administer lms_course')
        ->cachePerUser()
        ->addCacheableDependency($entity);
    }
  }

  // Check membership access for courses and lessons
  if ($operation === 'view' && in_array($entity->getEntityTypeId(), ['lms_course', 'lms_lesson'])) {
    // If it's a lesson, find its parent course to check price type.
    $course = NULL;
    if ($entity->getEntityTypeId() === 'lms_lesson') {
      if ($entity->hasField('field_chapter') && !$entity->get('field_chapter')->isEmpty()) {
        $chapter = $entity->get('field_chapter')->entity;
        if ($chapter && $chapter->hasField('field_course') && !$chapter->get('field_course')->isEmpty()) {
          $course = $chapter->get('field_course')->entity;
        }
      }
    } else {
      $course = $entity;
    }

    if ($course && $course->hasField('field_price_type')) {
      $price_type = $course->get('field_price_type')->value;
      if ($price_type === 'membership') {
        /** @var \Drupal\lms_membership\MembershipManager $membership_manager */
        $membership_manager = \Drupal::service('lms_membership.manager');
        if (!$membership_manager->hasActiveMembership($account)) {
          return \Drupal\Core\Access\AccessResult::forbidden('Active membership required to access this content.')
            ->cachePerUser()
            ->addCacheableDependency($course);
        }
      }
    }
  }

  return \Drupal\Core\Access\AccessResult::neutral();
}

/**
 * Implements hook_entity_create_access().
 */
function lms_course_entity_create_access(\Drupal\Core\Session\AccountInterface $account, array $context, $entity_bundle) {
  if ($context['entity_type_id'] === 'user') {
    if (in_array('manager', $account->getRoles())) {
      return \Drupal\Core\Access\AccessResult::allowedIfHasPermission($account, 'administer lms_course')->cachePerUser();
    }
  }
  return \Drupal\Core\Access\AccessResult::neutral();
}


