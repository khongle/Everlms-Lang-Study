/**
 * Implements hook_preprocess().
 * Injects generic variables like current_user_name to all admin templates.
 */
function lms_course_preprocess(&$variables, $hook) {
  if (in_array($hook, ['lms_workspace_shell', 'lms_flashcard_admin_decks', 'open_switcher_page'], TRUE) || strpos($hook, 'lms_admin_') === 0) {
    $entity_type_manager = \Drupal::entityTypeManager();
    $variables['workspace_switch_user_url'] = \Drupal::moduleHandler()->moduleExists('open_switcher')
      && \Drupal::currentUser()->hasPermission('switch users')
      ? \Drupal\Core\Url::fromRoute('open_switcher.frontend')->toString()
      : NULL;
    foreach (['lms_rating', 'lms_certificate', 'lms_membership'] as $module) {
      $variables[$module . '_enabled'] = \Drupal::moduleHandler()->moduleExists($module);
    }
    $variables['lms_content_tools_enabled'] = \Drupal::moduleHandler()->moduleExists('lms_content_tools')
      && \Drupal::currentUser()->hasPermission('administer lms content tools');
    $variables['lms_flashcard_enabled'] = \Drupal::moduleHandler()->moduleExists('lms_flashcard')
      && $entity_type_manager->hasDefinition('lms_flashcard_deck')
      && $entity_type_manager->hasDefinition('lms_flashcard_card');

    $uid = \Drupal::currentUser()->id();
    if ($uid) {
      $user = \Drupal\user\Entity\User::load($uid);
      $first_name = $user->hasField('field_first_name') ? $user->get('field_first_name')->value : '';
      $last_name = $user->hasField('field_last_name') ? $user->get('field_last_name')->value : '';
      $full_name = trim("$first_name $last_name");
      $variables['current_user_name'] = $full_name ?: $user->getDisplayName();

      // Friendly label for the user's highest-privilege role, so the admin
      // sidebar shows the real role (Instructor, Content Editor, …) instead of
      // a hard-coded "Manager".
      $role_labels = [
        'administrator' => t('Administrator'),
        'manager' => t('Manager'),
        'content_editor' => t('Content Editor'),
        'instructor' => t('Instructor'),
        'student' => t('Student'),
      ];
      $user_roles = $user->getRoles();
      $variables['current_user_role'] = t('Member');
      foreach ($role_labels as $rid => $label) {
        if (in_array($rid, $user_roles, TRUE)) {
          $variables['current_user_role'] = $label;
          break;
        }
      }
    } else {
      $variables['current_user_name'] = 'Guest';
      $variables['current_user_role'] = t('Guest');
    }

    // Inject site logo/name so admin sidebar can display the same logo as the frontend.
    if (function_exists('lms_theme_get_site_logo_url')) {
      $variables['site_logo_url'] = lms_theme_get_site_logo_url();
    }
    else {
      $logo_url = trim((string) theme_get_setting('logo.url', 'lms_theme'));
      $variables['site_logo_url'] = $logo_url;
    }
    $site_config = \Drupal::config('system.site');
    $site_name = trim((string) ($site_config->get('name') ?? ''));
    $variables['site_name'] = $site_name ?: 'EverLMS';
    $variables['site_logo_alt'] = trim((string) (theme_get_setting('site_logo_alt', 'lms_theme') ?: ($site_name ?: 'EverLMS')));
  }
}

/**
 * Implements hook_entity_type_alter().
 */
function lms_course_entity_type_alter(array &$entity_types) {
  if (isset($entity_types['lms_course'])) {
    $entity_types['lms_course']->setFormClass('admin_edit', 'Drupal\lms_course\Form\CourseForm');
  }
  if (isset($entity_types['lms_chapter'])) {
    $entity_types['lms_chapter']->setFormClass('admin_edit', 'Drupal\lms_chapter\Form\ChapterForm');
  }
  if (isset($entity_types['lms_lesson'])) {
    $entity_types['lms_lesson']->setFormClass('admin_edit', 'Drupal\lms_lesson\Form\LessonForm');
  }
  if (isset($entity_types['user'])) {
    $entity_types['user']->setFormClass('admin_create', 'Drupal\user\RegisterForm');
    $entity_types['user']->setFormClass('manager_create', 'Drupal\user\RegisterForm');
    $entity_types['user']->setFormClass('admin_edit', 'Drupal\user\ProfileForm');
    $entity_types['user']->setFormClass('manager_edit', 'Drupal\user\ProfileForm');
  }
}

/**
 * Implements hook_entity_access().
 */
function lms_course_entity_access(\Drupal\Core\Entity\EntityInterface $entity, $operation, \Drupal\Core\Session\AccountInterface $account) {
  if ($entity->getEntityTypeId() === 'user' && in_array($operation, ['view', 'update', 'delete'])) {
    if (in_array('manager', $account->getRoles())) {
      // Prevent managers from viewing/editing/deleting administrators to ensure security.
      if (in_array('administrator', $entity->getRoles())) {
        return \Drupal\Core\Access\AccessResult::forbidden('Managers cannot modify or view administrators.')->cachePerUser()->addCacheableDependency($entity);
      }
      return \Drupal\Core\Access\AccessResult::allowedIfHasPermission($account, 'administer lms_course')
        ->cachePerUser()
        ->addCacheableDependency($entity);
    }
  }

  // Check membership access for courses and lessons
  if ($operation === 'view' && in_array($entity->getEntityTypeId(), ['lms_course', 'lms_lesson'])) {
    // If it's a lesson, find its parent course to check price type.
    $course = NULL;
    if ($entity->getEntityTypeId() === 'lms_lesson') {
      if ($entity->hasField('field_chapter') && !$entity->get('field_chapter')->isEmpty()) {
        $chapter = $entity->get('field_chapter')->entity;
        if ($chapter && $chapter->hasField('field_course') && !$chapter->get('field_course')->isEmpty()) {
          $course = $chapter->get('field_course')->entity;
        }
      }
    } else {
      $course = $entity;
    }

    if ($course && $course->hasField('field_price_type')) {
      $price_type = $course->get('field_price_type')->value;
      if ($price_type === 'membership') {
        /** @var \Drupal\lms_membership\MembershipManager $membership_manager */
        $membership_manager = \Drupal::service('lms_membership.manager');
        if (!$membership_manager->hasActiveMembership($account)) {
          return \Drupal\Core\Access\AccessResult::forbidden('Active membership required to access this content.')
            ->cachePerUser()
            ->addCacheableDependency($course);
        }
      }
    }
  }

  return \Drupal\Core\Access\AccessResult::neutral();
}

/**
 * Implements hook_entity_create_access().
 */
function lms_course_entity_create_access(\Drupal\Core\Session\AccountInterface $account, array $context, $entity_bundle) {
  if ($context['entity_type_id'] === 'user') {
    if (in_array('manager', $account->getRoles())) {
      return \Drupal\Core\Access\AccessResult::allowedIfHasPermission($account, 'administer lms_course')->cachePerUser();
    }
  }
  return \Drupal\Core\Access\AccessResult::neutral();
}


/**
 * Implements hook_page_attachments().
 */
function lms_course_page_attachments(array &$attachments): void {
  $path = \Drupal::service('path.current')->getPath();
  if ($path === '/workspace' || str_starts_with($path, '/workspace/')) {
    // Workspace routes may use either Claro or the public site theme.
    $attachments['#attached']['library'][] = 'lms_theme/workspace';
    $attachments['#cache']['contexts'][] = 'user';
  }
}

/**
 * Implements hook_form_alter().
 */
function lms_course_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  $route = \Drupal::routeMatch()->getRouteName();
  $standalone_routes = [
    'lms_course.admin.chapter.edit' => ['courses', t('Edit Chapter'), '/workspace/courses'],
    'lms_course.admin.lesson.edit' => ['courses', t('Edit Lesson'), '/workspace/courses'],
    'lms_content_tools.clean' => ['content_tools', t('Clean Content'), '/workspace/content-tools'],
    'lms_content_tools.seed_input' => ['content_tools', t('Training Program Input'), '/workspace/content-tools'],
    'lms_certificate.revoke' => ['certificates', t('Revoke Certificate'), '/workspace/certificates'],
  ];
  $is_target_form = in_array($form_id, [
    'lms_content_tools_clean_form',
    'lms_content_tools_seed_input_form',
    'lms_certificate_revoke_form',
  ], TRUE);
  $form_object = $form_state->getFormObject();
  if ($form_object instanceof \Drupal\Core\Entity\EntityFormInterface) {
    $is_target_form = in_array($form_object->getEntity()->getEntityTypeId(), ['lms_chapter', 'lms_lesson'], TRUE)
      && $form_object->getOperation() === 'admin_edit';
  }
  // AJAX dialogs contain only the form, without a second navigation shell.
  $wrapper_format = \Drupal::request()->query->get('_wrapper_format', '');
  $is_dialog = in_array($wrapper_format, ['drupal_modal', 'drupal_dialog', 'drupal_ajax'], TRUE);
  if (isset($standalone_routes[$route]) && $is_target_form && !$is_dialog) {
    [$active, $title, $back_url] = $standalone_routes[$route];
    $form['#theme_wrappers'] = array_merge($form['#theme_wrappers'] ?? ['form'], ['lms_workspace_shell']);
    $form['#workspace_title'] = $title;
    $form['#workspace_active'] = $active;
    $form['#workspace_back_url'] = $back_url;
    $form['#workspace_is_form'] = TRUE;
    $form['#attached']['library'][] = 'lms_theme/workspace';
  }
}

/**
 * Prepares the shared shell for standalone workspace forms and tools.
 */
function lms_course_preprocess_lms_workspace_shell(array &$variables): void {
  $element = $variables['element'];
  $variables['title'] = $element['#workspace_title'] ?? '';
  $variables['subtitle'] = $element['#workspace_subtitle'] ?? '';
  $variables['active_menu'] = $element['#workspace_active'] ?? '';
  $variables['back_url'] = $element['#workspace_back_url'] ?? '';
  $variables['is_form'] = $element['#workspace_is_form'] ?? FALSE;
  $variables['content'] = $element['#children'];
}

/**
 * Implements hook_entity_form_display_alter().
 */
function lms_course_entity_form_display_alter(\Drupal\Core\Entity\Display\EntityFormDisplayInterface $form_display, array $context): void {
  \Drupal\lms_course\Form\CourseForm::prepareInlineFormDisplay($form_display, $context);
}
