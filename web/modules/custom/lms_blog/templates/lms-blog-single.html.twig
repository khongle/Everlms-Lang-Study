{#
/**
 * @file
 * Frontend template for a single Blog article.
 */
#}
<div class="article-container container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      
      <!-- Article Header -->
      <div class="mb-5 text-center">
        <div class="mb-3">
          <span class="badge bg-primary px-3 py-2 rounded-pill shadow-sm">News</span>
          <span class="text-muted ms-3"><i class="far fa-calendar-alt me-1"></i> {{ article.created.value|date('F j, Y') }}</span>
        </div>
        <h1 class="display-4 fw-bold mb-4">{{ article.title.value }}</h1>
        
        {% if article.seo_description.value %}
          <p class="lead text-muted">{{ article.seo_description.value }}</p>
        {% endif %}
      </div>

      <!-- Article Thumbnail -->
      {% if article.thumbnail.entity %}
        <div class="mb-5 text-center">
          <img src="{{ file_url(article.thumbnail.entity.uri.value) }}" class="img-fluid rounded-4 shadow" alt="{{ article.title.value }}" style="max-height: 500px; width: 100%; object-fit: cover;">
        </div>
      {% endif %}

      <!-- Article Content -->
      <div class="article-content fs-5" style="line-height: 1.8; position: relative;">
        {# The raw filter is used because the content is HTML generated by AI/CKEditor #}
        {% if is_teaser_mode %}
          <div style="overflow: hidden; max-height: 250px; position: relative;">
            {{ article.content.value|raw }}
            <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 120px; background: linear-gradient(to bottom, rgba(13, 17, 23, 0) 0%, rgba(13, 17, 23, 1) 100%); pointer-events: none;"></div>
          </div>
          <div class="lms-forum-teaser-cta" style="margin-top: 2rem; background: linear-gradient(145deg, rgba(88, 166, 255, 0.05) 0%, rgba(31, 111, 235, 0.1) 100%); border: 1px solid rgba(88, 166, 255, 0.2); border-radius: 12px; padding: 2.5rem 1.5rem; text-align: center; box-shadow: 0 8px 24px rgba(0,0,0,0.15);">
            <div style="font-size: 3rem; color: #58a6ff; margin-bottom: 1rem; opacity: 0.8;"><i class="fas fa-newspaper"></i></div>
            <h3 style="color: #e6edf3; font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">
              {{ 'Read the Full Article'|t }}
            </h3>
            <p style="color: #8b949e; margin-bottom: 1.5rem; font-size: 0.95rem;">
              {{ 'Create an account or log in to read this entire article and get access to all our latest news and insights.'|t }}
            </p>
            <div style="display: flex; gap: 1rem; justify-content: center;">
              <a href="{{ path('user.login') }}" class="button button--primary" style="background: #238636; border: 1px solid rgba(240, 246, 252, 0.1); border-radius: 6px; padding: 0.6rem 2rem; color: #fff; text-decoration: none; font-weight: 600; transition: background 0.2s;"><i class="fas fa-sign-in-alt me-2"></i> {{ 'Log In'|t }}</a>
              <a href="{{ path('user.register') }}" class="button" style="background: #21262d; border: 1px solid rgba(240, 246, 252, 0.1); border-radius: 6px; padding: 0.6rem 2rem; color: #c9d1d9; text-decoration: none; font-weight: 600; transition: background 0.2s;"><i class="fas fa-user-plus me-2"></i> {{ 'Register'|t }}</a>
            </div>
          </div>
        {% else %}
          {{ article.content.value|raw }}
        {% endif %}
      </div>
      
      <!-- Article Footer -->
      <div class="mt-5 pt-4 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <a href="{{ path('lms_blog.frontend.collection') }}" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fas fa-arrow-left me-2"></i> Back to News
          </a>
          <div class="social-share">
            <span class="text-muted me-3">Share:</span>
            <button class="btn btn-sm btn-light rounded-circle shadow-sm me-2"><i class="fab fa-facebook-f text-primary"></i></button>
            <button class="btn btn-sm btn-light rounded-circle shadow-sm me-2"><i class="fab fa-twitter text-info"></i></button>
            <button class="btn btn-sm btn-light rounded-circle shadow-sm"><i class="fab fa-linkedin-in text-primary"></i></button>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</div>
