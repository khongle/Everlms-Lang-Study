<?php

/**
 * @file
 * Primary module hooks for LMS Base module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\user\UserInterface;

/**
 * Implements hook_user_insert().
 */
function lms_base_user_insert(UserInterface $account) {
  // Automatically assign the 'student' role to newly registered users.
  // This executes right after the user entity is created (e.g., via registration or social auth).
  // We check if the user already has roles to avoid overwriting admin-created users.
  $roles = $account->getRoles();
  // 'authenticated' is the default role, so if they only have 'authenticated', they are a new standard user.
  if (count($roles) === 1 && in_array('authenticated', $roles)) {
    // We add the student role.
    $account->addRole('student');
    $account->save();
  }
}

/**
 * Implements hook_form_alter().
 */
function lms_base_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Modify User Login Form.
  if ($form_id === 'user_login_form') {
    // Change 'Username' to 'Email or Username' for better UX.
    if (isset($form['name'])) {
      $form['name']['#title'] = t('Email address');
      $form['name']['#attributes']['placeholder'] = t('Enter your email or username');
    }
    if (isset($form['pass'])) {
      $form['pass']['#attributes']['placeholder'] = t('Enter your password');
    }
    
    // Add custom validation to allow logging in with email address.
    // It must run before the core user validation.
    array_unshift($form['#validate'], 'lms_base_user_login_validate');
  }

  // Modify User Register Form.
  if ($form_id === 'user_register_form') {
    if (isset($form['account']['mail'])) {
      $form['account']['mail']['#attributes']['placeholder'] = t('email@example.com');
      $form['account']['mail']['#description'] = ''; // Hide generic description
    }
    if (isset($form['account']['name'])) {
      $form['account']['name']['#attributes']['placeholder'] = t('Choose a username');
      $form['account']['name']['#description'] = ''; // Hide generic description
    }
    
    // Hide extra profile fields for anonymous users during registration to keep it clean.
    if (\Drupal::currentUser()->isAnonymous()) {
      foreach (\Drupal\Core\Render\Element::children($form) as $key) {
        if (strpos($key, 'field_') === 0 || $key === 'user_picture' || $key === 'contact' || $key === 'timezone') {
          $form[$key]['#access'] = FALSE;
        }
      }
    }
  }
  
  // Modify User Password form.
  if ($form_id === 'user_pass') {
    if (isset($form['name'])) {
      $form['name']['#attributes']['placeholder'] = t('Enter your registered email');
    }
  }
}

/**
 * Implements hook_entity_presave().
 */
function lms_base_entity_presave(Drupal\Core\Entity\EntityInterface $entity) {
  // Auto-generate username from email if email_registration module is not used
  // and we want to enforce email-based usernames.
  // But to avoid breaking existing functions, we will not aggressively override this 
  // unless explicitly requested. We rely on standard Drupal logic here.
}

/**
 * Custom validation handler to allow login via email.
 */
function lms_base_user_login_validate(&$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $name = $form_state->getValue('name');
  if (!empty($name) && \Drupal::service('email.validator')->isValid($name)) {
    $user = user_load_by_mail($name);
    if ($user) {
      $form_state->setValue('name', $user->getAccountName());
    }
  }
}
