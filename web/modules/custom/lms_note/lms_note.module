<?php

/**
 * @file
 * Primary module hooks for lms_note module.
 */

/**
 * Implements hook_theme().
 */
function lms_note_theme($existing, $type, $theme, $path) {
  return [
    'lms_my_notes' => [
      'variables' => [
        'grouped_notes' => [],
        'listening_notes' => [],
        'reading_notes' => [],
      ],
      'template' => 'lms-my-notes',
    ],
  ];
}
