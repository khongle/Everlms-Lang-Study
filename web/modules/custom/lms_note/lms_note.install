<?php

/**
 * @file
 * Install, update and uninstall functions for the lms_note module.
 */

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\StringTranslation\TranslatableMarkup;

/**
 * Add field_course to lms_note entity.
 */
function lms_note_update_10001() {
  $field_storage_definition = BaseFieldDefinition::create('entity_reference')
    ->setLabel(new TranslatableMarkup('Course'))
    ->setRequired(TRUE)
    ->setSetting('target_type', 'lms_course');

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('field_course', 'lms_note', 'lms_note', $field_storage_definition);

  return 'Added field_course to lms_note entity.';
}

/**
 * Add field_attachments to lms_note entity.
 */
function lms_note_update_10002() {
  $field_storage_definition = BaseFieldDefinition::create('file')
    ->setLabel(new TranslatableMarkup('Attachments'))
    ->setCardinality(BaseFieldDefinition::CARDINALITY_UNLIMITED)
    ->setSetting('file_directory', 'notes/attachments/[current-user:uid]')
    ->setSetting('file_extensions', 'mp3 wav pdf jpg jpeg png gif')
    ->setSetting('max_filesize', '10 MB');

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('field_attachments', 'lms_note', 'lms_note', $field_storage_definition);

  return 'Added field_attachments to lms_note entity.';
}

/**
 * Add field_context_type/field_context_id to lms_note (generalizing it
 * beyond course lessons — see NOTE_EXPANSION_PLAN.md) and backfill every
 * pre-existing row to context_type = 'lesson'.
 *
 * installFieldStorageDefinition() only defines the columns — it does NOT
 * populate existing rows even with setDefaultValue() (confirmed the hard
 * way earlier in this project: see lms_flashcard_update_10014(), which had
 * to fix 213 rows left NULL by the same mistake). So the backfill here is
 * a direct, explicit UPDATE, not a field default.
 */
function lms_note_update_10003() {
  $type_definition = BaseFieldDefinition::create('string')
    ->setLabel(new TranslatableMarkup('Context type'))
    ->setSetting('max_length', 32);
  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('field_context_type', 'lms_note', 'lms_note', $type_definition);

  $id_definition = BaseFieldDefinition::create('integer')
    ->setLabel(new TranslatableMarkup('Context ID'))
    ->setSetting('unsigned', TRUE);
  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('field_context_id', 'lms_note', 'lms_note', $id_definition);

  $database = \Drupal::database();
  $updated = $database->update('lms_note')
    ->fields(['field_context_type' => 'lesson'])
    ->expression('field_context_id', 'field_lesson')
    ->isNotNull('field_lesson')
    ->isNull('field_context_type')
    ->execute();

  \Drupal::entityTypeManager()->getStorage('lms_note')->resetCache();

  return "Added field_context_type/field_context_id to lms_note; backfilled $updated existing row(s) to context_type='lesson'.";
}
