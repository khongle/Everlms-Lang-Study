<div class="w-100" style="width: 100%; display: flex; flex-direction: column;">
  <div class="zoom-embedded-container bg-dark rounded-3 overflow-hidden mb-3 shadow-sm" style="width: 100%; padding-top: 56.25%; min-height: 500px; position: relative; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1);">
    <iframe src="/zoom/join/{{ meeting_id }}" 
            class="w-100 h-100" 
            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;"
            allow="camera; microphone; display-capture; fullscreen; speaker; autoplay" 
            allowfullscreen="true">
    </iframe>
  </div>
  <div class="text-muted mt-2 small text-center w-100" style="width: 100%; color: #8b949e; font-size: 0.8125rem;">
    <i class="fas fa-info-circle me-1" style="color: #58a6ff;"></i> <span class="fw-bold" style="color: #c9d1d9;">Tips:</span> You can click the Fullscreen icon inside the video player to expand the Zoom window.
  </div>
</div>
