{# Listen step: audio-first — the transcript/hints stay hidden until the
   student explicitly reveals them (see js/listening-passage.js), enforcing
   LISTENING_TRAINING_PLAN.txt section 1: "Do not show the text before the
   learner listens." (No "Show translation" step any more — removed at the
   student's request; field_translation may still hold imported data, it's
   simply never surfaced here.) #}
{{ attach_library('lms_theme/global') }}

<section class="lms-section lms-listening-passage">
  <div class="container">
    {% set format = passage.get('field_format').value %}
    <div class="lms-listening-passage__header">
      <a class="lms-listening-passage__back" href="{{ path('lms_listening.my_passages') }}"><i class="fas fa-arrow-left"></i> {{ 'All passages'|t }}</a>
      <h1 class="lms-listening-passage__title">{{ passage.label }}</h1>
      <p class="lms-listening-passage__meta">
        <span class="lms-listening-passage__format-badge">
          <i class="fas {{ format == 'dialogue' ? 'fa-comments' : (format == 'narrative' ? 'fa-align-left' : 'fa-comment-dots') }}"></i>
          {{ format|capitalize }}
        </span>
        &middot; {{ 'Level: @level'|t({'@level': passage.get('field_level').value|capitalize}) }}
        {% if times_seen_label %}
          &middot; <span class="lms-listening-passage__seen-count">{{ times_seen_label }}</span>
        {% endif %}
      </p>
      {# Shown only when drupalSettings.lmsListening.canQuickEdit is true
         (js/listening-passage.js) — owner or staff, same rule the save
         endpoint re-checks server-side. #}
      <button type="button" class="lms-listening-passage__quick-edit-btn" data-listening-quick-edit hidden>
        <i class="fas fa-pen" aria-hidden="true"></i> {{ 'Quick edit'|t }}
      </button>
    </div>

    {# Narration audio Quick Edit drawer — mp3/mp4/etc. upload that
       js/listening-passage.js plays instead of the browser's TTS voice for
       the whole passage when present (clicking an individual sentence/turn
       to hear it on its own still always uses TTS). See
       ListeningApiController::quickEditFormData()/quickEditSave() — same
       drawer markup/behavior as Passive mode's own copy
       (lms-listening-passive-view.html.twig), kept independent per this
       module's "no cross-mode JS dependency" convention. #}
    <div class="lms-listening-edit-overlay" data-listening-edit-overlay hidden></div>
    <aside class="lms-listening-edit-drawer" data-listening-edit-drawer hidden aria-hidden="true" role="dialog" aria-label="{{ 'Quick edit'|t }}">
      <div class="lms-listening-edit-drawer__header">
        <h3 class="lms-listening-edit-drawer__title">{{ 'Quick edit — narration audio'|t }}</h3>
        <button type="button" class="lms-listening-edit-drawer__close" data-listening-edit-close aria-label="{{ 'Close'|t }}">
          <i class="fas fa-times" aria-hidden="true"></i>
        </button>
      </div>
      <div class="lms-listening-edit-drawer__body">
        <p class="lms-listening-edit-drawer__status" data-listening-edit-status hidden></p>
        <p class="lms-listening-edit-drawer__hint">{{ 'Whole-passage recording: plays instead of the browser voice for the whole passage. Per-sentence recordings (below) take priority over it when present — each sentence/turn with its own clip plays that clip in order; any one without one falls back to the browser voice just for itself. Clicking a single sentence/turn on its own always uses its own clip if it has one, otherwise the browser voice.'|t }}</p>

        <div class="lms-listening-edit-drawer__field-group">
          <span class="lms-listening-edit-drawer__label">{{ 'Whole-passage audio'|t }}</span>
          <div class="lms-listening-edit-drawer__file-row" data-listening-edit-audio-current hidden>
            <audio controls data-listening-edit-audio-preview></audio>
            <button type="button" class="lms-listening-edit-drawer__remove-btn" data-listening-edit-audio-remove>{{ 'Remove'|t }}</button>
          </div>
          <input type="file" accept="audio/mpeg,audio/mp4,video/mp4,audio/wav,audio/ogg,.mp3,.mp4,.m4a,.wav,.ogg" data-listening-edit-audio-input>
        </div>

        <div class="lms-listening-edit-drawer__field-group">
          <span class="lms-listening-edit-drawer__label">{{ 'Per-sentence audio (select in transcript order)'|t }}</span>
          <ul class="lms-listening-edit-drawer__sentence-audio-list" data-listening-edit-sentence-audio-current hidden></ul>
          <button type="button" class="lms-listening-edit-drawer__remove-btn" data-listening-edit-sentence-audio-remove hidden>{{ 'Remove all'|t }}</button>
          <input type="file" multiple accept="audio/mpeg,audio/mp4,video/mp4,audio/wav,audio/ogg,.mp3,.mp4,.m4a,.wav,.ogg" data-listening-edit-sentence-audio-input>
          <span class="lms-listening-edit-drawer__file-hint">{{ 'Selecting new files here replaces the whole set — there\'s no editing one clip at a time yet.'|t }}</span>
        </div>
      </div>
      <div class="lms-listening-edit-drawer__footer">
        <button type="button" class="lms-listening-edit-drawer__cancel" data-listening-edit-cancel>{{ 'Cancel'|t }}</button>
        <button type="button" class="lms-listening-edit-drawer__save" data-listening-edit-save>{{ 'Save'|t }}</button>
      </div>
    </aside>

    {# Play/Pause toolbar — same TTS mechanism as lms_reading's "Listen to
       passage" (js/listening-passage.js is an independent copy, including
       the voice/speed-change mid-playback fix). Hidden by JS on browsers
       without speechSynthesis support instead of being left broken. #}
    <div class="lms-listening-passage__listen" data-listening-listen-bar hidden>
      <button type="button" class="lms-listening-passage__listen-btn" data-listening-listen-toggle>
        <i class="fas fa-play" data-listening-listen-icon></i>
        <span data-listening-listen-label>{{ 'Listen'|t }}</span>
      </button>
      <div class="lms-listening-passage__listen-options">
        <label class="lms-listening-passage__listen-voice" data-listening-listen-voice-wrapper hidden>
          {{ 'Voice'|t }}
          <select data-listening-listen-voice></select>
        </label>
        <label class="lms-listening-passage__listen-speed">
          {{ 'Speed'|t }}
          <select data-listening-listen-speed>
            <option value="0.75">0.75&times;</option>
            <option value="1" selected>1&times;</option>
            <option value="1.25">1.25&times;</option>
          </select>
        </label>
      </div>
      <span class="lms-listening-passage__replay-count" data-listening-replay-count hidden></span>
    </div>

    {# Progressive reveal: disabled until the student has pressed Play at
       least once — see js/listening-passage.js — so a hint/transcript
       can't be grabbed without listening at all first. #}
    <div class="lms-listening-passage__reveal" data-listening-reveal-bar>
      {% if hints is not empty %}
        <button type="button" class="lms-listening-passage__reveal-btn" data-listening-hint-btn disabled>
          <i class="fas fa-lightbulb"></i> {{ 'Show hint'|t }}
        </button>
      {% endif %}
      <button type="button" class="lms-listening-passage__reveal-btn" data-listening-transcript-btn disabled>
        <i class="fas fa-align-left"></i> {{ 'Show transcript'|t }}
      </button>
      {% if not passage.get('field_translation').isEmpty() %}
        <button type="button" class="lms-listening-passage__reveal-btn" data-listening-translation-btn disabled>
          <i class="fas fa-language"></i> {{ 'Show translation'|t }}
        </button>
      {% endif %}
      {# Copies unitEls' plain text (no "Speaker: " prefix, one
         sentence/turn per line) to the clipboard — handy for pasting into
         a third-party TTS tool and uploading the results back into the
         Quick Edit drawer's per-sentence audio field in the same order.
         Shown only to whoever can Quick Edit this passage (same gate as
         data-listening-quick-edit) — content-creation aid, not a
         student-facing control. See its click handler in
         js/listening-passage.js. #}
      <button type="button" class="lms-listening-passage__reveal-btn" data-listening-copy-transcript hidden>
        <i class="fas fa-copy"></i> <span data-listening-copy-label>{{ 'Copy transcript (no names)'|t }}</span>
      </button>
    </div>

    <ul class="lms-listening-passage__hints" data-listening-hint-list hidden></ul>

    {# Common wrapper for both formats, hidden until "Show transcript" is
       pressed — js/listening-passage.js still builds the sentence/turn
       units and attaches TTS to them immediately (needed to speak them),
       it just keeps this whole block hidden until revealed. #}
    <div class="lms-listening-passage__content" data-listening-content hidden>
      {% if passage.get('field_body').value %}
        {# Rendered as plain, auto-escaped text (not |raw) — field_body is
           author-supplied via JSON import, so it must never be trusted as
           HTML. JS rebuilds the sentence-tokenized version from this
           element's textContent using safe DOM text nodes, never
           innerHTML. For a Dialogue passage this is just the optional
           scene-setting intro, not the conversation itself. #}
        <div class="lms-listening-passage__body" data-listening-body>{{ passage.get('field_body').value }}</div>
      {% endif %}

      {% if format == 'dialogue' and dialogue_turns is not empty %}
        <div class="lms-listening-passage__dialogue" data-listening-dialogue>
          {% for turn in dialogue_turns %}
            <div class="lms-listening-passage__turn lms-listening-passage__turn--{{ loop.index0 is even ? 'a' : 'b' }}" data-speaker="{{ turn.speaker }}">
              <div class="lms-listening-passage__turn-speaker">{{ turn.speaker }}</div>
              <div class="lms-listening-passage__turn-line" data-listening-line>{{ turn.line }}</div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if not passage.get('field_translation').isEmpty() %}
      {# Rendered as plain, auto-escaped text (not |raw) — same reasoning
         as field_body above, since field_translation is likewise
         author-supplied via JSON import. Independent of the transcript
         reveal (a student can show one without the other) — hidden until
         "Show translation" is pressed, see js/listening-passage.js. #}
      <div class="lms-listening-passage__translation" data-listening-translation hidden>
        {{ passage.get('field_translation').value }}
      </div>
    {% endif %}

    {# Shared "My Note" widget (lms_note module) — see
       NOTE_EXPANSION_PLAN.md. Text-only, one note per passage per student,
       explicit Save/Delete (no autosave). #}
    <div class="lms-note-widget" data-lms-note-widget data-note-context-type="listening_passage" data-note-context-id="{{ passage.id() }}">
      <div class="lms-note-widget__head">
        <h3 class="lms-note-widget__title"><i class="fas fa-note-sticky"></i> {{ 'My Note'|t }}</h3>
        <span class="lms-note-widget__status" data-note-status></span>
      </div>
      <div class="lms-note-widget__toolbar" data-note-toolbar>
        <button type="button" class="lms-note-widget__tool" data-note-cmd="bold" title="{{ 'Bold'|t }}"><i class="fas fa-bold"></i></button>
        <button type="button" class="lms-note-widget__tool" data-note-cmd="italic" title="{{ 'Italic'|t }}"><i class="fas fa-italic"></i></button>
        <button type="button" class="lms-note-widget__tool" data-note-cmd="underline" title="{{ 'Underline'|t }}"><i class="fas fa-underline"></i></button>
        <span class="lms-note-widget__tool-sep"></span>
        <button type="button" class="lms-note-widget__tool" data-note-cmd="insertUnorderedList" title="{{ 'Bullet list'|t }}"><i class="fas fa-list-ul"></i></button>
        <button type="button" class="lms-note-widget__tool" data-note-cmd="insertOrderedList" title="{{ 'Numbered list'|t }}"><i class="fas fa-list-ol"></i></button>
      </div>
      <div class="lms-note-widget__textarea" data-note-textarea contenteditable="false" data-empty-text="{{ 'Loading…'|t }}"></div>
      <div class="lms-note-widget__actions">
        <button type="button" class="lms-note-widget__save" data-note-save disabled>{{ 'Save'|t }}</button>
        <button type="button" class="lms-note-widget__delete" data-note-delete hidden>{{ 'Delete'|t }}</button>
      </div>
    </div>

    <div class="lms-listening-passage__footer">
      <a class="lms-listening-passage__continue" data-listening-continue href="#">{{ 'Continue to questions'|t }} <i class="fas fa-arrow-right"></i></a>
    </div>
  </div>
</section>
