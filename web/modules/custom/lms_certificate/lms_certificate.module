<?php

/**
 * @file
 * Primary module hooks for LMS Certificate module.
 */

/**
 * Implements hook_theme().
 */
function lms_certificate_theme($existing, $type, $theme, $path) {
  return [
    'certificate_pdf' => [
      'variables' => [
        'template' => NULL,
        'user' => NULL,
        'course' => NULL,
        'code' => NULL,
        'date' => NULL,
      ],
      'template' => 'certificate-pdf',
    ],
    'certificate_verification_result' => [
      'variables' => [
        'certificate' => NULL,
        'user' => NULL,
        'course' => NULL,
        'is_revoked' => FALSE,
      ],
      'template' => 'certificate-verification-result',
    ],
    'lms_admin_certificates' => [
      'variables' => [
        'stats' => [],
        'certificates' => [],
        'filters' => [],
        'pager' => [],
      ],
      'template' => 'lms-admin-certificates',
    ],
    'lms_admin_certificate_templates' => [
      'variables' => [
        'templates' => [],
        'filters' => [],
        'pager' => [],
        'add_template_url' => NULL,
      ],
      'template' => 'lms-admin-certificate-templates',
    ],
  ];
}

/**
 * Implements hook_entity_operation().
 */
function lms_certificate_entity_operation(\Drupal\Core\Entity\EntityInterface $entity) {
  $operations = [];
  if ($entity->getEntityTypeId() === 'lms_user_certificate' && \Drupal::currentUser()->hasPermission('revoke any certificate')) {
    $operations['revoke'] = [
      'title' => t('Revoke'),
      'weight' => 50,
      'url' => \Drupal\Core\Url::fromRoute('lms_certificate.revoke', ['lms_user_certificate' => $entity->id()]),
    ];
  }
  return $operations;
}

/**
 * Implements template_preprocess_HOOK() for certificate_pdf.
 */
function lms_certificate_preprocess_certificate_pdf(&$variables) {
  $template = $variables['template'];
  /** @var \Drupal\Core\File\FileSystemInterface $file_system */
  $file_system = \Drupal::service('file_system');
  
  $images = [
    'field_background' => 'field_background_path',
    'field_logo' => 'field_logo_path',
    'field_signature' => 'field_signature_path',
    'field_seal' => 'field_seal_path',
  ];
  
  foreach ($images as $field_name => $var_name) {
    $variables[$var_name] = '';
    if ($template && $template->hasField($field_name) && !$template->get($field_name)->isEmpty()) {
      $entity = $template->get($field_name)->entity;
      if ($entity) {
        $uri = $entity->getFileUri();
        $realpath = $file_system->realpath($uri);
        if ($realpath && file_exists($realpath)) {
          $variables[$var_name] = $realpath;
        }
      }
    }
  }
}
