{{ attach_library('lms_theme/global') }}
<div class="lms-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: 'certificate_templates' } %}
  <main class="lms-admin__main">
    <header class="lms-admin__header">
      <div>
        <h1 class="lms-admin__title">{{ 'Certificate Templates'|t }}</h1>
        <p class="lms-admin__subtitle">{{ 'Design and manage certificate templates for your courses.'|t }}</p>
      </div>
      <a href="{{ add_template_url }}" class="btn-lms-primary"><i class="fas fa-plus" aria-hidden="true"></i> {{ 'Add Template'|t }}</a>
    </header>

    <form method="get" action="{{ path('lms_certificate.admin_templates') }}" class="lms-admin-filter" aria-label="{{ 'Filter certificate templates'|t }}">
      <div class="lms-admin-filter__group lms-admin-filter__group--search">
        <label class="lms-admin-filter__label" for="template-search">{{ 'Template name'|t }}</label>
        <input id="template-search" type="search" name="search" value="{{ filters.search }}" class="lms-admin-filter__input" placeholder="{{ 'Search template name'|t }}">
      </div>
      <div class="lms-admin-filter__group">
        <label class="lms-admin-filter__label" for="template-status">{{ 'Status'|t }}</label>
        <select id="template-status" name="status" class="lms-admin-filter__select">
          <option value="all" {{ filters.status == 'all' ? 'selected' : '' }}>{{ 'All statuses'|t }}</option>
          <option value="active" {{ filters.status == 'active' ? 'selected' : '' }}>{{ 'Active'|t }}</option>
          <option value="disabled" {{ filters.status == 'disabled' ? 'selected' : '' }}>{{ 'Disabled'|t }}</option>
        </select>
      </div>
      <div class="lms-admin-filter__actions">
        <button type="submit" class="btn-lms-primary">{{ 'Apply filters'|t }}</button>
        <a href="{{ path('lms_certificate.admin_templates') }}" class="btn-lms-secondary">{{ 'Reset'|t }}</a>
      </div>
    </form>

    <section class="lms-admin-card">
      <div class="lms-table-responsive">
        <table class="lms-table">
          <thead><tr><th scope="col">{{ 'Template name'|t }}</th><th scope="col">{{ 'Template ID'|t }}</th><th scope="col">{{ 'Status'|t }}</th><th scope="col">{{ 'Actions'|t }}</th></tr></thead>
          <tbody>
            {% for template in templates %}
              <tr>
                <td><strong class="lms-table__primary">{{ template.name }}</strong></td><td>#{{ template.id }}</td>
                <td><span class="lms-status {{ template.status == 'Active' ? 'lms-status--published' : 'lms-status--inactive' }}">{{ template.status == 'Active' ? 'Active'|t : 'Disabled'|t }}</span></td>
                <td><div class="lms-admin-actions">
                  <a href="{{ template.preview_url }}" target="_blank" rel="noopener" class="btn-lms-secondary"><i class="fas fa-eye" aria-hidden="true"></i> {{ 'Preview'|t }}</a>
                  <a href="{{ template.edit_url }}" class="btn-lms-secondary"><i class="fas fa-edit" aria-hidden="true"></i> {{ 'Edit'|t }}</a>
                </div></td>
              </tr>
            {% else %}
              <tr><td colspan="4" class="lms-table__empty">{{ 'No certificate templates match these filters.'|t }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <footer class="lms-admin-footer"><span>{{ templates|length }} {{ 'templates on this page'|t }}</span>{{ pager }}</footer>
    </section>
  </main>
</div>
