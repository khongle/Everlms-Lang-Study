{# lms-admin-certificate-templates.html.twig #}
{{ attach_library('lms_theme/global') }}

<div class="lms-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: 'certificate_templates' } %}

  <div class="lms-admin__main">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
      <div>
        <h1 class="lms-admin__title" style="margin-bottom: 0;">{{ 'Certificate Templates'|t }}</h1>
        <p class="lms-admin__subtitle" style="margin-top: 0.5rem; margin-bottom: 0; color: #94a3b8;">
          {{ 'Design and manage certificate templates for your courses.'|t }}
        </p>
      </div>
      <div style="display: flex; gap: 1rem; align-items: center;">
        <a href="{{ add_template_url }}" class="lms-btn btn-lms-primary"><i class="fas fa-plus"></i> {{ 'Add New Template'|t }}</a>
      </div>
    </div>

    {# Data Table #}
    <div class="lms-admin-card" style="margin-top: 2rem;">
      <div class="lms-table-responsive">
        <table class="lms-table">
          <thead>
            <tr>
              <th>{{ 'Template Name'|t }}</th>
              <th>{{ 'Created'|t }}</th>
              <th>{{ 'Status'|t }}</th>
              <th style="text-align: right;">{{ 'Actions'|t }}</th>
            </tr>
          </thead>
          <tbody>
            {% for template in templates %}
              <tr>
                <td>
                  <div style="font-weight: 600; color: #fff; font-size: 1rem;">{{ template.name }}</div>
                </td>
                <td style="color: #94a3b8;">{{ template.created }}</td>
                <td>
                  {% if template.status == 'Active' %}
                    <span class="lms-status lms-status--published">{{ 'Active'|t }}</span>
                  {% else %}
                    <span class="lms-status lms-status--draft">{{ 'Disabled'|t }}</span>
                  {% endif %}
                </td>
                <td style="text-align: right; display: flex; gap: 0.5rem; justify-content: flex-end;">
                  <a href="{{ template.preview_url }}" target="_blank" title="Preview" style="display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 0.375rem; background: rgba(59,130,246,0.1); color: #3b82f6; transition: all 0.2s;" onmouseover="this.style.color='#60a5fa'; this.style.background='rgba(59,130,246,0.2)'" onmouseout="this.style.color='#3b82f6'; this.style.background='rgba(59,130,246,0.1)'">
                    <i class="fas fa-eye"></i>
                  </a>
                  <a href="{{ template.edit_url }}" title="Edit" style="display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 0.375rem; background: rgba(255,255,255,0.05); color: #94a3b8; transition: all 0.2s;" onmouseover="this.style.color='#fff'; this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.color='#94a3b8'; this.style.background='rgba(255,255,255,0.05)'">
                    <i class="fas fa-edit"></i>
                  </a>
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="4" style="text-align: center; padding: 4rem; color: #64748b;">
                  <i class="far fa-file-alt" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5; display: block;"></i>
                  <div style="font-size: 1.125rem; font-weight: 500; color: #94a3b8; margin-bottom: 0.5rem;">{{ 'No templates found.'|t }}</div>
                  <div>{{ 'Get started by creating your first certificate template.'|t }}</div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="lms-admin-footer">
        <div style="color: #64748b;">{{ 'Showing'|t }} {{ templates|length }} {{ 'entries'|t }}</div>
      </div>
    </div>
  </div>
</div>
