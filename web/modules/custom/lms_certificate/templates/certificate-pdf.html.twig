{#
/**
 * @file
 * Default theme implementation for the certificate PDF layout.
 *
 * Available variables:
 * - template: The CertificateTemplate entity.
 * - user: The User entity receiving the certificate.
 * - course: The Course entity.
 * - code: The unique certificate number.
 * - date: The issue date string.
 */
#}

{# Sử dụng đường dẫn vật lý thực tế (Absolute Physical Path) từ preprocess #}
{% set placeholders = {
  '[student_name]': user.getDisplayName(),
  '[course_name]': course.label(),
  '[issue_date]': date,
  '[certificate_code]': code,
  '[logo]': field_logo_path,
  '[seal]': field_seal_path,
  '[signature]': field_signature_path,
  '[background]': field_background_path
} %}

{# Output toàn bộ nội dung Admin tự thiết kế từ field_layout #}
<style>
    @page {
        {% if field_background_path %}
        background-image: url('{{ field_background_path }}');
        background-image-resize: 6;
        {% endif %}
        margin: 0;
    }
    body {
        margin: 0;
        padding: 0;
        /* Default generic styling to prevent any mPDF default collapse */
        font-family: 'Times New Roman', Georgia, serif;
    }
</style>
{{ template.field_layout.value|replace(placeholders)|raw }}
