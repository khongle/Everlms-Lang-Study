{{ attach_library('lms_theme/global') }}
<div class="lms-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: 'certificates' } %}
  <main class="lms-admin__main">
    <header class="lms-admin__header">
      <div>
        <h1 class="lms-admin__title">{{ 'Certificate Management'|t }}</h1>
        <p class="lms-admin__subtitle">{{ 'View issued certificates, check their status, and manage certificate PDFs.'|t }}</p>
      </div>
    </header>

    <section class="lms-kpi-grid lms-kpi-grid--three" aria-label="{{ 'Certificate statistics'|t }}">
      <article class="lms-kpi-card lms-admin-card">
        <span class="lms-kpi-card__icon"><i class="fas fa-certificate" aria-hidden="true"></i></span>
        <div><span class="lms-kpi-card__label">{{ 'Total issued'|t }}</span><strong class="lms-kpi-card__value">{{ stats.total_issued }}</strong></div>
      </article>
      <article class="lms-kpi-card lms-admin-card">
        <span class="lms-kpi-card__icon lms-kpi-card__icon--warning"><i class="fas fa-ban" aria-hidden="true"></i></span>
        <div><span class="lms-kpi-card__label">{{ 'Revoked'|t }}</span><strong class="lms-kpi-card__value">{{ stats.revoked }}</strong></div>
      </article>
      <article class="lms-kpi-card lms-admin-card">
        <span class="lms-kpi-card__icon lms-kpi-card__icon--success"><i class="fas fa-calendar-check" aria-hidden="true"></i></span>
        <div><span class="lms-kpi-card__label">{{ 'Issued this week'|t }}</span><strong class="lms-kpi-card__value">{{ stats.recent }}</strong></div>
      </article>
    </section>

    <form method="get" action="{{ path('lms_certificate.admin_dashboard') }}" class="lms-admin-filter" aria-label="{{ 'Filter certificates'|t }}">
      <div class="lms-admin-filter__group lms-admin-filter__group--search">
        <label class="lms-admin-filter__label" for="certificate-search">{{ 'Certificate code or recipient'|t }}</label>
        <input id="certificate-search" type="search" name="search" value="{{ filters.search }}" class="lms-admin-filter__input" placeholder="{{ 'Search code, name, or email'|t }}">
      </div>
      <div class="lms-admin-filter__group">
        <label class="lms-admin-filter__label" for="certificate-status">{{ 'Status'|t }}</label>
        <select id="certificate-status" name="status" class="lms-admin-filter__select">
          <option value="all" {{ filters.status == 'all' ? 'selected' : '' }}>{{ 'All statuses'|t }}</option>
          <option value="valid" {{ filters.status == 'valid' ? 'selected' : '' }}>{{ 'Valid'|t }}</option>
          <option value="revoked" {{ filters.status == 'revoked' ? 'selected' : '' }}>{{ 'Revoked'|t }}</option>
        </select>
      </div>
      <div class="lms-admin-filter__actions">
        <button type="submit" class="btn-lms-primary">{{ 'Apply filters'|t }}</button>
        <a href="{{ path('lms_certificate.admin_dashboard') }}" class="btn-lms-secondary">{{ 'Reset'|t }}</a>
      </div>
    </form>

    <section class="lms-admin-card">
      <div class="lms-table-responsive">
        <table class="lms-table">
          <thead><tr>
            <th scope="col">{{ 'Recipient'|t }}</th><th scope="col">{{ 'Course'|t }}</th>
            <th scope="col">{{ 'Issued date'|t }}</th><th scope="col">{{ 'Certificate code'|t }}</th>
            <th scope="col">{{ 'Status'|t }}</th><th scope="col">{{ 'Actions'|t }}</th>
          </tr></thead>
          <tbody>
            {% for cert in certificates %}
              <tr>
                <td><strong class="lms-table__primary">{{ cert.user_name }}</strong></td>
                <td>{{ cert.course_name }}</td><td>{{ cert.issue_date }}</td><td>{{ cert.code }}</td>
                <td><span class="lms-status {{ cert.status == 'Valid' ? 'lms-status--published' : 'lms-status--danger' }}">{{ cert.status == 'Valid' ? 'Valid'|t : 'Revoked'|t }}</span></td>
                <td>
                  <div class="lms-admin-actions">
                    {% if cert.pdf_available %}
                      <a href="{{ cert.pdf_url }}" target="_blank" rel="noopener" class="btn-lms-secondary"><i class="fas fa-file-pdf" aria-hidden="true"></i> {{ 'View PDF'|t }}</a>
                    {% else %}
                      <span class="lms-status lms-status--inactive">{{ 'PDF missing'|t }}</span>
                    {% endif %}
                    {% if cert.status == 'Valid' %}
                      <a href="{{ cert.regenerate_url }}" class="btn-lms-secondary" title="{{ 'Regenerate PDF to apply template changes'|t }}"><i class="fas fa-sync-alt" aria-hidden="true"></i> {{ 'Regenerate'|t }}</a>
                      <a href="{{ cert.revoke_url }}" class="btn-lms-secondary use-ajax" data-dialog-type="modal" data-dialog-options="{&quot;width&quot;:600}"><i class="fas fa-ban" aria-hidden="true"></i> {{ 'Revoke'|t }}</a>
                    {% endif %}
                  </div>
                </td>
              </tr>
            {% else %}
              <tr><td colspan="6" class="lms-table__empty">{{ 'No certificates match these filters.'|t }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <footer class="lms-admin-footer"><span>{{ certificates|length }} {{ 'certificates on this page'|t }}</span>{{ pager }}</footer>
    </section>
  </main>
</div>
