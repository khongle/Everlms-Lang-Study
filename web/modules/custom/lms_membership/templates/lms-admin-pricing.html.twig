{{ attach_library('lms_theme/global') }}
<div class="lms-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: 'pricing' } %}
  <main class="lms-admin__main">
    <header class="lms-admin__header">
      <div><h1 class="lms-admin__title">{{ 'Membership Pricing'|t }}</h1><p class="lms-admin__subtitle">{{ 'Manage plan prices, billing cycles, and availability.'|t }}</p></div>
      <a href="{{ add_url }}" class="btn-lms-primary"><i class="fas fa-plus" aria-hidden="true"></i> {{ 'Add Plan'|t }}</a>
    </header>

    <form method="get" action="{{ path('lms_membership.admin_pricing') }}" class="lms-admin-filter" aria-label="{{ 'Filter pricing plans'|t }}">
      <div class="lms-admin-filter__group lms-admin-filter__group--search">
        <label class="lms-admin-filter__label" for="pricing-search">{{ 'Plan name'|t }}</label>
        <input id="pricing-search" type="search" name="search" value="{{ filters.search }}" class="lms-admin-filter__input" placeholder="{{ 'Search plan name'|t }}">
      </div>
      <div class="lms-admin-filter__group">
        <label class="lms-admin-filter__label" for="pricing-billing">{{ 'Billing cycle'|t }}</label>
        <select id="pricing-billing" name="billing" class="lms-admin-filter__select">
          <option value="all" {{ filters.billing == 'all' ? 'selected' : '' }}>{{ 'All billing cycles'|t }}</option>
          <option value="monthly" {{ filters.billing == 'monthly' ? 'selected' : '' }}>{{ 'Monthly'|t }}</option>
          <option value="quarterly" {{ filters.billing == 'quarterly' ? 'selected' : '' }}>{{ 'Quarterly'|t }}</option>
          <option value="yearly" {{ filters.billing == 'yearly' ? 'selected' : '' }}>{{ 'Yearly'|t }}</option>
          <option value="lifetime" {{ filters.billing == 'lifetime' ? 'selected' : '' }}>{{ 'Lifetime'|t }}</option>
        </select>
      </div>
      <div class="lms-admin-filter__group">
        <label class="lms-admin-filter__label" for="pricing-status">{{ 'Status'|t }}</label>
        <select id="pricing-status" name="status" class="lms-admin-filter__select">
          <option value="all" {{ filters.status == 'all' ? 'selected' : '' }}>{{ 'All statuses'|t }}</option>
          <option value="active" {{ filters.status == 'active' ? 'selected' : '' }}>{{ 'Active'|t }}</option>
          <option value="inactive" {{ filters.status == 'inactive' ? 'selected' : '' }}>{{ 'Disabled'|t }}</option>
        </select>
      </div>
      <div class="lms-admin-filter__actions">
        <button type="submit" class="btn-lms-primary">{{ 'Apply filters'|t }}</button>
        <a href="{{ path('lms_membership.admin_pricing') }}" class="btn-lms-secondary">{{ 'Reset'|t }}</a>
      </div>
    </form>

    <section class="lms-admin-card">
      <div class="lms-table-responsive">
        <table class="lms-table">
          <thead><tr><th scope="col">{{ 'Plan name'|t }}</th><th scope="col">{{ 'Price'|t }}</th><th scope="col">{{ 'Billing cycle'|t }}</th><th scope="col">{{ 'Status'|t }}</th><th scope="col">{{ 'Actions'|t }}</th></tr></thead>
          <tbody>
            {% for plan in plans %}
              <tr>
                <td><strong class="lms-table__primary">{{ plan.name }}</strong></td><td>${{ plan.price|number_format(2) }}</td><td>{{ plan.billing|capitalize }}</td>
                <td><span class="lms-status {{ plan.status == 'Active' ? 'lms-status--published' : 'lms-status--inactive' }}">{{ plan.status == 'Active' ? 'Active'|t : 'Disabled'|t }}</span></td>
                <td><div class="lms-admin-actions">
                  <a href="{{ plan.edit_url }}" class="btn-lms-secondary"><i class="fas fa-edit" aria-hidden="true"></i> {{ 'Edit'|t }}</a>
                  <a href="{{ plan.toggle_url }}" class="btn-lms-secondary">{{ plan.status == 'Active' ? 'Deactivate'|t : 'Activate'|t }}</a>
                </div></td>
              </tr>
            {% else %}
              <tr><td colspan="5" class="lms-table__empty">{{ 'No pricing plans match these filters.'|t }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <footer class="lms-admin-footer"><span>{{ plans|length }} {{ 'plans on this page'|t }}</span>{{ pager }}</footer>
    </section>
  </main>
</div>
