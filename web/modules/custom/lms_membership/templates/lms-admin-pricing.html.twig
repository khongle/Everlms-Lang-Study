{# Admin Pricing #}
{{ attach_library('lms_theme/global') }}
<div class="lms-admin">
  {% include '@lms_course/lms-admin-sidebar.html.twig' with { active: 'pricing' } %}
  <div class="lms-admin__main">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
      <h1 class="lms-admin__title" style="margin-bottom: 0;">{{ 'Membership Pricing'|t }}</h1>
      <a href="{{ add_url }}" class="lms-btn btn-lms-primary">
        <i class="fas fa-plus" style="margin-right: 8px;"></i> {{ 'Add Plan'|t }}
      </a>
    </div>

    <!-- Filter Bar -->
    <form method="GET" action="{{ path('<current>') }}" class="lms-admin-filter">
      <div class="lms-admin-filter__group" style="flex: 2;">
        <label class="lms-admin-filter__label">{{ 'Search Plans'|t }}</label>
        <input type="text" name="search" value="{{ filters.search }}" class="lms-admin-filter__input" placeholder="{{ 'Enter Plan Name...'|t }}">
      </div>
      <div class="lms-admin-filter__group">
        <label class="lms-admin-filter__label">{{ 'Status'|t }}</label>
        <select name="status" class="lms-admin-filter__select">
          <option value="all" {% if filters.status == 'all' %}selected{% endif %}>{{ 'All Statuses'|t }}</option>
          <option value="active" {% if filters.status == 'active' %}selected{% endif %}>{{ 'Active'|t }}</option>
          <option value="inactive" {% if filters.status == 'inactive' %}selected{% endif %}>{{ 'Inactive'|t }}</option>
        </select>
      </div>
      <div class="lms-admin-filter__group" style="flex: 0 0 auto;">
        <button type="submit" class="lms-btn btn-lms-primary" style="height: 42px; display: inline-flex; align-items: center;">
          {{ 'Filter'|t }}
        </button>
      </div>
    </form>

    <div class="lms-admin-card">
      <div class="lms-table-responsive">
        <table class="lms-table">
          <thead>
            <tr>
              <th>{{ 'PLAN NAME'|t }}</th>
              <th>{{ 'PRICE'|t }}</th>
              <th>{{ 'BILLING CYCLE'|t }}</th>
              <th>{{ 'STATUS'|t }}</th>
              <th>{{ 'ACTIONS'|t }}</th>
            </tr>
          </thead>
          <tbody>
            {% for plan in plans %}
              <tr>
                <td style="font-weight: 500;">{{ plan.name }}</td>
                <td>${{ plan.price|number_format(2) }}</td>
                <td style="text-transform: capitalize;">{{ plan.billing }}</td>
                <td>
                  <span class="lms-badge {{ plan.status == 'Active' ? 'lms-badge--success' : 'lms-badge--danger' }}">
                    {{ plan.status }}
                  </span>
                </td>
                <td>
                  <a href="{{ plan.edit_url }}" class="lms-btn btn-lms-primary" style="padding: 6px 14px; font-size: 13px; margin-right: 4px;">{{ 'Edit'|t }}</a>
                  <a href="{{ plan.toggle_url }}" class="lms-btn" style="padding: 6px 14px; font-size: 13px; background: transparent; border: 1px solid {{ plan.status == 'Active' ? '#f59e0b' : '#10b981' }}; color: {{ plan.status == 'Active' ? '#f59e0b' : '#10b981' }}; border-radius: 0.5rem; display: inline-block;">
                    {{ plan.status == 'Active' ? 'Deactivate'|t : 'Activate'|t }}
                  </a>
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="5" class="lms-text-center" style="padding: 2rem; color: #94a3b8;">
                  {{ 'No pricing plans found.'|t }}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
